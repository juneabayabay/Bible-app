---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import VersionPicker from "../components/VersionPicker.astro";
import NavMenu from "../components/NavMenu.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { DEFAULT_VERSION, type VersionId } from "../lib/versions";

interface Props {
  title?: string;
  version?: VersionId;
  showFooter?: boolean;
  width?: "reading" | "wide";
  /** Allow full-bleed hero to reach the top edge under the header */
  flushHero?: boolean;
}

const {
  title = "Bible",
  version = DEFAULT_VERSION,
  showFooter = true,
  width = "reading",
  flushHero = false,
} = Astro.props;

const shell =
  width === "wide"
    ? "mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 xl:max-w-7xl"
    : "mx-auto w-full max-w-3xl px-4 sm:px-6";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="astro-prefetch" content="hover" />
    <meta
      name="description"
      content="Draw near to God every day. Read Scripture, highlight verses, and keep notes—peacefully, on this device."
    />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("bible-theme");
          const dark =
            saved === "dark" ||
            (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        } catch {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col antialiased transition-colors duration-200">
    <header class="sticky top-0 z-40 border-b border-[var(--color-line)]/70 bg-[var(--color-surface-elevated)]/90 backdrop-blur-md supports-[padding:max(0px)]:pt-[env(safe-area-inset-top)]">
      <div class:list={[shell, "flex items-center gap-2 py-2.5 sm:gap-3 sm:py-3"]}>
        <a
          href={`/${version}/`}
          class="shrink-0 text-base font-semibold tracking-tight text-[var(--color-ink)] transition hover:opacity-75 sm:text-lg"
          data-astro-prefetch
        >
          Bible
        </a>

        <div class="min-w-0 flex-1">
          <slot name="header" />
        </div>

        <div class="flex shrink-0 items-center gap-1 sm:gap-1.5">
          <NavMenu version={version} />
          <VersionPicker version={version} />
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main class:list={[shell, "flex-1", flushHero ? "pb-8 sm:pb-10 lg:pb-12" : "py-6 sm:py-8 lg:py-10"]}>
      <slot />
      {showFooter && <SiteFooter version={version} />}
    </main>
  </body>
</html>

<style is:global>
  [x-cloak] {
    display: none !important;
  }
</style>
