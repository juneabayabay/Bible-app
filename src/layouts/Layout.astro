---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title?: string;
}

const { title = "Bible" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("bible-theme");
          const dark =
            saved === "dark" ||
            (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        } catch {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased transition-colors duration-200">
    <header class="sticky top-0 z-40 border-b border-[var(--color-line)] bg-[var(--color-surface-elevated)]/95 backdrop-blur-sm">
      <div class="mx-auto flex max-w-3xl flex-col gap-3 px-4 py-3 sm:gap-4 sm:py-4">
        <div class="flex items-center justify-between gap-3">
          <nav class="flex min-w-0 items-center gap-3 sm:gap-4" aria-label="Main">
            <a
              href="/"
              class="truncate text-base font-semibold tracking-tight text-[var(--color-ink)] transition hover:opacity-70 sm:text-lg"
            >
              Bible
            </a>
            <a
              href="/saved"
              class="shrink-0 text-sm text-[var(--color-ink-muted)] transition hover:text-[var(--color-ink)] hover:underline"
            >
              Saved
            </a>
          </nav>
          <ThemeToggle />
        </div>

        <div class="w-full min-w-0">
          <slot name="header" />
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-3xl px-4 py-6 sm:py-8">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  [x-cloak] {
    display: none !important;
  }
</style>
