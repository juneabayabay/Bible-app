---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import VersionPicker from "../components/VersionPicker.astro";
import NavMenu from "../components/NavMenu.astro";
import SiteFooter from "../components/SiteFooter.astro";
import InstallAppBanner from "../components/InstallAppBanner.astro";
import { DEFAULT_VERSION, type VersionId } from "../lib/versions";
import { getOneSignalAppId } from "../lib/reminders";

interface Props {
  title?: string;
  version?: VersionId;
  showFooter?: boolean;
  width?: "reading" | "wide";
  /** Allow full-bleed hero to reach the top edge under the header */
  flushHero?: boolean;
}

const {
  title = "Bible",
  version = DEFAULT_VERSION,
  showFooter = true,
  width = "reading",
  flushHero = false,
} = Astro.props;

const shell =
  width === "wide"
    ? "mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 xl:max-w-7xl"
    : "mx-auto w-full max-w-3xl px-4 sm:px-6 lg:px-8";

const oneSignalAppId = getOneSignalAppId();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="astro-prefetch" content="hover" />
    <meta
      name="description"
      content="Draw near to God every day. Read Scripture, highlight verses, and keep notes—peacefully, on this device."
    />
    <title>{title}</title>
    <meta name="theme-color" content="#1e3a5f" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Bible" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("bible-theme");
          const dark =
            saved === "dark" ||
            (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        } catch {
          /* ignore */
        }
      })();
    </script>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            /* ignore registration failures (file://, private mode, etc.) */
          });
        });
      }
    </script>
    {
      oneSignalAppId && (
        <>
          <script
            is:inline
            src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js"
            defer></script>
          <script is:inline define:vars={{ oneSignalAppId }}>
            window.OneSignalDeferred = window.OneSignalDeferred || [];
            OneSignalDeferred.push(async function (OneSignal) {
              await OneSignal.init({
                appId: oneSignalAppId,
                notifyButton: { enable: false },
                promptOptions: { slidedown: { enabled: false } },
                allowLocalhostAsSecureOrigin: true,
              });
            });
          </script>
        </>
      )
    }
  </head>
  <body class="flex min-h-screen flex-col antialiased transition-colors duration-200">
    <header class="site-header sticky top-0 z-40 border-b border-[var(--color-line)] bg-[var(--color-surface-elevated)]/92 backdrop-blur-md supports-[padding:max(0px)]:pt-[env(safe-area-inset-top)]">
      <div class:list={[shell, "py-2 sm:py-2.5"]}>
        <div class="flex flex-wrap items-center gap-x-2 gap-y-2 sm:flex-nowrap sm:gap-x-3">
          <a
            href={`/${version}/`}
            data-home-link
            class="order-1 shrink-0 font-scripture text-lg font-semibold tracking-tight text-[var(--color-ink)] transition hover:text-[var(--color-primary)] sm:text-xl"
            data-astro-prefetch
          >
            Bible
          </a>

          <div class="order-3 w-full min-w-0 sm:order-2 sm:w-auto sm:flex-1 sm:max-w-xl md:max-w-2xl">
            <slot name="header" />
          </div>

          <div class="order-2 ml-auto flex shrink-0 items-center gap-0.5 sm:order-3 sm:ml-0">
            <VersionPicker version={version} />
            <ThemeToggle />
            <NavMenu version={version} />
          </div>
        </div>
      </div>
    </header>

    <main class:list={[shell, "flex-1", flushHero ? "pb-10 sm:pb-12 lg:pb-14" : "py-7 sm:py-9 lg:py-11"]}>
      <slot />
      {showFooter && <SiteFooter version={version} />}
    </main>
    <InstallAppBanner />
  </body>
</html>

<style is:global>
  [x-cloak] {
    display: none !important;
  }
</style>
