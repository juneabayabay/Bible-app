---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import VersionPicker from "../components/VersionPicker.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { DEFAULT_VERSION, type VersionId } from "../lib/versions";

interface Props {
  title?: string;
  version?: VersionId;
  showFooter?: boolean;
  /**
   * reading — comfortable line length for chapters (default)
   * wide — dashboard / book lists that need more horizontal room
   */
  width?: "reading" | "wide";
}

const {
  title = "Bible",
  version = DEFAULT_VERSION,
  showFooter = true,
  width = "reading",
} = Astro.props;

const shell =
  width === "wide"
    ? "mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8 xl:max-w-7xl"
    : "mx-auto w-full max-w-3xl px-4 sm:px-6";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="astro-prefetch" content="hover" />
    <meta name="description" content="Read Scripture. Highlight verses. Keep notes on this device." />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("bible-theme");
          const dark =
            saved === "dark" ||
            (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
        } catch {
          /* ignore */
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col antialiased transition-colors duration-200">
    <header class="sticky top-0 z-40 border-b border-[var(--color-line)] bg-[var(--color-surface-elevated)]/95 backdrop-blur-sm supports-[padding:max(0px)]:pt-[env(safe-area-inset-top)]">
      <div class:list={[shell, "flex flex-col gap-3 py-3 sm:gap-3.5 sm:py-4"]}>
        <div class="flex items-center justify-between gap-2">
          <nav class="flex min-w-0 items-center gap-3 sm:gap-5" aria-label="Main">
            <a
              href={`/${version}/`}
              class="truncate text-lg font-semibold tracking-tight text-[var(--color-ink)] transition hover:opacity-70"
            >
              Bible
            </a>
            <a
              href="/saved"
              class="shrink-0 text-sm text-[var(--color-ink-muted)] transition hover:text-[var(--color-ink)]"
            >
              Saved
            </a>
          </nav>
          <div class="flex shrink-0 items-center gap-2">
            <VersionPicker version={version} />
            <ThemeToggle />
          </div>
        </div>

        <div class="w-full min-w-0">
          <slot name="header" />
        </div>
      </div>
    </header>

    <main class:list={[shell, "flex-1 py-6 sm:py-8 lg:py-10"]}>
      <slot />
      {showFooter && <SiteFooter version={version} />}
    </main>
  </body>
</html>

<style is:global>
  [x-cloak] {
    display: none !important;
  }
</style>
