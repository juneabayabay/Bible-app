---
---

<div
  class="relative w-full max-w-md"
  x-data="bibleSearch"
  x-cloak
>
  <label class="sr-only" for="bible-search">Search verses</label>
  <input
    id="bible-search"
    type="search"
    placeholder="Search verses…"
    class="w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-sm outline-none ring-stone-400 focus:ring-2"
    x-model="q"
    @input.debounce.300ms="search"
  />

  <p class="mt-1 text-xs text-stone-500" x-show="loading">Loading search…</p>
  <p class="mt-1 text-xs text-red-600" x-show="error" x-text="error"></p>

  <ul
    class="absolute z-10 mt-1 max-h-80 w-full overflow-auto rounded-md border border-stone-200 bg-white shadow-md"
    x-show="results.length > 0"
    @click.outside="results = []"
  >
    <template x-for="result in results" :key="result.id">
      <li class="border-b border-stone-100 last:border-0">
        <a
          class="block px-3 py-2 hover:bg-stone-50"
          :href="result.url"
        >
          <span class="block text-sm font-medium" x-text="result.label"></span>
          <span class="block text-xs text-stone-600" x-text="result.snippet"></span>
        </a>
      </li>
    </template>
  </ul>
</div>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
