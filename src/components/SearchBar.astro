---
import { type VersionId } from "../lib/versions";

interface Props {
  version: VersionId;
}

const { version } = Astro.props;
---

<div
  class="relative w-full sm:max-w-md md:max-w-lg"
  x-data={`bibleSearch('${version}')`}
>
  <label class="sr-only" for="bible-search">Search verses</label>
  <div class="relative">
    <svg
      class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-[var(--color-ink-subtle)]"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M20 20l-3-3"></path>
    </svg>
    <input
      id="bible-search"
      type="search"
      placeholder="Search or John 3:16"
      autocomplete="off"
      enterkeyhint="search"
      class="h-10 w-full rounded-xl border border-[var(--color-line)] bg-[var(--color-surface)]/50 py-2 pr-3 pl-9 text-base text-[var(--color-ink)] outline-none ring-[var(--color-primary)] placeholder:text-[var(--color-ink-subtle)] focus:bg-[var(--color-surface-elevated)] focus:ring-2 dark:bg-[var(--color-surface)]/80"
      x-model="q"
      @focus="onFocus"
      @input.debounce.300ms="search"
      @keydown.enter.prevent="goFirst"
    />
  </div>

  <p class="mt-1 text-xs text-[var(--color-ink-subtle)]" x-show="loading">Loading search…</p>
  <p class="mt-1 text-xs text-red-600 dark:text-red-400" x-show="error" x-text="error"></p>

  <ul
    class="absolute z-50 mt-1.5 max-h-[min(20rem,50vh)] w-full overflow-auto rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] shadow-lg"
    x-show="results.length > 0"
    @click.outside="results = []"
  >
    <template x-for="result in results" :key="result.id">
      <li class="border-b border-[var(--color-line)] last:border-0">
        <a
          class="block px-3 py-2.5 transition hover:bg-[var(--color-line)] sm:py-2"
          :href="result.url"
        >
          <span class="block text-sm font-medium text-[var(--color-ink)]" x-text="result.label"></span>
          <span class="mt-0.5 block text-xs leading-snug text-[var(--color-ink-muted)]" x-text="result.snippet"></span>
        </a>
      </li>
    </template>
  </ul>
</div>
