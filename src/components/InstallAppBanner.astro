---
/** Bottom install banner — Alpine: installAppBanner (bobo-proof) */
---

<div x-data="installAppBanner()" x-init="boot()" x-cloak>
  <!-- Spacer keeps chapter/footer actions clear when the banner is visible -->
  <div
    class="pointer-events-none"
    :style="open ? 'height: 9.5rem' : 'height: 0'"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none fixed inset-x-0 bottom-0 z-50 flex justify-center p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:p-4 sm:pb-[max(1rem,env(safe-area-inset-bottom))]"
  >
    <div
      class="pointer-events-auto w-full max-w-lg overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] shadow-lg shadow-black/10"
      x-show="open"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="translate-y-4 opacity-0"
      x-transition:enter-end="translate-y-0 opacity-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="translate-y-0 opacity-100"
      x-transition:leave-end="translate-y-4 opacity-0"
      role="dialog"
      aria-label="Install Bible app"
    >
      <div class="flex gap-3 p-4 sm:p-5">
        <img
          src="/icons/icon.svg"
          alt=""
          width="44"
          height="44"
          class="h-11 w-11 shrink-0 rounded-xl object-cover"
          aria-hidden="true"
        />
        <div class="min-w-0 flex-1">
          <p
            class="font-scripture text-lg font-semibold text-[var(--color-ink)]"
            x-text="title"
          ></p>
          <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)]" x-text="blurb"></p>
          <p
            class="mt-1.5 text-xs text-[var(--color-ink-subtle)]"
            x-show="installHint"
            x-text="installHint"
            x-cloak
          ></p>
          <div class="mt-3 flex flex-wrap gap-2">
            <button
              type="button"
              class="btn-primary !min-h-11 !px-4 text-sm"
              x-show="showSuccessTip"
              x-cloak
              @click="dismissSuccess()"
            >
              Got it
            </button>
            <button
              type="button"
              class="btn-primary !min-h-11 !px-4 text-sm"
              x-show="showPrimaryInstall"
              x-cloak
              @click="primaryAction()"
              :disabled="installBusy"
              x-text="primaryLabel"
            ></button>
            <button
              type="button"
              class="btn-secondary !min-h-11 !px-4 text-sm"
              x-show="!showSuccessTip"
              x-cloak
              @click="notNow()"
            >
              Not now
            </button>
          </div>
          <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
            <button
              type="button"
              class="min-h-10 text-left text-xs text-[var(--color-ink-subtle)] underline-offset-2 hover:underline"
              x-show="installBlocked && !showSuccessTip"
              x-cloak
              @click="openHelp()"
            >
              Need help?
            </button>
            <button
              type="button"
              class="min-h-10 text-left text-xs text-[var(--color-ink-subtle)] underline-offset-2 hover:underline"
              x-show="!showSuccessTip"
              x-cloak
              @click="neverShow()"
            >
              Don’t show again
            </button>
          </div>
        </div>
        <button
          type="button"
          class="shrink-0 self-start rounded-lg p-2 text-[var(--color-ink-subtle)] hover:bg-[var(--color-line)]/40 hover:text-[var(--color-ink)]"
          aria-label="Close"
          @click="showSuccessTip ? dismissSuccess() : notNow()"
        >
          ✕
        </button>
      </div>
    </div>
  </div>

  <div
    class="fixed inset-0 z-[60] flex items-end justify-center bg-black/40 p-3 sm:items-center sm:p-6"
    x-show="showGuide"
    x-cloak
    x-transition.opacity
    @keydown.escape.window="showGuide = false"
    @click.self="showGuide = false"
    role="dialog"
    aria-modal="true"
    aria-label="Install steps"
  >
    <div
      class="w-full max-w-md rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-5 shadow-xl"
      @click.stop
    >
      <template x-if="platform === 'ios'">
        <div>
          <p class="font-scripture text-xl font-semibold text-[var(--color-ink)]">
            iPhone — Add to Home Screen
          </p>
          <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-[var(--color-ink)]">
            <li>Tap <strong>Share</strong> (box with arrow up).</li>
            <li>Tap <strong>Add to Home Screen</strong>.</li>
            <li>Tap <strong>Add</strong> — tapos open from home screen.</li>
          </ol>
        </div>
      </template>
      <template x-if="platform !== 'ios'">
        <div>
          <p class="font-scripture text-xl font-semibold text-[var(--color-ink)]">
            Madaling install (Chrome)
          </p>
          <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-[var(--color-ink)]">
            <li>Buksan ang site sa <strong>Chrome</strong> (huwag sa Facebook).</li>
            <li>Tap <strong>Install — 1 tap</strong>.</li>
            <li>Hanapin ang Bible icon sa home screen mo.</li>
          </ol>
        </div>
      </template>
      <button
        type="button"
        class="btn-primary mt-5 !min-h-11 w-full text-sm"
        @click="showGuide = false"
      >
        Got it
      </button>
    </div>
  </div>
</div>
