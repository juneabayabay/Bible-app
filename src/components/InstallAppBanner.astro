---
/** Bottom install banner — Alpine: installAppBanner */
---

<div x-data="installAppBanner()" x-init="boot()" x-cloak>
  <div
    class="pointer-events-none fixed inset-x-0 bottom-0 z-50 flex justify-center p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:p-4 sm:pb-[max(1rem,env(safe-area-inset-bottom))]"
  >
    <div
      class="pointer-events-auto w-full max-w-lg overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] shadow-lg shadow-black/10"
      x-show="open"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="translate-y-4 opacity-0"
      x-transition:enter-end="translate-y-0 opacity-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="translate-y-0 opacity-100"
      x-transition:leave-end="translate-y-4 opacity-0"
      role="dialog"
      aria-label="Install Bible app"
    >
      <div class="flex gap-3 p-4 sm:p-5">
        <div
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--color-primary)] text-lg font-semibold text-[var(--color-on-primary)]"
          aria-hidden="true"
        >
          B
        </div>
        <div class="min-w-0 flex-1">
          <p class="font-scripture text-lg font-semibold text-[var(--color-ink)]">
            Install Bible on your phone
          </p>
          <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)]" x-text="blurb"></p>
          <div class="mt-3 flex flex-wrap gap-2">
            <button
              type="button"
              class="btn-primary !min-h-11 !px-4 text-sm"
              @click="primaryAction()"
              x-text="primaryLabel"
            ></button>
            <button
              type="button"
              class="btn-secondary !min-h-11 !px-4 text-sm"
              @click="notNow()"
            >
              Not now
            </button>
          </div>
          <button
            type="button"
            class="mt-2 min-h-10 text-left text-xs text-[var(--color-ink-subtle)] underline-offset-2 hover:underline"
            @click="neverShow()"
          >
            Don’t show again
          </button>
        </div>
        <button
          type="button"
          class="shrink-0 self-start rounded-lg p-2 text-[var(--color-ink-subtle)] hover:bg-[var(--color-line)]/40 hover:text-[var(--color-ink)]"
          aria-label="Close"
          @click="notNow()"
        >
          ✕
        </button>
      </div>
    </div>
  </div>

  <div
    class="fixed inset-0 z-[60] flex items-end justify-center bg-black/40 p-3 sm:items-center sm:p-6"
    x-show="showGuide"
    x-cloak
    x-transition.opacity
    @keydown.escape.window="showGuide = false"
    @click.self="showGuide = false"
    role="dialog"
    aria-modal="true"
    aria-label="How to install"
  >
    <div
      class="w-full max-w-md rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-5 shadow-xl"
      @click.stop
    >
      <p class="font-scripture text-xl font-semibold text-[var(--color-ink)]">Add to Home Screen</p>
      <p class="mt-2 text-sm text-[var(--color-ink-muted)]" x-show="platform === 'ios'" x-cloak>
        On iPhone or iPad, use Safari:
      </p>
      <ol
        class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-[var(--color-ink)]"
        x-show="platform === 'ios'"
        x-cloak
      >
        <li>Tap the <strong>Share</strong> button (square with an arrow up).</li>
        <li>Scroll and tap <strong>Add to Home Screen</strong>.</li>
        <li>Tap <strong>Add</strong> — Bible opens like an app.</li>
      </ol>
      <div x-show="platform !== 'ios'" x-cloak>
        <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
          If Install didn’t appear, use your browser menu:
        </p>
        <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-[var(--color-ink)]">
          <li>Open this site in <strong>Chrome</strong>.</li>
          <li>Tap <strong>⋮</strong> or the install icon in the address bar.</li>
          <li>Choose <strong>Install app</strong> or <strong>Add to Home screen</strong>.</li>
        </ol>
      </div>
      <button
        type="button"
        class="btn-primary mt-5 !min-h-11 w-full text-sm"
        @click="showGuide = false"
      >
        Got it
      </button>
    </div>
  </div>
</div>
