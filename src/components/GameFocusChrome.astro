---
import SectionFocusChrome from "./SectionFocusChrome.astro";

interface Props {
  version: string;
  title: string;
  vibe?: string;
}

const { version, title, vibe } = Astro.props;
---

<SectionFocusChrome
  version={version}
  title={title}
  eyebrow={vibe}
  backHref={`/${version}/play`}
  backLabel="Games"
>
  <slot />
</SectionFocusChrome>
