---
/**
 * Slim chrome for focus-mode pages (site header hidden).
 * No Home button — use browser / device Back (or Escape).
 */
interface Props {
  version: string;
  title: string;
  /** Optional small label above the title */
  eyebrow?: string;
}

const { title, eyebrow } = Astro.props;
---

<header class="mb-6 border-b border-[var(--color-line)] pb-4" data-focus-chrome>
  {
    eyebrow && (
      <p class="text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-gold)]">
        {eyebrow}
      </p>
    )
  }
  <h1
    class:list={[
      "font-scripture text-2xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-3xl",
      eyebrow ? "mt-1.5" : "mt-0",
    ]}
  >
    {title}
  </h1>
  <slot />
</header>

<script>
  function focusGoBack(e: KeyboardEvent) {
    if (e.key !== "Escape") return;
    if (window.history.length > 1) window.history.back();
    else window.location.href = "/";
  }
  document.addEventListener("keydown", focusGoBack);
  document.addEventListener(
    "astro:before-preparation",
    () => document.removeEventListener("keydown", focusGoBack),
    { once: true },
  );
</script>
