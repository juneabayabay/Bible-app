---
import type { VersionId } from "../lib/versions";

interface Props {
  version: VersionId;
}

const { version } = Astro.props;

const links = [
  {
    href: `/${version}/devotionals`,
    label: "Grow",
    hint: "Devotionals & prayer",
  },
  {
    href: `/${version}/plans`,
    label: "Plans",
    hint: "Guided reading",
  },
  {
    href: `/${version}/journey`,
    label: "Journey",
    hint: "Streak & progress",
  },
  {
    href: "/saved",
    label: "Saved",
    hint: "Highlights & notes",
  },
] as const;
---

<section
  class="scroll-mt-28 border-t border-[var(--color-line)] pt-8 sm:pt-10"
  aria-labelledby="path-heading"
>
  <header class="max-w-xl">
    <p class="eyebrow">Go deeper</p>
    <h2
      id="path-heading"
      class="font-scripture mt-2 text-2xl font-semibold tracking-tight sm:text-3xl"
    >
      When you’re ready
    </h2>
    <p class="mt-2 text-sm text-[var(--color-ink-muted)] sm:text-base">
      Optional ways to grow — open only what you need today.
    </p>
  </header>

  <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="ui-card flex h-full flex-col p-4 transition hover:border-[var(--color-gold)] sm:p-5"
            data-astro-prefetch
          >
            <span class="font-medium text-[var(--color-ink)]">{link.label}</span>
            <span class="mt-1 text-sm text-[var(--color-ink-muted)]">{link.hint}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
