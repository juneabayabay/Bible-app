---
import type { VersionId } from "../lib/versions";
import { hasWalletNumbers } from "../lib/support";

interface Props {
  version: VersionId;
}

const { version } = Astro.props;
const showGive = hasWalletNumbers();

const links = [
  { href: `/${version}/devotionals`, label: "Devotionals" },
  { href: `/${version}/plans`, label: "Plans" },
  { href: `/${version}/journey`, label: "Journey" },
  { href: `/${version}/play`, label: "Play" },
  { href: `/${version}/feedback`, label: "Feedback" },
  ...(showGive ? [{ href: `/${version}/give`, label: "Give" }] : []),
] as const;
---

<section class="section-rule scroll-mt-28" aria-labelledby="more-heading">
  <h2 id="more-heading" class="section-title mb-4">More</h2>

  <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="flex min-h-12 touch-manipulation items-center justify-center rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-3 text-center text-sm font-semibold text-[var(--color-ink)] transition hover:border-[var(--color-primary)]/45"
            data-astro-prefetch="tap"
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
