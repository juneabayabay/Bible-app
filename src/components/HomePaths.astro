---
import type { VersionId } from "../lib/versions";

interface Props {
  version: VersionId;
}

const { version } = Astro.props;

const links = [
  {
    href: `/${version}/prayer`,
    label: "Prayer",
    hint: "Public wall & private journal",
  },
  {
    href: `/${version}/play`,
    label: "Play",
    hint: "Scripture games",
  },
  {
    href: `/${version}/devotionals`,
    label: "Devotionals",
    hint: "Themes for the heart",
  },
  {
    href: `/${version}/plans`,
    label: "Plans",
    hint: "Guided reading",
  },
  {
    href: `/${version}/journey`,
    label: "Journey",
    hint: "Streak & progress",
  },
  {
    href: `/${version}/give`,
    label: "Give",
    hint: "Optional support",
  },
  {
    href: `/${version}/feedback`,
    label: "Feedback",
    hint: "Help improve the app",
  },
  {
    href: "/saved",
    label: "Saved",
    hint: "Highlights & notes",
  },
] as const;
---

<section
  class="section-rule scroll-mt-28"
  aria-labelledby="path-heading"
>
  <header class="max-w-xl">
    <p class="eyebrow">Go deeper</p>
    <h2
      id="path-heading"
      class="font-scripture mt-2 text-2xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-3xl"
    >
      When you’re ready
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
      Optional ways to grow — open only what you need today.
    </p>
  </header>

  <ul class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="ui-card flex h-full flex-col p-4 sm:p-5"
            data-astro-prefetch="tap"
          >
            <span class="font-semibold text-[var(--color-ink)]">{link.label}</span>
            <span class="mt-1 text-sm text-[var(--color-ink-muted)]">{link.hint}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
