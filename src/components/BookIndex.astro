---
import { groupBooks, isOldTestament, type BookLike } from "../lib/books";

interface Props {
  version: string;
  books: BookLike[];
  defaultTab: "ot" | "nt";
  showTabs: boolean;
}

const { version, books, defaultTab, showTabs } = Astro.props;
const sections = groupBooks(books);

const OT_IDS = new Set([
  "law",
  "history",
  "poetry",
  "major-prophets",
  "minor-prophets",
]);
const NT_IDS = new Set(["gospels", "acts", "paul", "general", "revelation"]);

const ot = sections.filter((s) => OT_IDS.has(s.id));
const nt = sections.filter((s) => NT_IDS.has(s.id));
const otherBooks = sections.find((s) => s.id === "other")?.books ?? [];
const otOther = otherBooks.filter((b) => isOldTestament(b.slug));
const ntOther = otherBooks.filter((b) => !isOldTestament(b.slug));

if (otOther.length) ot.push({ id: "other-ot", label: "Other", books: otOther });
if (ntOther.length) nt.push({ id: "other-nt", label: "Other", books: ntOther });
---

<section id="books" class="scroll-mt-28" x-data={`{ tab: '${defaultTab}' }`}>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <h2 class="text-lg font-semibold tracking-tight text-[var(--color-ink)] sm:text-xl">
      Books
    </h2>

    {showTabs && (
      <div
        class="flex gap-6 border-b border-[var(--color-line)]"
        role="tablist"
        aria-label="Testament"
      >
        <button
          type="button"
          role="tab"
          class="relative -mb-px pb-2.5 text-sm transition"
          :class="tab === 'ot' ? 'font-medium text-[var(--color-ink)]' : 'text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]'"
          @click="tab = 'ot'"
          :aria-selected="tab === 'ot'"
        >
          Old Testament
          <span
            class="absolute inset-x-0 -bottom-px h-0.5 bg-[var(--color-accent)]"
            x-show="tab === 'ot'"
            x-cloak
          ></span>
        </button>
        <button
          type="button"
          role="tab"
          class="relative -mb-px pb-2.5 text-sm transition"
          :class="tab === 'nt' ? 'font-medium text-[var(--color-ink)]' : 'text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]'"
          @click="tab = 'nt'"
          :aria-selected="tab === 'nt'"
        >
          New Testament
          <span
            class="absolute inset-x-0 -bottom-px h-0.5 bg-[var(--color-accent)]"
            x-show="tab === 'nt'"
            x-cloak
          ></span>
        </button>
      </div>
    )}
  </div>

  <div class="mt-8" x-show="tab === 'ot'" {...(defaultTab === "nt" ? { "x-cloak": true } : {})}>
    {ot.length === 0 ? (
      <p class="text-sm text-[var(--color-ink-subtle)]">No Old Testament books in this edition.</p>
    ) : (
      <div class="space-y-8">
        {ot.map((section) => (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-subtle)]">
              {section.label}
            </h3>
            <ul class="mt-3 columns-2 gap-x-5 sm:columns-3 sm:gap-x-8 lg:columns-4 lg:gap-x-10">
              {section.books.map((book) => (
                <li class="mb-1.5 break-inside-avoid">
                  <a
                    class="inline-block py-1 text-[0.95rem] leading-snug text-[var(--color-ink)] underline-offset-2 transition hover:underline sm:text-base"
                    href={`/${version}/book/${book.slug}`}
                    data-astro-prefetch
                  >
                    {book.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
  </div>

  <div class="mt-8" x-show="tab === 'nt'" {...(defaultTab === "ot" ? { "x-cloak": true } : {})}>
    {nt.length === 0 ? (
      <p class="text-sm text-[var(--color-ink-subtle)]">No New Testament books in this edition.</p>
    ) : (
      <div class="space-y-8">
        {nt.map((section) => (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-subtle)]">
              {section.label}
            </h3>
            <ul class="mt-3 columns-2 gap-x-5 sm:columns-3 sm:gap-x-8 lg:columns-4 lg:gap-x-10">
              {section.books.map((book) => (
                <li class="mb-1.5 break-inside-avoid">
                  <a
                    class="inline-block py-1 text-[0.95rem] leading-snug text-[var(--color-ink)] underline-offset-2 transition hover:underline sm:text-base"
                    href={`/${version}/book/${book.slug}`}
                    data-astro-prefetch
                  >
                    {book.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
