---
interface Props {
  version: string;
}

const { version } = Astro.props;
---

<section id="books" class="section-rule scroll-mt-28">
  <a
    href={`/${version}/books`}
    class="group flex w-full touch-manipulation items-center justify-between gap-4 rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-4 py-4 transition hover:border-[var(--color-primary)]/45 active:scale-[0.99] sm:px-5"
    data-astro-prefetch
  >
    <span class="min-w-0">
      <span class="block font-scripture text-xl font-semibold tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-primary)] sm:text-2xl">
        Bible
      </span>
      <span class="mt-0.5 block text-sm text-[var(--color-ink-muted)]">
        Book → chapter → read
      </span>
    </span>
    <span
      class="inline-flex h-9 shrink-0 items-center text-sm font-semibold text-[var(--color-primary)]"
      aria-hidden="true"
    >
      →
    </span>
  </a>
</section>
