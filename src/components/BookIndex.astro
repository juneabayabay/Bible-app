---
import { groupBooks, isOldTestament, type BookLike } from "../lib/books";
import BookAccordion from "./BookAccordion.astro";

interface Props {
  version: string;
  books: BookLike[];
  defaultTab: "ot" | "nt";
  showTabs: boolean;
}

const { version, books, defaultTab, showTabs } = Astro.props;
const sections = groupBooks(books);

const OT_IDS = new Set([
  "law",
  "history",
  "poetry",
  "major-prophets",
  "minor-prophets",
]);
const NT_IDS = new Set(["gospels", "acts", "paul", "general", "revelation"]);

const ot = sections.filter((s) => OT_IDS.has(s.id));
const nt = sections.filter((s) => NT_IDS.has(s.id));
const otherBooks = sections.find((s) => s.id === "other")?.books ?? [];
const otOther = otherBooks.filter((b) => isOldTestament(b.slug));
const ntOther = otherBooks.filter((b) => !isOldTestament(b.slug));

if (otOther.length) ot.push({ id: "other-ot", label: "Other", books: otOther });
if (ntOther.length) nt.push({ id: "other-nt", label: "Other", books: ntOther });
---

<section
  id="books"
  class="scroll-mt-28"
  x-data={`{ open: false, tab: '${defaultTab}' }`}
>
  <button
    type="button"
    class="flex w-full min-h-[4rem] touch-manipulation items-center justify-between gap-4 rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-5 py-4 text-left transition hover:border-[var(--color-primary)]/45"
    @click="open = !open"
    :aria-expanded="open.toString()"
  >
    <span>
      <span class="block font-scripture text-2xl font-semibold tracking-tight text-[var(--color-ink)]">
        Open Bible
      </span>
      <span class="mt-1 block text-sm text-[var(--color-ink-muted)]" x-show="!open">
        Book → chapter → read
      </span>
    </span>
    <span
      class="inline-flex h-9 shrink-0 items-center rounded-full border border-[var(--color-line)] px-3.5 text-sm font-medium text-[var(--color-ink-muted)]"
      x-text="open ? 'Close' : 'Open'"
    ></span>
  </button>

  <div class="mt-4 space-y-5" x-show="open" x-cloak>
    {
      showTabs && (
        <div
          class="inline-flex rounded-lg border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-0.5"
          role="tablist"
          aria-label="Testament"
        >
          <button
            type="button"
            role="tab"
            class="min-h-9 touch-manipulation rounded-md px-4 text-sm font-medium transition"
            :class="tab === 'ot' ? 'bg-[var(--color-primary)] text-[var(--color-on-primary)]' : 'text-[var(--color-ink-muted)]'"
            @click="tab = 'ot'"
            :aria-selected="(tab === 'ot').toString()"
          >
            Old Testament
          </button>
          <button
            type="button"
            role="tab"
            class="min-h-9 touch-manipulation rounded-md px-4 text-sm font-medium transition"
            :class="tab === 'nt' ? 'bg-[var(--color-primary)] text-[var(--color-on-primary)]' : 'text-[var(--color-ink-muted)]'"
            @click="tab = 'nt'"
            :aria-selected="(tab === 'nt').toString()"
          >
            New Testament
          </button>
        </div>
      )
    }

    <div x-show="tab === 'ot'" {...(defaultTab === "nt" ? { "x-cloak": true } : {})}>
      {
        ot.length === 0 ? (
          <p class="text-sm text-[var(--color-ink-subtle)]">No Old Testament books here.</p>
        ) : (
          <BookAccordion version={version} sections={ot} />
        )
      }
    </div>

    <div x-show="tab === 'nt'" {...(defaultTab === "ot" ? { "x-cloak": true } : {})}>
      {
        nt.length === 0 ? (
          <p class="text-sm text-[var(--color-ink-subtle)]">No New Testament books here.</p>
        ) : (
          <BookAccordion version={version} sections={nt} />
        )
      }
    </div>
  </div>
</section>
