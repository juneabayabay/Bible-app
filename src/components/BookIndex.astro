---
import { groupBooks, isOldTestament, type BookLike } from "../lib/books";
import BookAccordion from "./BookAccordion.astro";

interface Props {
  version: string;
  books: BookLike[];
  defaultTab: "ot" | "nt";
  showTabs: boolean;
}

const { version, books, defaultTab, showTabs } = Astro.props;
const sections = groupBooks(books);

const OT_IDS = new Set([
  "law",
  "history",
  "poetry",
  "major-prophets",
  "minor-prophets",
]);
const NT_IDS = new Set(["gospels", "acts", "paul", "general", "revelation"]);

const ot = sections.filter((s) => OT_IDS.has(s.id));
const nt = sections.filter((s) => NT_IDS.has(s.id));
const otherBooks = sections.find((s) => s.id === "other")?.books ?? [];
const otOther = otherBooks.filter((b) => isOldTestament(b.slug));
const ntOther = otherBooks.filter((b) => !isOldTestament(b.slug));

if (otOther.length) ot.push({ id: "other-ot", label: "Other", books: otOther });
if (ntOther.length) nt.push({ id: "other-nt", label: "Other", books: ntOther });
---

<section
  id="books"
  class="section-rule scroll-mt-28"
  x-data={`{ open: false, tab: '${defaultTab}' }`}
>
  <button
    type="button"
    class="group flex w-full touch-manipulation overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] text-left transition hover:border-[var(--color-primary)]/40"
    @click="open = !open"
    :aria-expanded="open.toString()"
  >
    <span class="relative hidden w-[7.5rem] shrink-0 sm:block sm:w-40 md:w-48">
      <img
        src="/images/more/more-devotionals.jpg"
        alt=""
        width="400"
        height="280"
        class="h-full min-h-[5.5rem] w-full object-cover"
        loading="lazy"
        decoding="async"
      />
      <span
        class="absolute inset-0 bg-gradient-to-r from-transparent to-[var(--color-surface-elevated)]"
        aria-hidden="true"
      ></span>
    </span>

    <span class="flex min-w-0 flex-1 items-center justify-between gap-4 px-4 py-4 sm:px-5 sm:py-5">
      <span class="min-w-0">
        <span class="block font-scripture text-xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-2xl">
          Bible
        </span>
        <span class="mt-1 block text-sm text-[var(--color-ink-muted)]">
          Choose a book, then a chapter
        </span>
      </span>
      <span
        class="inline-flex h-10 shrink-0 items-center rounded-full border border-[var(--color-line)] bg-[var(--color-surface)] px-4 text-sm font-semibold text-[var(--color-ink)] transition group-hover:border-[var(--color-primary)]/40"
        x-text="open ? 'Close' : 'Open'"
      ></span>
    </span>
  </button>

  <div
    class="mt-3 space-y-4 rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-4 sm:p-5"
    x-show="open"
    x-cloak
  >
    {
      showTabs && (
        <div class="segment" role="tablist" aria-label="Testament">
          <button
            type="button"
            role="tab"
            class="segment-btn"
            :class="tab === 'ot' ? 'is-active' : ''"
            @click="tab = 'ot'"
            :aria-selected="(tab === 'ot').toString()"
          >
            Old Testament
          </button>
          <button
            type="button"
            role="tab"
            class="segment-btn"
            :class="tab === 'nt' ? 'is-active' : ''"
            @click="tab = 'nt'"
            :aria-selected="(tab === 'nt').toString()"
          >
            New Testament
          </button>
        </div>
      )
    }

    <div x-show="tab === 'ot'" {...(defaultTab === "nt" ? { "x-cloak": true } : {})}>
      {
        ot.length === 0 ? (
          <p class="text-sm text-[var(--color-ink-subtle)]">No books here.</p>
        ) : (
          <BookAccordion version={version} sections={ot} />
        )
      }
    </div>

    <div x-show="tab === 'nt'" {...(defaultTab === "ot" ? { "x-cloak": true } : {})}>
      {
        nt.length === 0 ? (
          <p class="text-sm text-[var(--color-ink-subtle)]">No books here.</p>
        ) : (
          <BookAccordion version={version} sections={nt} />
        )
      }
    </div>
  </div>
</section>
