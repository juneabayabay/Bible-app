---
/**
 * Compact next steps — Continue + Saved only (no streak/dashboard clutter).
 */
---

<section class="mt-8 sm:mt-10" aria-label="Your next step">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-[var(--color-ink-muted)]" x-text="welcome"></p>

    <div class="flex flex-wrap gap-2">
      <a
        class="btn-primary !min-h-10 !px-4 text-sm"
        :href="continueUrl || '#books'"
        data-astro-prefetch
      >
        <span x-show="continueUrl" x-cloak>
          Continue <span class="font-medium" x-text="continueLabel"></span>
        </span>
        <span x-show="!continueUrl">Browse books</span>
      </a>

      <a class="btn-secondary !min-h-10 !px-4 text-sm" href="/saved">
        <span x-text="savedCount > 0 ? `Saved (${savedCount})` : 'Saved'"></span>
      </a>
    </div>
  </div>
</section>
