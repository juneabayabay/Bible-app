---
/**
 * Compact next steps — Continue + Saved only (no streak/dashboard clutter).
 */
---

<section aria-label="Your next step">
  <div class="flex flex-col gap-3 rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)]/80 p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-4 sm:p-5">
    <p class="text-sm leading-relaxed text-[var(--color-ink-muted)]" x-text="welcome"></p>

    <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:flex-wrap">
      <a
        class="btn-primary !min-h-11 w-full !px-4 text-sm sm:w-auto"
        :href="continueUrl || '#books'"
        data-astro-prefetch
      >
        <span x-show="continueUrl" x-cloak>
          Continue <span class="font-medium" x-text="continueLabel"></span>
        </span>
        <span x-show="!continueUrl">Browse books</span>
      </a>

      <a
        class="btn-secondary !min-h-11 w-full !px-4 text-sm sm:w-auto"
        :href="`/${version}/prayer`"
        data-astro-prefetch
      >
        Prayer
      </a>

      <a class="btn-secondary !min-h-11 w-full !px-4 text-sm sm:w-auto" href="/saved">
        <span x-text="savedCount > 0 ? `Saved (${savedCount})` : 'Saved'"></span>
      </a>
    </div>
  </div>
</section>
