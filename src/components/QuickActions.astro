---
/**
 * Continue + Saved — balanced action strip.
 */
---

<section aria-label="Continue reading" class="grid gap-2 sm:grid-cols-[1fr_auto]">
  <a
    class="btn-primary flex !min-h-12 touch-manipulation items-center justify-center gap-2 !px-5 text-sm sm:justify-start"
    :href="continueUrl || '#books'"
    data-astro-prefetch
  >
    <span class="opacity-80" aria-hidden="true">→</span>
    <span x-show="continueUrl" x-cloak>
      Continue · <span class="font-semibold" x-text="continueLabel"></span>
    </span>
    <span x-show="!continueUrl">Open Bible</span>
  </a>
  <a
    class="btn-secondary flex !min-h-12 touch-manipulation items-center justify-center !px-5 text-sm"
    href="/saved"
    data-astro-prefetch="tap"
  >
    <span x-text="savedCount > 0 ? `Saved (${savedCount})` : 'Saved'"></span>
  </a>
</section>
