---
import {
  versionsByLanguage,
  getVersion,
  languageBadge,
  type VersionId,
} from "../lib/versions";

interface Props {
  version: VersionId;
}

const { version } = Astro.props;
const groups = versionsByLanguage();
const current = getVersion(version);
const badge = languageBadge(current.language);

function plainName(description: string) {
  return description.replace(/\s*\([^)]*\)\s*$/, "").trim();
}
---

<div
  class="relative shrink-0"
  x-data={`versionPicker(${JSON.stringify(version)})`}
  @keydown.escape.window="open = false"
>
  <button
    type="button"
    id="bible-version"
    class="inline-flex h-10 max-w-[7.5rem] items-center gap-1 rounded-lg py-1 pr-1.5 pl-1 text-[var(--color-ink)] outline-none transition hover:bg-[var(--color-line)]/60 focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] sm:h-9 sm:max-w-[9.5rem] sm:gap-1.5"
    @click="open = !open"
    :aria-expanded="open.toString()"
    aria-haspopup="listbox"
    aria-controls="bible-version-list"
    :aria-label="label"
    :title="label"
  >
    <span class="lang-badge" aria-hidden="true" x-text="badge">{badge}</span>
    <span class="min-w-0 truncate text-sm font-semibold" x-text="shortLabel">{current.shortLabel}</span>
    <svg class="hidden h-3.5 w-3.5 shrink-0 text-[var(--color-ink-subtle)] sm:block" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path
        fill-rule="evenodd"
        d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
        clip-rule="evenodd"
      ></path>
    </svg>
  </button>

  <!-- Anchored under the control; stays in viewport on phones -->
  <div
    id="bible-version-list"
    class="absolute right-0 z-50 mt-2 w-[min(18rem,calc(100vw-1.25rem))] max-h-[min(24rem,70vh)] overflow-auto rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] shadow-lg"
    x-show="open"
    x-cloak
    @click.outside="open = false"
    role="listbox"
    aria-labelledby="bible-version"
  >
    <p class="border-b border-[var(--color-line)] px-3.5 py-2.5 text-xs text-[var(--color-ink-muted)]">
      Choose language &amp; version
    </p>

    {groups.map((group) => {
      const langCode = languageBadge(group.versions[0]?.language ?? "");
      return (
        <div class="border-b border-[var(--color-line)] last:border-b-0">
          <div class="flex items-center gap-2 px-3.5 pt-3 pb-1.5">
            <span class="lang-badge" aria-hidden="true">{langCode}</span>
            <span class="text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-muted)]">
              {group.languageName}
            </span>
          </div>

          <div class="px-1.5 pb-2">
            {group.versions.map((opt) => (
              <button
                type="button"
                class:list={[
                  "flex w-full items-center gap-3 rounded-lg px-2.5 py-2.5 text-left transition sm:py-2",
                ]}
                :class={`current === '${opt.id}' ? 'bg-[color-mix(in_srgb,var(--color-primary)_12%,transparent)]' : 'hover:bg-[color-mix(in_srgb,var(--color-line)_55%,transparent)]'`}
                role="option"
                :aria-selected={`(current === '${opt.id}').toString()`}
                @click={`switchTo(${JSON.stringify(opt.id)})`}
              >
                <span class="min-w-0 flex-1">
                  <span class="block text-sm font-semibold text-[var(--color-ink)]">
                    {opt.shortLabel}
                  </span>
                  <span class="block truncate text-xs text-[var(--color-ink-subtle)]">
                    {plainName(opt.description)}
                  </span>
                </span>
                <span
                  class="shrink-0 text-xs font-semibold text-[var(--color-primary)]"
                  x-show={`current === '${opt.id}'`}
                  x-cloak
                >
                  Current
                </span>
              </button>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</div>
