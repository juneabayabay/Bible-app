---
import {
  versionsByLanguage,
  getVersion,
  languageBadge,
  type VersionId,
} from "../lib/versions";

interface Props {
  version: VersionId;
}

const { version } = Astro.props;
const groups = versionsByLanguage().map((group) => ({
  languageName: group.languageName,
  langCode: languageBadge(group.versions[0]?.language ?? ""),
  versions: group.versions.map((opt) => ({
    id: opt.id,
    shortLabel: opt.shortLabel,
    description: opt.description.replace(/\s*\([^)]*\)\s*$/, "").trim(),
  })),
}));
const current = getVersion(version);
const badge = languageBadge(current.language);
const pickerData = JSON.stringify({ version, groups });
---

<div
  class="relative shrink-0"
  x-data={`versionPicker(${pickerData})`}
  @keydown.escape.window="close()"
>
  <button
    type="button"
    id="bible-version"
    class="inline-flex h-10 max-w-[7.5rem] items-center gap-1 rounded-lg py-1 pr-1.5 pl-1 text-[var(--color-ink)] outline-none transition hover:bg-[var(--color-line)]/60 focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] sm:h-9 sm:max-w-[9.5rem] sm:gap-1.5"
    @click="toggle()"
    :aria-expanded="open.toString()"
    aria-haspopup="listbox"
    aria-controls="bible-version-list"
    :aria-label="label"
    :title="label"
  >
    <span class="lang-badge" aria-hidden="true" x-text="badge">{badge}</span>
    <span class="min-w-0 truncate text-sm font-semibold" x-text="shortLabel">{current.shortLabel}</span>
    <svg class="hidden h-3.5 w-3.5 shrink-0 text-[var(--color-ink-subtle)] sm:block" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path
        fill-rule="evenodd"
        d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
        clip-rule="evenodd"
      ></path>
    </svg>
  </button>

  <div
    id="bible-version-list"
    class="absolute right-0 z-50 mt-2 flex w-[min(18rem,calc(100vw-1.25rem))] max-h-[min(24rem,70vh)] flex-col overflow-hidden rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] shadow-lg"
    x-show="open"
    x-cloak
    @click.outside="close()"
    role="listbox"
    aria-labelledby="bible-version"
  >
    <div class="sticky top-0 z-10 border-b border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-3 pt-3 pb-2.5">
      <p class="text-xs text-[var(--color-ink-muted)]">Choose language &amp; version</p>
      <label class="sr-only" for="bible-version-search">Search language</label>
      <div class="relative mt-2">
        <svg
          class="pointer-events-none absolute top-1/2 left-2.5 h-4 w-4 -translate-y-1/2 text-[var(--color-ink-subtle)]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3-3"></path>
        </svg>
        <input
          id="bible-version-search"
          type="search"
          x-ref="langSearch"
          x-model="q"
          placeholder="Type a language…"
          autocomplete="off"
          enterkeyhint="search"
          class="h-10 w-full rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] py-2 pr-3 pl-8 text-base text-[var(--color-ink)] outline-none ring-[var(--color-primary)] placeholder:text-[var(--color-ink-subtle)] focus:ring-2 sm:h-9 sm:text-sm"
          @keydown.escape.stop="close()"
          @keydown.enter.prevent="pickFirst()"
        />
      </div>
    </div>

    <div class="min-h-0 flex-1 overflow-auto">
      <p
        class="px-3.5 py-4 text-sm text-[var(--color-ink-muted)]"
        x-show="filtered.length === 0"
        x-cloak
      >
        No language found. Try another word.
      </p>

      <template x-for="group in filtered" :key="group.languageName">
        <div class="border-b border-[var(--color-line)] last:border-b-0">
          <div class="flex items-center gap-2 px-3.5 pt-3 pb-1.5">
            <span class="lang-badge" aria-hidden="true" x-text="group.langCode"></span>
            <span
              class="text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-muted)]"
              x-text="group.languageName"
            ></span>
          </div>

          <div class="px-1.5 pb-2">
            <template x-for="opt in group.versions" :key="opt.id">
              <button
                type="button"
                class="flex w-full items-center gap-3 rounded-lg px-2.5 py-2.5 text-left transition sm:py-2"
                :class="current === opt.id ? 'bg-[color-mix(in_srgb,var(--color-primary)_12%,transparent)]' : 'hover:bg-[color-mix(in_srgb,var(--color-line)_55%,transparent)]'"
                role="option"
                :aria-selected="(current === opt.id).toString()"
                @click="switchTo(opt.id)"
              >
                <span class="min-w-0 flex-1">
                  <span
                    class="block text-sm font-semibold text-[var(--color-ink)]"
                    x-text="opt.shortLabel"
                  ></span>
                  <span
                    class="block truncate text-xs text-[var(--color-ink-subtle)]"
                    x-text="opt.description"
                  ></span>
                </span>
                <span
                  class="shrink-0 text-xs font-semibold text-[var(--color-primary)]"
                  x-show="current === opt.id"
                  x-cloak
                >
                  Current
                </span>
              </button>
            </template>
          </div>
        </div>
      </template>
    </div>
  </div>
</div>
