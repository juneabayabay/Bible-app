---
import { versionsByLanguage, getVersion, type VersionId } from "../lib/versions";

interface Props {
  version: VersionId;
}

const { version } = Astro.props;
const groups = versionsByLanguage();
const current = getVersion(version);
---

<div class="shrink-0" x-data={`versionPicker(${JSON.stringify(version)})`}>
  <label class="sr-only" for="bible-version">Bible version</label>
  <select
    id="bible-version"
    class="max-w-[7.5rem] rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-2 py-2 text-xs text-[var(--color-ink)] outline-none ring-[var(--color-primary)] focus:ring-2 sm:max-w-[12rem] sm:px-2.5 sm:text-sm"
    x-model="current"
    @change="switchTo(current)"
    title={current.label}
  >
    {groups.map((group) => (
      <optgroup label={group.languageName}>
        {group.versions.map((opt) => (
          <option value={opt.id} selected={opt.id === version}>
            {opt.shortLabel}
          </option>
        ))}
      </optgroup>
    ))}
  </select>
</div>
