---
import { versionsByLanguage, type VersionId } from "../lib/versions";

interface Props {
  version: VersionId;
}

const { version } = Astro.props;
const groups = versionsByLanguage();
---

<div class="shrink-0" x-data={`versionPicker(${JSON.stringify(version)})`}>
  <label class="sr-only" for="bible-version">Bible version</label>
  <select
    id="bible-version"
    class="max-w-[11rem] rounded-md border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-2 py-2 text-xs text-[var(--color-ink)] outline-none ring-[var(--color-accent)] focus:ring-2 sm:max-w-[16rem] sm:px-3 sm:text-sm"
    x-model="current"
    @change="switchTo(current)"
  >
    {groups.map((group) => (
      <optgroup label={group.languageName}>
        {group.versions.map((opt) => (
          <option value={opt.id} selected={opt.id === version}>
            {opt.label}
          </option>
        ))}
      </optgroup>
    ))}
  </select>
</div>
