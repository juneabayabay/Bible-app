---
import type { BookLike } from "../lib/books";

interface Props {
  version: string;
  sections: Array<{ id: string; label: string; books: BookLike[] }>;
}

const { version, sections } = Astro.props;
---

<div class="space-y-5" x-data="{ book: '' }">
  {
    sections.map((section) => (
      <div>
        <p class="mb-2 text-xs font-medium text-[var(--color-ink-subtle)]">{section.label}</p>
        <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4">
          {section.books.map((b) => (
            <li>
              <button
                type="button"
                class="flex min-h-11 w-full touch-manipulation items-center justify-center rounded-xl border px-2 text-center text-sm font-medium transition"
                :class={`book === '${b.slug}'
                  ? 'border-[var(--color-primary)] bg-[var(--color-primary)] text-[var(--color-on-primary)]'
                  : 'border-[var(--color-line)] bg-[var(--color-surface-elevated)] text-[var(--color-ink)]'`}
                @click={`book = book === '${b.slug}' ? '' : '${b.slug}'`}
              >
                {b.name}
              </button>
            </li>
          ))}
        </ul>

        {section.books.map((b) => {
          const chs = b.chapters ?? [];
          return (
            <div
              class="mt-3 rounded-xl border border-[var(--color-line)] bg-[var(--color-surface)] p-4"
              x-show={`book === '${b.slug}'`}
              x-cloak
            >
              <p class="mb-3 text-sm font-medium text-[var(--color-ink)]">
                {b.name} · chapter
              </p>
              <ul class="grid grid-cols-6 gap-1.5 sm:grid-cols-9 md:grid-cols-12">
                {chs.map((n) => (
                  <li>
                    <a
                      class="inline-flex h-9 w-full touch-manipulation items-center justify-center rounded-md border border-[var(--color-line)] bg-[var(--color-surface-elevated)] text-sm tabular-nums text-[var(--color-ink)] transition hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]"
                      href={`/${version}/chapter/${b.slug}/${n}`}
                      data-astro-prefetch="tap"
                    >
                      {n}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    ))
  }
</div>
