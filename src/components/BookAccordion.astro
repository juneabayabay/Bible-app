---
import type { BookLike } from "../lib/books";

interface Props {
  version: string;
  sections: Array<{ id: string; label: string; books: BookLike[] }>;
}

const { version, sections } = Astro.props;

function chaptersOf(book: BookLike): number[] {
  return book.chapters ?? [];
}
---

<div class="space-y-7">
  {
    sections.map((section) => (
      <div>
        <h3 class="mb-2 text-xs font-medium text-[var(--color-ink-subtle)]">
          {section.label}
        </h3>
        <ul class="overflow-hidden rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)]">
          {section.books.map((book) => {
            const chs = chaptersOf(book);
            return (
              <li class="border-b border-[var(--color-line)] last:border-b-0">
                <details class="group book-row">
                  <summary class="flex min-h-12 cursor-pointer list-none touch-manipulation items-center justify-between gap-3 px-4 py-3 text-left [&::-webkit-details-marker]:hidden">
                    <span class="font-scripture text-[1.05rem] font-semibold text-[var(--color-ink)]">
                      {book.name}
                    </span>
                    <span
                      class="text-xs text-[var(--color-ink-subtle)] transition group-open:rotate-180"
                      aria-hidden="true"
                    >
                      ▾
                    </span>
                  </summary>
                  <div class="px-4 pb-4">
                    <ul class="grid grid-cols-7 gap-1.5 sm:grid-cols-10 md:grid-cols-12">
                      {chs.map((n) => (
                        <li>
                          <a
                            class="inline-flex h-9 w-full touch-manipulation items-center justify-center rounded-md bg-[var(--color-surface)] text-sm tabular-nums text-[var(--color-ink)] ring-1 ring-[var(--color-line)] transition hover:text-[var(--color-primary)] hover:ring-[var(--color-primary)] active:scale-[0.96]"
                            href={`/${version}/chapter/${book.slug}/${n}`}
                            data-astro-prefetch="tap"
                          >
                            {n}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .book-row summary {
    outline: none;
  }
  .book-row summary:focus-visible {
    box-shadow: inset 0 0 0 2px var(--color-primary);
  }
</style>
