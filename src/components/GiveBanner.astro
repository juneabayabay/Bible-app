---
import type { VersionId } from "../lib/versions";
import { hasWalletNumbers } from "../lib/support";

interface Props {
  version: VersionId;
}

const { version } = Astro.props;
const ready = hasWalletNumbers();
---

{
  ready ? (
    <aside
      class="flex flex-col gap-3 rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-5"
      aria-label="Give"
    >
      <div class="min-w-0">
        <p class="font-scripture text-lg font-semibold text-[var(--color-ink)]">Give</p>
        <p class="mt-0.5 text-sm leading-relaxed text-[var(--color-ink-muted)]">
          Optional · help keep Scripture free for others
        </p>
      </div>
      <a
        class="btn-secondary inline-flex !min-h-10 shrink-0 items-center justify-center !px-4 text-sm"
        href={`/${version}/give`}
        data-astro-prefetch="tap"
      >
        See how
      </a>
    </aside>
  ) : null
}
