---
import type { VersionId } from "../lib/versions";
import { hasWalletNumbers } from "../lib/support";

interface Props {
  version: VersionId;
}

const { version } = Astro.props;
const ready = hasWalletNumbers();
---

{
  ready ? (
    <aside class="section-rule" aria-label="Give">
      <div class="flex flex-col gap-3 rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-5">
        <div class="section-head min-w-0">
          <p class="eyebrow">Support</p>
          <p class="section-title text-[1.25rem] sm:text-xl">Give</p>
          <p class="section-lead">Optional — help keep this Bible free for others.</p>
        </div>
        <a
          class="btn-secondary inline-flex !min-h-10 shrink-0 items-center justify-center !px-4 text-sm"
          href={`/${version}/give`}
          data-astro-prefetch="tap"
        >
          How to give
        </a>
      </div>
    </aside>
  ) : null
}
