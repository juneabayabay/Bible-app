---
interface Props {
  headline?: string;
  subcopy?: string;
  /** Primary action — continue reading or open today's chapter */
  ctaHref: string;
  ctaLabel?: string;
  booksHref?: string;
  verseText?: string;
  verseCite?: string;
  verseUrl?: string;
}

const {
  headline = "Open God’s Word today",
  subcopy = "A quiet place to read Scripture, highlight verses, and keep notes on this device.",
  ctaHref,
  ctaLabel = "Start reading",
  booksHref = "#books",
  verseText,
  verseCite,
  verseUrl,
} = Astro.props;
---

<section
  class="full-bleed overflow-hidden"
  aria-labelledby="hero-heading"
>
  <div class="absolute inset-0">
    <img
      src="/images/hero-sunrise.jpg"
      alt=""
      width="1920"
      height="1080"
      class="h-full min-h-[22rem] w-full object-cover object-center sm:min-h-[26rem] lg:min-h-[28rem]"
      fetchpriority="high"
    />
    <!-- Always cinematic (same in light & dark); page below follows theme -->
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-scrim-soft" aria-hidden="true"></div>
    <div class="hero-fade" aria-hidden="true"></div>
  </div>

  <div class="relative mx-auto grid w-full max-w-6xl gap-8 px-4 pb-12 pt-14 sm:gap-10 sm:px-6 sm:pb-14 sm:pt-16 lg:max-w-7xl lg:grid-cols-12 lg:items-end lg:gap-12 lg:px-8 lg:pb-16 lg:pt-20">
    <div class="animate-soft-rise lg:col-span-5">
      <h1
        id="hero-heading"
        class="font-scripture hero-ink text-3xl font-semibold tracking-tight [text-shadow:0_1px_18px_rgb(0_0_0_/_0.35)] sm:text-4xl lg:text-[2.75rem] lg:leading-tight"
      >
        {headline}
      </h1>
      <p class="hero-ink-muted mt-3 max-w-md text-base leading-relaxed sm:text-lg">
        {subcopy}
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="hero-btn-primary" href={ctaHref} data-astro-prefetch>
          {ctaLabel}
        </a>
        <a class="hero-btn-secondary" href={booksHref}>
          Open Bible
        </a>
      </div>
    </div>

    {verseText && (
      <div class="animate-soft-rise lg:col-span-7" style="animation-delay: 80ms">
        <div class="hero-card rounded-2xl p-5 sm:p-6">
          <p class="hero-gold text-xs font-semibold uppercase tracking-[0.12em]">
            Today’s verse
          </p>
          <blockquote class="font-scripture hero-ink mt-3 text-xl leading-snug sm:text-2xl sm:leading-snug">
            {verseText}
          </blockquote>
          {verseCite && <p class="hero-ink-subtle mt-3 text-sm">{verseCite}</p>}
          {verseUrl && (
            <a
              class="hero-gold mt-5 inline-flex min-h-10 items-center text-sm font-medium underline-offset-2 hover:underline"
              href={verseUrl}
              data-astro-prefetch
            >
              Read this chapter →
            </a>
          )}
        </div>
      </div>
    )}
  </div>
</section>
