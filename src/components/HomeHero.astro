---
interface Props {
  headline?: string;
  subcopy?: string;
  /** Primary action — continue reading or open today's chapter */
  ctaHref: string;
  ctaLabel?: string;
  booksHref?: string;
  verseText?: string;
  verseCite?: string;
  verseUrl?: string;
}

const {
  headline = "Open God’s Word today",
  subcopy = "A quiet place to read Scripture, highlight verses, and keep notes on this device.",
  ctaHref,
  ctaLabel = "Start reading",
  booksHref = "#books",
  verseText,
  verseCite,
  verseUrl,
} = Astro.props;
---

<section
  class="relative left-1/2 w-screen max-w-[100vw] -translate-x-1/2 overflow-hidden"
  aria-labelledby="hero-heading"
>
  <div class="absolute inset-0">
    <img
      src="/images/hero-sunrise.jpg"
      alt=""
      width="1920"
      height="1080"
      class="h-full min-h-[22rem] w-full object-cover object-center sm:min-h-[26rem] lg:min-h-[28rem]"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-[#0b1a3a]/75 via-[#1e3a8a]/50 to-[var(--color-surface)]"
      aria-hidden="true"
    ></div>
  </div>

  <div class="relative mx-auto grid w-full max-w-6xl gap-8 px-4 pb-10 pt-14 sm:gap-10 sm:px-6 sm:pb-12 sm:pt-16 lg:max-w-7xl lg:grid-cols-12 lg:items-end lg:gap-12 lg:px-8 lg:pb-14 lg:pt-20">
    <div class="animate-soft-rise text-white lg:col-span-5">
      <h1
        id="hero-heading"
        class="font-scripture text-3xl font-semibold tracking-tight sm:text-4xl lg:text-[2.75rem] lg:leading-tight"
      >
        {headline}
      </h1>
      <p class="mt-3 max-w-md text-base leading-relaxed text-white/90 sm:text-lg">
        {subcopy}
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          class="btn-primary !bg-[var(--color-gold)] !text-[#152238] hover:!opacity-95"
          href={ctaHref}
          data-astro-prefetch
        >
          {ctaLabel}
        </a>
        <a
          class="inline-flex min-h-11 items-center justify-center rounded-[0.875rem] border border-white/35 bg-white/10 px-5 text-sm font-medium text-white backdrop-blur-sm transition hover:bg-white/18"
          href={booksHref}
        >
          Browse books
        </a>
      </div>
    </div>

    {verseText && (
      <div class="animate-soft-rise lg:col-span-7" style="animation-delay: 80ms">
        <div class="rounded-2xl border border-white/20 bg-white/12 p-5 backdrop-blur-md sm:p-6">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-gold-soft)]">
            Today’s verse
          </p>
          <blockquote class="font-scripture mt-3 text-xl leading-snug text-white sm:text-2xl sm:leading-snug">
            {verseText}
          </blockquote>
          {verseCite && <p class="mt-3 text-sm text-white/75">{verseCite}</p>}
          {verseUrl && (
            <a
              class="mt-5 inline-flex min-h-10 items-center text-sm font-medium text-[var(--color-gold-soft)] underline-offset-2 hover:underline"
              href={verseUrl}
              data-astro-prefetch
            >
              Read this chapter →
            </a>
          )}
        </div>
      </div>
    )}
  </div>
</section>
