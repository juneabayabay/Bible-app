---
import { getDevotionThemes } from "../lib/devotionals";

interface Props {
  version: string;
}

const { version } = Astro.props;
const themes = getDevotionThemes();
---

<section
  class="border-t border-[var(--color-line)] pt-10 sm:pt-12"
  aria-labelledby="devotionals-preview-heading"
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <header class="max-w-xl">
      <p class="eyebrow">Devotionals</p>
      <h2
        id="devotionals-preview-heading"
        class="font-scripture mt-2 text-2xl font-semibold tracking-tight sm:text-3xl"
      >
        Grow by theme
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        Short readings on love, kindness, humility, grace, and more—organized so you can focus on one virtue at a time.
      </p>
    </header>
    <a
      class="btn-secondary !min-h-10 shrink-0 !px-4 text-sm"
      href={`/${version}/devotionals`}
      data-astro-prefetch
    >
      All themes
    </a>
  </div>

  <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {themes.slice(0, 6).map((theme) => (
      <li>
        <a
          class="ui-card group flex h-full flex-col overflow-hidden p-0 transition hover:border-[var(--color-gold)]"
          href={`/${version}/devotionals/${theme.slug}`}
          data-astro-prefetch
        >
          <div class="aspect-[16/9] overflow-hidden">
            <img
              src={theme.image}
              alt={theme.imageAlt}
              width="480"
              height="270"
              loading="lazy"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
            />
          </div>
          <div class="flex flex-1 flex-col p-5">
            <h3 class="font-scripture text-xl font-semibold text-[var(--color-ink)]">{theme.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-ink-muted)]">{theme.summary}</p>
            <p class="mt-4 text-xs font-medium text-[var(--color-gold)]">
              {theme.relatedVerses.length} verses · {theme.entries.length}{" "}
              {theme.entries.length === 1 ? "reading" : "readings"} →
            </p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
