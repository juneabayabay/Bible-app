---
/**
 * Home prayer preview — clean feed, light actions.
 */
interface Props {
  version: string;
}

const { version } = Astro.props;
---

<section
  id="prayer-wall"
  class="section-rule scroll-mt-28"
  aria-labelledby="home-prayer-heading"
  x-data="homePrayerWall()"
  x-init="boot()"
>
  <div class="mb-5 flex items-baseline justify-between gap-4">
    <div>
      <h2 id="home-prayer-heading" class="section-title">Prayer</h2>
      <p class="mt-1 text-sm text-[var(--color-ink-muted)]">Live requests</p>
    </div>
    <a
      class="shrink-0 text-sm font-medium text-[var(--color-primary)] underline-offset-2 hover:underline"
      href={`/${version}/prayer`}
      data-astro-prefetch="tap"
    >
      View all
    </a>
  </div>

  <p class="mb-3 text-xs text-[var(--color-ink-subtle)]" x-show="status" x-text="status" x-cloak></p>
  <p class="py-8 text-center text-sm text-[var(--color-ink-subtle)]" x-show="loading" x-cloak>Loading…</p>

  <p
    class="rounded-xl border border-dashed border-[var(--color-line)] px-4 py-8 text-center text-sm text-[var(--color-ink-muted)]"
    x-show="!loading && items.length === 0"
    x-cloak
  >
    No requests yet.
    <a
      class="font-medium text-[var(--color-ink)] underline-offset-2 hover:underline"
      href={`/${version}/prayer`}
      data-astro-prefetch="tap"
    >
      Share one
    </a>
  </p>

  <ul
    class="overflow-hidden rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)]"
    x-show="!loading && items.length > 0"
    x-cloak
  >
    <template x-for="item in items" :key="item.id">
      <li class="border-b border-[var(--color-line)] px-4 py-4 last:border-b-0 sm:px-5 sm:py-5">
        <p class="text-xs text-[var(--color-ink-subtle)]">
          <span class="font-medium text-[var(--color-ink-muted)]" x-text="item.displayName"></span>
          <span aria-hidden="true"> · </span>
          <span x-text="formatDate(item.createdAt)"></span>
        </p>
        <p
          class="mt-2 font-scripture text-lg leading-snug text-[var(--color-ink)] sm:text-xl"
          x-text="item.body"
        ></p>

        <div class="mt-4 flex flex-wrap items-center gap-x-1 gap-y-2 text-sm">
          <button
            type="button"
            class="inline-flex min-h-9 touch-manipulation items-center rounded-md px-2 font-medium transition"
            :class="hasReaction(item, 'prayed')
              ? 'text-[var(--color-primary)]'
              : 'text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]'"
            :disabled="busy"
            @click="react(item.id, 'prayed')"
          >
            Pray<span
              class="ml-1 tabular-nums opacity-70"
              x-show="item.reactionCounts.prayed"
              x-text="item.reactionCounts.prayed"
              x-cloak
            ></span>
          </button>
          <span class="text-[var(--color-line)]" aria-hidden="true">·</span>
          <button
            type="button"
            class="inline-flex min-h-9 touch-manipulation items-center rounded-md px-2 font-medium transition"
            :class="hasReaction(item, 'amen')
              ? 'text-[var(--color-primary)]'
              : 'text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]'"
            :disabled="busy"
            @click="react(item.id, 'amen')"
          >
            Amen<span
              class="ml-1 tabular-nums opacity-70"
              x-show="item.reactionCounts.amen"
              x-text="item.reactionCounts.amen"
              x-cloak
            ></span>
          </button>
          <span class="text-[var(--color-line)]" aria-hidden="true">·</span>
          <button
            type="button"
            class="inline-flex min-h-9 touch-manipulation items-center rounded-md px-2 font-medium transition"
            :class="hasReaction(item, 'heart')
              ? 'text-[var(--color-primary)]'
              : 'text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]'"
            :disabled="busy"
            @click="react(item.id, 'heart')"
          >
            Love<span
              class="ml-1 tabular-nums opacity-70"
              x-show="item.reactionCounts.heart"
              x-text="item.reactionCounts.heart"
              x-cloak
            ></span>
          </button>
          <span class="ml-auto"></span>
          <a
            class="inline-flex min-h-9 items-center px-1 text-sm font-medium text-[var(--color-ink-subtle)] underline-offset-2 hover:text-[var(--color-primary)] hover:underline"
            href={`/${version}/prayer#wall`}
            data-astro-prefetch="tap"
          >
            <span x-text="item.comments.length ? `Comments (${item.comments.length})` : 'Comment'"></span>
          </a>
        </div>
      </li>
    </template>
  </ul>
</section>
