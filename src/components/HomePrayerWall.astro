---
/**
 * Home prayer preview — latest request + its newest comment only.
 * Full wall (reactions, all comments) lives on /prayer.
 */
interface Props {
  version: string;
}

const { version } = Astro.props;
---

<section
  id="prayer-wall"
  class="section-rule scroll-mt-28"
  aria-labelledby="home-prayer-heading"
  x-data="homePrayerWall()"
  x-init="boot()"
>
  <div class="mb-4 flex items-end justify-between gap-3">
    <div>
      <h2 id="home-prayer-heading" class="section-title">Prayer</h2>
      <p class="mt-1 text-sm text-[var(--color-ink-muted)]">Latest from the wall</p>
    </div>
    <a
      class="shrink-0 text-sm font-medium text-[var(--color-primary)] underline-offset-2 hover:underline"
      href={`/${version}/prayer`}
      data-astro-prefetch="tap"
    >
      View all
    </a>
  </div>

  <p class="mb-3 text-xs text-[var(--color-ink-subtle)]" x-show="status" x-text="status" x-cloak></p>
  <p class="py-6 text-center text-sm text-[var(--color-ink-subtle)]" x-show="loading" x-cloak>Loading…</p>

  <p
    class="rounded-xl border border-dashed border-[var(--color-line)] px-4 py-6 text-center text-sm text-[var(--color-ink-muted)]"
    x-show="!loading && !item"
    x-cloak
  >
    No requests yet.
    <a
      class="font-medium text-[var(--color-ink)] underline-offset-2 hover:underline"
      href={`/${version}/prayer`}
      data-astro-prefetch="tap"
    >
      Share one
    </a>
  </p>

  <template x-if="!loading && item">
    <div
      class="overflow-hidden rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-4 py-4 sm:px-5"
    >
      <p class="text-xs text-[var(--color-ink-subtle)]">
        <span class="font-medium text-[var(--color-ink-muted)]" x-text="item.displayName"></span>
        <span aria-hidden="true"> · </span>
        <span x-text="formatDate(item.createdAt)"></span>
      </p>
      <p
        class="mt-1.5 max-w-2xl text-[0.95rem] leading-relaxed text-[var(--color-ink)] sm:text-base"
        x-text="item.body"
      ></p>

      <template x-if="latestComment">
        <div class="mt-4 border-l-2 border-[var(--color-line)] pl-3">
          <p class="text-xs text-[var(--color-ink-subtle)]">
            <span class="font-medium text-[var(--color-ink-muted)]" x-text="latestComment.displayName"></span>
            <span aria-hidden="true"> · </span>
            <span x-text="formatDate(latestComment.createdAt)"></span>
          </p>
          <p
            class="mt-0.5 text-sm leading-relaxed text-[var(--color-ink-muted)]"
            x-text="latestComment.body"
          ></p>
        </div>
      </template>

      <p
        class="mt-3 text-xs text-[var(--color-ink-subtle)]"
        x-show="!latestComment"
        x-cloak
      >
        No comments yet.
      </p>

      <a
        class="mt-4 inline-flex text-sm font-medium text-[var(--color-primary)] underline-offset-2 hover:underline"
        href={`/${version}/prayer#wall`}
        data-astro-prefetch="tap"
      >
        <span x-show="commentCount > 1" x-cloak>
          View all · <span x-text="commentCount"></span> comments
        </span>
        <span x-show="commentCount <= 1">Open prayer wall</span>
      </a>
    </div>
  </template>
</section>
