---
import { getVersion, type VersionId } from "../lib/versions";

interface Props {
  version: VersionId;
}

const { version } = Astro.props;
const meta = getVersion(version);
---

<footer class="mt-12 border-t border-[var(--color-line)] pt-6 pb-2 sm:mt-14 sm:pt-8">
  <div class="flex flex-col gap-2 text-sm text-[var(--color-ink-subtle)] sm:flex-row sm:items-center sm:justify-between sm:gap-6">
    <p>
      <span class="font-medium text-[var(--color-ink-muted)]">{meta.label}</span>
      <span class="mx-1.5">·</span>
      Highlights &amp; notes stay on this device.
    </p>
  </div>
</footer>
