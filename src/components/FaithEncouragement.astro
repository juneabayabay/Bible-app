---
interface Props {
  booksHref?: string;
}

const { booksHref = "#books" } = Astro.props;

const sections = [
  {
    id: "word",
    title: "We need His Word",
    body: "Scripture feeds the heart when we feel empty. God speaks truth we can stand on.",
    verse: "Matthew 4:4",
    image: "/images/faith/word.jpg",
    alt: "An open Bible in soft morning light",
  },
  {
    id: "path",
    title: "We need His guidance",
    body: "We cannot see every turn ahead. His Word lights the next faithful step.",
    verse: "Psalm 119:105",
    image: "/images/faith/path.jpg",
    alt: "A quiet path through morning light",
  },
  {
    id: "presence",
    title: "We need His presence",
    body: "We were made for God. His peace meets us when we worry, and His love does not leave.",
    verse: "Matthew 11:28",
    image: "/images/faith/presence.jpg",
    alt: "Hands resting in quiet prayer",
  },
] as const;
---

<section
  id="why-god"
  class="scroll-mt-28 border-t border-[var(--color-line)] pt-10 sm:pt-12"
  aria-labelledby="faith-heading"
  data-faith-root
>
  <header class="faith-reveal max-w-2xl">
    <p class="eyebrow">Encouragement</p>
    <h2
      id="faith-heading"
      class="font-scripture mt-2 text-2xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-3xl"
    >
      Why we need God
    </h2>
    <p class="mt-2 text-base leading-relaxed text-[var(--color-ink-muted)]">
      Three simple reasons to open Scripture today.
    </p>
  </header>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
    {
      sections.map((section) => (
        <article class="faith-reveal ui-card overflow-hidden" aria-labelledby={`faith-${section.id}-title`}>
          <img
            src={section.image}
            alt={section.alt}
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          <div class="p-5">
            <h3
              id={`faith-${section.id}-title`}
              class="font-scripture text-xl font-semibold text-[var(--color-ink)]"
            >
              {section.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)]">
              {section.body}
            </p>
            <p class="mt-3 text-xs font-medium text-[var(--color-gold)]">{section.verse}</p>
          </div>
        </article>
      ))
    }
  </div>

  <div class="faith-reveal mt-8 text-center sm:mt-10">
    <a href={booksHref} class="btn-primary">
      Choose a book
    </a>
  </div>
</section>

<style>
  .faith-reveal {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faith-reveal {
      opacity: 0;
      transform: translateY(0.75rem);
      transition:
        opacity 0.6s ease,
        transform 0.6s ease;
    }

    .faith-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  function initFaithReveals() {
    const root = document.querySelector("[data-faith-root]");
    if (!root) return;
    const items = root.querySelectorAll(".faith-reveal");
    if (!items.length) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      items.forEach((el) => el.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -6% 0px", threshold: 0.1 },
    );

    items.forEach((el) => observer.observe(el));
  }

  initFaithReveals();
  document.addEventListener("astro:page-load", initFaithReveals);
</script>
