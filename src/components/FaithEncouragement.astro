---
interface Props {
  /** Deep-link into the books list on this page */
  booksHref?: string;
}

const { booksHref = "#books" } = Astro.props;

const sections = [
  {
    id: "word",
    eyebrow: "His Word",
    title: "We need God’s Word to live",
    body: "Food keeps the body alive. Scripture keeps the heart alive. When we feel empty, confused, or tired, God speaks through His Word — not as noise, but as truth we can stand on.",
    verse: "“Man shall not live by bread alone, but by every word that proceeds out of God’s mouth.”",
    cite: "Matthew 4:4",
    image: "/images/faith/word.jpg",
    alt: "An open Bible resting in soft morning light",
    imageFirst: true,
  },
  {
    id: "path",
    eyebrow: "His guidance",
    title: "We need God to show the way",
    body: "Life is a long path with turns we cannot see ahead. We need God because our own wisdom is limited. His Word is a lamp — not for the whole journey at once, but for the next faithful step.",
    verse: "“Your word is a lamp to my feet, and a light for my path.”",
    cite: "Psalm 119:105",
    image: "/images/faith/path.jpg",
    alt: "A quiet path through hills at sunrise",
    imageFirst: false,
  },
  {
    id: "presence",
    eyebrow: "His presence",
    title: "We need God close to us",
    body: "We were made for relationship with our Creator. Success, comfort, and plans are not enough. We need God’s presence — His peace when we worry, His mercy when we fail, and His love that does not leave.",
    verse: "“Come to me, all you who labor and are heavily burdened, and I will give you rest.”",
    cite: "Matthew 11:28",
    image: "/images/faith/presence.jpg",
    alt: "Hands open in quiet prayer in warm light",
    imageFirst: true,
  },
] as const;
---

<section
  id="why-god"
  class="faith-journey scroll-mt-28 border-t border-[var(--color-line)] pt-10 sm:pt-12 lg:pt-14"
  aria-labelledby="faith-heading"
  data-faith-root
>
  <header class="faith-reveal mx-auto max-w-3xl text-center lg:max-w-4xl">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-accent)]">
      Why we need God
    </p>
    <h2
      id="faith-heading"
      class="font-scripture mt-3 text-3xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-4xl lg:text-[2.75rem] lg:leading-tight"
    >
      Every day, we need Him
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-[var(--color-ink-muted)] sm:text-lg">
      This app is here to help you open Scripture — because we do not walk through life alone.
      We need God’s Word, guidance, and presence.
    </p>
  </header>

  <div class="mt-10 space-y-12 sm:mt-12 sm:space-y-16 lg:mt-14 lg:space-y-20">
    {
      sections.map((section) => (
        <article
          class="faith-reveal"
          aria-labelledby={`faith-${section.id}-title`}
        >
          <div class="grid items-center gap-6 md:grid-cols-2 md:gap-8 lg:gap-12 xl:gap-16">
            <figure
              class:list={[
                "relative -mx-4 overflow-hidden sm:-mx-6 lg:mx-0",
                section.imageFirst ? "md:order-1" : "md:order-2",
              ]}
            >
              <img
                src={section.image}
                alt={section.alt}
                width="1600"
                height="900"
                loading="lazy"
                decoding="async"
                class="aspect-[16/10] w-full object-cover sm:aspect-[16/9] md:aspect-[4/3] lg:aspect-[16/11] lg:rounded-sm"
              />
            </figure>

            <div
              class:list={[
                "min-w-0",
                section.imageFirst ? "md:order-2" : "md:order-1",
              ]}
            >
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-accent)]">
                {section.eyebrow}
              </p>
              <h3
                id={`faith-${section.id}-title`}
                class="font-scripture mt-2 text-2xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-3xl lg:text-[2rem] lg:leading-snug"
              >
                {section.title}
              </h3>
              <p class="mt-3 max-w-prose text-base leading-relaxed text-[var(--color-ink-muted)] sm:mt-4 sm:text-[1.05rem]">
                {section.body}
              </p>
              <blockquote class="font-scripture mt-5 max-w-prose border-l-2 border-[var(--color-accent)] pl-4 text-[1.05rem] leading-snug text-[var(--color-ink)] sm:mt-6 sm:text-xl sm:leading-snug">
                {section.verse}
              </blockquote>
              <p class="mt-2 text-sm text-[var(--color-ink-subtle)]">{section.cite}</p>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="faith-reveal mt-12 border-t border-[var(--color-line)] pt-10 text-center sm:mt-14 sm:pt-12 lg:mt-16 lg:pt-14">
    <h3 class="font-scripture text-2xl font-semibold tracking-tight text-[var(--color-ink)] sm:text-3xl">
      Start with one page today
    </h3>
    <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-[var(--color-ink-muted)]">
      You do not need to read everything at once. Open a book, read a chapter, and let God meet you there.
    </p>
    <a
      href={booksHref}
      class="mt-6 inline-flex min-h-11 items-center justify-center rounded-md bg-[var(--color-ink)] px-6 text-sm font-medium text-[var(--color-surface)] transition hover:opacity-90 sm:mt-8"
    >
      Browse the books
    </a>
  </div>
</section>

<style>
  .faith-reveal {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faith-reveal {
      opacity: 0;
      transform: translateY(1rem);
      transition:
        opacity 0.7s ease,
        transform 0.7s ease;
    }

    .faith-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  function initFaithReveals() {
    const root = document.querySelector("[data-faith-root]");
    if (!root) return;

    const items = root.querySelectorAll(".faith-reveal");
    if (!items.length) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      items.forEach((el) => el.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
    );

    items.forEach((el) => observer.observe(el));
  }

  initFaithReveals();
  document.addEventListener("astro:page-load", initFaithReveals);
</script>
