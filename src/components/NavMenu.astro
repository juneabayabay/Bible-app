---
import type { VersionId } from "../lib/versions";

interface Props {
  version: VersionId;
}

const { version } = Astro.props;

const links = [
  { href: `/${version}/`, path: "/", label: "Home" },
  { href: `/${version}/#books`, path: "/#books", label: "Books" },
  { href: `/${version}/devotionals`, path: "/devotionals", label: "Grow" },
  { href: `/${version}/plans`, path: "/plans", label: "Plans" },
  { href: `/${version}/journey`, path: "/journey", label: "Journey" },
  { href: "/saved", path: null, label: "Saved" },
];
---

<div class="relative" x-data="{ open: false }" @keydown.escape.window="open = false">
  <button
    type="button"
    class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-[var(--color-ink)] transition hover:bg-[var(--color-line)]/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-primary)] sm:h-9 sm:w-9"
    @click="open = !open"
    :aria-expanded="open.toString()"
    aria-haspopup="menu"
    aria-label="Open menu"
  >
    <svg
      class="h-5 w-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      aria-hidden="true"
      x-show="!open"
    >
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
    <svg
      class="h-5 w-5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      aria-hidden="true"
      x-show="open"
      x-cloak
    >
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>

  <div
    class="absolute right-0 z-50 mt-2 w-[min(16rem,calc(100vw-1.5rem))] overflow-hidden rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] py-1 shadow-lg"
    x-show="open"
    x-cloak
    @click.outside="open = false"
    role="menu"
  >
    {links.map((link) => (
      <a
        href={link.href}
        {...(link.path != null ? { "data-nav-version": link.path } : {})}
        class="block px-3.5 py-2.5 text-sm text-[var(--color-ink)] transition hover:bg-[var(--color-line)]"
        role="menuitem"
        data-astro-prefetch
        @click="open = false"
      >
        {link.label}
      </a>
    ))}
  </div>
</div>
