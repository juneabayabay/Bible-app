---
import Layout from "../../../layouts/Layout.astro";
import SearchBar from "../../../components/SearchBar.astro";
import { getBookCatalog, resolveVersionId } from "../../../lib/bible";
import { getBookStaticPaths } from "../../../lib/staticPaths";

export function getStaticPaths() {
  return getBookStaticPaths();
}

const version = resolveVersionId(Astro.params.version);
const bookSlug = Astro.params.book!;
const catalog = getBookCatalog(version);
const book = catalog.find((b) => b.slug === bookSlug);

if (!book) {
  return Astro.redirect(`/${version}/`);
}
---

<Layout title={book.name} version={version} width="wide">
  <SearchBar slot="header" version={version} />

  <div class="measure">
    <nav class="mb-5 text-sm" aria-label="Breadcrumb">
      <a
        class="text-[var(--color-ink-muted)] transition hover:text-[var(--color-ink)]"
        href={`/${version}/`}
        data-astro-prefetch
      >
        ← All books
      </a>
    </nav>

    <header class="border-b border-[var(--color-line)] pb-5">
      <p class="eyebrow">Book</p>
      <h1 class="font-scripture mt-1.5 text-2xl font-semibold tracking-tight sm:text-3xl">
        {book.name}
      </h1>
      <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
        {book.chapters.length} {book.chapters.length === 1 ? "chapter" : "chapters"}
      </p>
    </header>

    <h2 class="mt-8 text-sm font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-subtle)]">
      Chapters
    </h2>
    <ul class="mt-4 grid grid-cols-5 gap-2 sm:grid-cols-8 md:grid-cols-10">
      {book.chapters.map((chapter) => (
        <li>
          <a
            class="inline-flex h-11 w-full items-center justify-center rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] text-sm tabular-nums text-[var(--color-ink)] transition hover:border-[var(--color-primary)] hover:bg-[color-mix(in_srgb,var(--color-primary)_6%,var(--color-surface-elevated))] active:scale-[0.98] sm:h-10"
            href={`/${version}/chapter/${book.slug}/${chapter}`}
            data-astro-prefetch
          >
            {chapter}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
