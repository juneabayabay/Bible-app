---
import Layout from "../../../layouts/Layout.astro";
import SectionFocusChrome from "../../../components/SectionFocusChrome.astro";
import { resolveVersionId } from "../../../lib/bible";
import { getVersion } from "../../../lib/versions";
import { getVersionHomePaths } from "../../../lib/staticPaths";
import { getDevotionThemes } from "../../../lib/devotionals";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const themes = getDevotionThemes();
---

<Layout title={`Devotionals · ${meta.shortLabel}`} version={version} width="wide" focus showFooter={false}>
  <div class="page-stack" x-data="journeyPanel" x-init="refresh()">
    <SectionFocusChrome version={version} title="Devotionals" eyebrow="Themes">
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        Choose a theme — love, hope, grace, and more.
      </p>
      <p class="mt-2 text-sm text-[var(--color-ink-subtle)]">
        Progress: <span class="text-[var(--color-gold)]" x-text="devotionDone"></span> guided readings completed
      </p>
    </SectionFocusChrome>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        themes.map((theme) => (
          <a
            class="group flex flex-col overflow-hidden rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] transition hover:border-[var(--color-primary)]/45"
            href={`/${version}/devotionals/${theme.slug}`}
            data-astro-prefetch
          >
            <div class="relative aspect-[16/10] overflow-hidden bg-[var(--color-surface)]">
              <img
                src={theme.image}
                alt={theme.imageAlt}
                width="640"
                height="400"
                loading="lazy"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <div class="flex flex-1 flex-col p-4 sm:p-5">
              <h2 class="font-scripture text-xl font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-primary)]">
                {theme.title}
              </h2>
              <p class="mt-1.5 flex-1 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                {theme.summary}
              </p>
              <p class="mt-3 text-sm font-medium text-[var(--color-primary)]">
                {theme.relatedVerses.length} verses · {theme.entries.length}{" "}
                {theme.entries.length === 1 ? "reading" : "readings"} →
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
