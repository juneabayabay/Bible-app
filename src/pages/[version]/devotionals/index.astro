---
import Layout from "../../../layouts/Layout.astro";
import SearchBar from "../../../components/SearchBar.astro";
import { resolveVersionId } from "../../../lib/bible";
import { getVersion } from "../../../lib/versions";
import { getVersionHomePaths } from "../../../lib/staticPaths";
import { getDevotionThemes } from "../../../lib/devotionals";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const themes = getDevotionThemes();
---

<Layout title={`Devotionals · ${meta.shortLabel}`} version={version} width="wide" flushHero>
  <SearchBar slot="header" version={version} />

  <div class="space-y-10" x-data="journeyPanel" x-init="refresh()">
    <section
      class="relative left-1/2 w-screen max-w-[100vw] -translate-x-1/2 overflow-hidden"
      aria-labelledby="devotionals-heading"
    >
      <div class="absolute inset-0">
        <img
          src="/images/devotionals-hero.png"
          alt=""
          width="1920"
          height="1080"
          class="h-full min-h-[18rem] w-full object-cover object-[center_40%] sm:min-h-[22rem] lg:min-h-[24rem]"
          fetchpriority="high"
        />
        <div
          class="absolute inset-0 bg-gradient-to-b from-[#0b1a3a]/80 via-[#152238]/55 to-[var(--color-surface)]"
          aria-hidden="true"
        ></div>
      </div>

      <div class="relative mx-auto w-full max-w-6xl px-4 pb-10 pt-10 sm:px-6 sm:pb-12 sm:pt-14 lg:max-w-7xl lg:px-8">
        <p class="animate-soft-rise text-sm text-white/75">
          <a href={`/${version}/`} class="hover:text-white hover:underline" data-astro-prefetch>
            ← Home
          </a>
          <span class="mx-2 text-white/35">·</span>
          <a href={`/${version}/journey`} class="hover:text-white hover:underline" data-astro-prefetch>
            Journey
          </a>
        </p>

        <div class="animate-soft-rise mt-8 max-w-2xl" style="animation-delay: 60ms">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-gold-soft)]">
            Devotionals
          </p>
          <h1
            id="devotionals-heading"
            class="font-scripture mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl lg:text-[2.75rem] lg:leading-tight"
          >
            Themes for the heart
          </h1>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-white/88 sm:text-lg">
            Choose a theme—love, kindness, humility, grace, sacrifice, and more.
            Each theme has related verses you can pick, plus short guided readings.
          </p>
          <p class="mt-5 text-sm text-white/70">
            Progress: <span class="text-[var(--color-gold-soft)]" x-text="devotionDone"></span> guided readings completed
          </p>
        </div>
      </div>
    </section>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {themes.map((theme) => (
        <a
          class="ui-card group flex flex-col overflow-hidden p-0 transition hover:border-[var(--color-gold)]"
          href={`/${version}/devotionals/${theme.slug}`}
          data-astro-prefetch
        >
          <div class="relative aspect-[16/10] overflow-hidden bg-[var(--color-surface-elevated)]">
            <img
              src={theme.image}
              alt={theme.imageAlt}
              width="640"
              height="400"
              loading="lazy"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-[var(--color-surface)]/80 via-transparent to-transparent"
              aria-hidden="true"
            ></div>
          </div>
          <div class="flex flex-1 flex-col p-5 sm:p-6">
            <h2 class="font-scripture text-2xl font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-primary)]">
              {theme.title}
            </h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-ink-muted)]">
              {theme.summary}
            </p>
            <p class="mt-4 text-xs font-medium uppercase tracking-wide text-[var(--color-ink-subtle)]">
              {theme.focus}
            </p>
            <p class="mt-3 text-sm text-[var(--color-gold)]">
              {theme.relatedVerses.length} verses · {theme.entries.length}{" "}
              {theme.entries.length === 1 ? "reading" : "readings"} →
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
