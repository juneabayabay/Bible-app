---
import Layout from "../../../layouts/Layout.astro";
import SearchBar from "../../../components/SearchBar.astro";
import { resolveVersionId } from "../../../lib/bible";
import { getVersion } from "../../../lib/versions";
import { getVersionHomePaths } from "../../../lib/staticPaths";
import { getDevotionThemes } from "../../../lib/devotionals";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const themes = getDevotionThemes();
---

<Layout title={`Devotionals · ${meta.shortLabel}`} version={version} width="wide">
  <SearchBar slot="header" version={version} />

  <div class="space-y-10" x-data="journeyPanel" x-init="refresh()">
    <header class="max-w-2xl">
      <p class="text-sm text-[var(--color-ink-muted)]">
        <a href={`/${version}/`} class="hover:text-[var(--color-ink)] hover:underline" data-astro-prefetch>
          ← Home
        </a>
        <span class="mx-2 text-[var(--color-line)]">·</span>
        <a href={`/${version}/journey`} class="hover:text-[var(--color-ink)] hover:underline" data-astro-prefetch>
          Journey
        </a>
      </p>
      <p class="eyebrow mt-6">Devotionals</p>
      <h1 class="font-scripture mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
        Themes for the heart
      </h1>
      <p class="mt-3 text-base leading-relaxed text-[var(--color-ink-muted)]">
        Choose a theme—love, kindness, humility, grace, sacrifice, and more.
        Each path has short readings with Scripture, reflection, and prayer.
      </p>
      <p class="mt-4 text-sm text-[var(--color-ink-subtle)]">
        Progress: <span x-text="devotionDone"></span> completed
      </p>
    </header>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {themes.map((theme) => (
        <a
          class="ui-card group flex flex-col p-6 transition hover:border-[var(--color-gold)]"
          href={`/${version}/devotionals/${theme.slug}`}
          data-astro-prefetch
        >
          <h2 class="font-scripture text-2xl font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-primary)]">
            {theme.title}
          </h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-ink-muted)]">
            {theme.summary}
          </p>
          <p class="mt-4 text-xs font-medium uppercase tracking-wide text-[var(--color-ink-subtle)]">
            {theme.focus}
          </p>
          <p class="mt-3 text-sm text-[var(--color-gold)]">
            {theme.entries.length} {theme.entries.length === 1 ? "reading" : "readings"} →
          </p>
        </a>
      ))}
    </div>
  </div>
</Layout>
