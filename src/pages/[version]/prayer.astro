---
import Layout from "../../layouts/Layout.astro";
import SearchBar from "../../components/SearchBar.astro";
import { resolveVersionId } from "../../lib/bible";
import { getVersion } from "../../lib/versions";
import { getVersionHomePaths } from "../../lib/staticPaths";
import { isSupabaseConfigured } from "../../lib/supabase";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const wallLive = isSupabaseConfigured();
---

<Layout title={`Prayer · ${meta.shortLabel}`} version={version}>
  <SearchBar slot="header" version={version} />

  <div
    class="page-stack measure"
    x-data="prayerHub"
    data-wall-live={wallLive ? "true" : "false"}
  >
    <header class="border-b border-[var(--color-line)] pb-5">
      <p class="text-sm text-[var(--color-ink-muted)]">
        <a href={`/${version}/`} class="hover:underline" data-astro-prefetch>← Home</a>
      </p>
      <p class="eyebrow mt-5">Prayer</p>
      <h1 class="font-scripture mt-1.5 text-3xl font-semibold tracking-tight sm:text-4xl">
        Come as you are
      </h1>
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        Two spaces — choose one below.
      </p>
    </header>

    <!-- Clear choice: Public vs Private -->
    <div class="grid gap-3 sm:grid-cols-2" role="tablist" aria-label="Prayer spaces">
      <button
        type="button"
        role="tab"
        class="rounded-xl border p-4 text-left transition sm:min-h-[8.5rem] sm:p-5"
        :class="tab === 'wall'
          ? 'border-[var(--color-gold)] bg-[var(--color-highlight)]/50'
          : 'border-[var(--color-line)] bg-[var(--color-surface-elevated)] hover:border-[var(--color-gold)]/60'"
        :aria-selected="(tab === 'wall').toString()"
        @click="setTab('wall')"
      >
        <p class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-gold)]">
          Public
        </p>
        <p class="mt-1.5 font-scripture text-xl font-semibold text-[var(--color-ink)]">
          Prayer wall
        </p>
        <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-muted)]">
          Share a request. Others can read, react, and comment.
        </p>
      </button>

      <button
        type="button"
        role="tab"
        class="rounded-xl border p-4 text-left transition sm:min-h-[8.5rem] sm:p-5"
        :class="tab === 'journal'
          ? 'border-[var(--color-gold)] bg-[var(--color-highlight)]/50'
          : 'border-[var(--color-line)] bg-[var(--color-surface-elevated)] hover:border-[var(--color-gold)]/60'"
        :aria-selected="(tab === 'journal').toString()"
        @click="setTab('journal')"
      >
        <p class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-gold)]">
          Private
        </p>
        <p class="mt-1.5 font-scripture text-xl font-semibold text-[var(--color-ink)]">
          With the Lord
        </p>
        <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-muted)]">
          Your journal — only you and God. Stays on this device.
        </p>
      </button>
    </div>

    <!-- ========== PUBLIC WALL ========== -->
    <div x-show="tab === 'wall'" x-cloak class="space-y-8">
      <p
        class="rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-3.5 py-2.5 text-sm text-[var(--color-ink-muted)]"
        x-show="wallLive"
        x-cloak
      >
        Live wall — everyone with this app can read, react, and comment. Refreshes automatically.
      </p>
      <p
        class="rounded-xl border border-[var(--color-gold)]/50 bg-[var(--color-highlight)]/40 px-3.5 py-2.5 text-sm text-[var(--color-ink)]"
        x-show="!wallLive"
        x-cloak
      >
        <span class="font-semibold">Prayer wall isn’t shared yet.</span>
        Requests stay on this device for now. You can still write and pray here.
      </p>

      <!-- Section 1: Share -->
      <section aria-labelledby="share-heading" class="space-y-3">
        <div class="border-b border-[var(--color-line)] pb-2">
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-subtle)]">
            Step 1
          </p>
          <h2 id="share-heading" class="font-scripture mt-1 text-xl font-semibold text-[var(--color-ink)]">
            Share a request
          </h2>
          <p class="mt-1 text-sm text-[var(--color-ink-muted)]">
            Be kind. Don’t share phone numbers, addresses, or private details.
          </p>
        </div>

        <form class="space-y-3" @submit.prevent="submitRequest()">
          <input
            type="text"
            class="w-full rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-3.5 py-2.5 text-base text-[var(--color-ink)] outline-none ring-[var(--color-primary)] placeholder:text-[var(--color-ink-subtle)] focus:ring-2 sm:text-sm"
            placeholder="Name (or leave blank for Anonymous)"
            x-model="wallName"
            maxlength="40"
            aria-label="Display name"
          />
          <textarea
            class="w-full rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-3.5 py-3 text-base leading-relaxed text-[var(--color-ink)] outline-none ring-[var(--color-primary)] placeholder:text-[var(--color-ink-subtle)] focus:ring-2 sm:text-sm"
            rows="3"
            placeholder="What can we pray for?"
            x-model="wallBody"
            maxlength="500"
            required
            aria-label="Prayer request"
          ></textarea>
          <div class="flex flex-wrap items-center gap-3">
            <button
              type="submit"
              class="btn-primary !min-h-11 !px-5 text-sm"
              :disabled="wallBusy"
            >
              Share request
            </button>
            <p
              class="text-sm text-[var(--color-gold)]"
              x-show="wallStatus"
              x-text="wallStatus"
              x-cloak
            ></p>
          </div>
        </form>
      </section>

      <!-- Section 2: Feed -->
      <section aria-labelledby="feed-heading" class="space-y-4">
        <div class="flex flex-wrap items-end justify-between gap-2 border-b border-[var(--color-line)] pb-2">
          <div>
            <p class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-subtle)]">
              Step 2
            </p>
            <h2 id="feed-heading" class="font-scripture mt-1 text-xl font-semibold text-[var(--color-ink)]">
              Pray for others
            </h2>
            <p class="mt-1 text-sm text-[var(--color-ink-muted)]">
              React with Pray, Love, or Amen · open Comments to reply
            </p>
          </div>
          <p
            class="text-xs text-[var(--color-ink-subtle)]"
            x-show="wallItems.length > 0"
            x-cloak
          >
            <span x-text="wallItems.length"></span> request<span x-text="wallItems.length === 1 ? '' : 's'"></span>
          </p>
        </div>

        <p class="text-sm text-[var(--color-ink-subtle)]" x-show="wallLoading" x-cloak>
          Loading…
        </p>
        <p
          class="text-sm text-red-600 dark:text-red-400"
          x-show="wallError"
          x-text="wallError"
          x-cloak
        ></p>
        <p
          class="text-sm text-[var(--color-ink-subtle)]"
          x-show="!wallLoading && !wallError && wallItems.length === 0"
          x-cloak
        >
          No requests yet. Be the first in Step 1.
        </p>

        <ul class="divide-y divide-[var(--color-line)]" x-show="wallItems.length > 0" x-cloak>
          <template x-for="item in wallItems" :key="item.id">
            <li class="py-5 first:pt-1">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                    <p class="text-sm font-semibold text-[var(--color-ink)]" x-text="item.displayName"></p>
                    <p
                      class="text-xs text-[var(--color-ink-subtle)]"
                      x-text="formatDate(item.createdAt)"
                    ></p>
                  </div>
                  <p
                    class="mt-2 whitespace-pre-wrap break-words text-[0.95rem] leading-relaxed text-[var(--color-ink-muted)]"
                    x-text="item.body"
                  ></p>
                </div>
                <button
                  type="button"
                  class="shrink-0 min-h-11 px-2 text-sm text-[var(--color-ink-subtle)] transition hover:text-red-600 dark:hover:text-red-400"
                  x-show="isMine(item)"
                  x-cloak
                  @click="removeRequest(item.id)"
                >
                  Remove
                </button>
              </div>

              <div class="mt-3.5 flex flex-wrap items-center gap-2">
                <button
                  type="button"
                  class="inline-flex min-h-11 items-center gap-1.5 rounded-full px-3.5 text-sm transition"
                  :class="hasReaction(item, 'prayed')
                    ? 'bg-[var(--color-highlight)] text-[var(--color-ink)]'
                    : 'text-[var(--color-ink-muted)] hover:bg-[var(--color-line)]/50'"
                  :aria-pressed="hasReaction(item, 'prayed').toString()"
                  aria-label="Prayed"
                  title="Prayed"
                  :disabled="wallReactBusy"
                  @click="react(item.id, 'prayed')"
                >
                  <span aria-hidden="true">🙏</span>
                  <span
                    class="tabular-nums text-xs"
                    x-show="item.reactionCounts.prayed"
                    x-text="item.reactionCounts.prayed"
                    x-cloak
                  ></span>
                </button>
                <button
                  type="button"
                  class="inline-flex min-h-11 items-center gap-1.5 rounded-full px-3.5 text-sm transition"
                  :class="hasReaction(item, 'heart')
                    ? 'bg-[var(--color-highlight)] text-[var(--color-ink)]'
                    : 'text-[var(--color-ink-muted)] hover:bg-[var(--color-line)]/50'"
                  :aria-pressed="hasReaction(item, 'heart').toString()"
                  aria-label="With you"
                  title="With you"
                  :disabled="wallReactBusy"
                  @click="react(item.id, 'heart')"
                >
                  <span aria-hidden="true">❤️</span>
                  <span
                    class="tabular-nums text-xs"
                    x-show="item.reactionCounts.heart"
                    x-text="item.reactionCounts.heart"
                    x-cloak
                  ></span>
                </button>
                <button
                  type="button"
                  class="inline-flex min-h-11 items-center gap-1.5 rounded-full px-3.5 text-sm transition"
                  :class="hasReaction(item, 'amen')
                    ? 'bg-[var(--color-highlight)] text-[var(--color-ink)]'
                    : 'text-[var(--color-ink-muted)] hover:bg-[var(--color-line)]/50'"
                  :aria-pressed="hasReaction(item, 'amen').toString()"
                  aria-label="Amen"
                  title="Amen"
                  :disabled="wallReactBusy"
                  @click="react(item.id, 'amen')"
                >
                  <span aria-hidden="true">✨</span>
                  <span
                    class="tabular-nums text-xs"
                    x-show="item.reactionCounts.amen"
                    x-text="item.reactionCounts.amen"
                    x-cloak
                  ></span>
                </button>
                <button
                  type="button"
                  class="inline-flex min-h-11 items-center gap-1.5 rounded-full px-3.5 text-sm text-[var(--color-ink-muted)] transition hover:bg-[var(--color-line)]/50"
                  :class="item.commentsOpen ? 'bg-[var(--color-line)]/40 text-[var(--color-ink)]' : ''"
                  aria-label="Comments"
                  title="Comments"
                  @click="item.commentsOpen = !item.commentsOpen"
                >
                  <span aria-hidden="true">💬</span>
                  <span
                    class="tabular-nums text-xs"
                    x-show="item.comments.length"
                    x-text="item.comments.length"
                    x-cloak
                  ></span>
                </button>
              </div>

              <div class="mt-4 space-y-3" x-show="item.commentsOpen" x-cloak>
                <ul class="space-y-2.5" x-show="item.comments.length > 0">
                  <template x-for="c in item.comments" :key="c.id">
                    <li class="border-l-2 border-[var(--color-line)] pl-3">
                      <p class="text-xs font-medium text-[var(--color-ink)]" x-text="c.displayName"></p>
                      <p class="mt-0.5 text-sm break-words text-[var(--color-ink-muted)]" x-text="c.body"></p>
                    </li>
                  </template>
                </ul>
                <form class="space-y-2" @submit.prevent="submitComment(item)">
                  <input
                    type="text"
                    class="w-full min-h-11 rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-3.5 py-2.5 text-base text-[var(--color-ink)] outline-none ring-[var(--color-primary)] placeholder:text-[var(--color-ink-subtle)] focus:ring-2 sm:text-sm"
                    placeholder="Your name (optional)"
                    x-model="item.commentName"
                    maxlength="40"
                    aria-label="Comment display name"
                  />
                  <div class="flex flex-col gap-2 sm:flex-row">
                    <input
                      type="text"
                      class="min-h-11 min-w-0 flex-1 rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-3.5 py-2.5 text-base text-[var(--color-ink)] outline-none ring-[var(--color-primary)] placeholder:text-[var(--color-ink-subtle)] focus:ring-2 sm:rounded-full sm:text-sm"
                      placeholder="Write a short encouragement…"
                      x-model="item.commentDraft"
                      maxlength="280"
                      required
                      aria-label="Comment"
                    />
                    <button
                      type="submit"
                      class="btn-secondary !min-h-11 shrink-0 !rounded-xl !px-5 text-sm sm:!rounded-full"
                    >
                      Post
                    </button>
                  </div>
                </form>
              </div>
            </li>
          </template>
        </ul>
      </section>
    </div>

    <!-- ========== PRIVATE JOURNAL ========== -->
    <div x-show="tab === 'journal'" x-cloak class="space-y-8">
      <section aria-labelledby="write-heading" class="space-y-3">
        <div class="border-b border-[var(--color-line)] pb-2">
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-subtle)]">
            Private · this device only
          </p>
          <h2 id="write-heading" class="font-scripture mt-1 text-xl font-semibold text-[var(--color-ink)]">
            Write to the Lord
          </h2>
          <p class="mt-1 text-sm text-[var(--color-ink-muted)]">
            Honest communion — no one else can read this.
          </p>
        </div>

        <form class="space-y-3" @submit.prevent="addJournal()">
          <label class="block">
            <span class="text-xs font-semibold uppercase tracking-[0.08em] text-[var(--color-ink-subtle)]">
              Bringing to God
            </span>
            <input
              type="text"
              class="mt-1.5 w-full rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-3.5 py-2.5 text-base text-[var(--color-ink)] outline-none ring-[var(--color-primary)] placeholder:text-[var(--color-ink-subtle)] focus:ring-2"
              placeholder="A person, a burden, gratitude…"
              x-model="forWhom"
              maxlength="120"
              required
            />
          </label>
          <label class="block">
            <span class="text-xs font-semibold uppercase tracking-[0.08em] text-[var(--color-ink-subtle)]">
              Prayer
              <span class="font-normal normal-case tracking-normal">(optional)</span>
            </span>
            <textarea
              class="mt-1.5 w-full rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-3.5 py-3 text-base text-[var(--color-ink)] outline-none ring-[var(--color-primary)] placeholder:text-[var(--color-ink-subtle)] focus:ring-2 sm:text-sm"
              rows="4"
              placeholder="Speak honestly with Him…"
              x-model="note"
              maxlength="500"
            ></textarea>
          </label>
          <div class="flex flex-wrap items-center gap-2">
            <button type="submit" class="btn-primary !min-h-10 !px-5 text-sm">
              Save prayer
            </button>
            <p class="text-sm text-[var(--color-gold)]" x-show="status" x-text="status" x-cloak></p>
          </div>
        </form>
      </section>

      <section aria-labelledby="journal-list-heading" class="space-y-3">
        <div class="flex flex-wrap items-end justify-between gap-2 border-b border-[var(--color-line)] pb-2">
          <div>
            <p class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-subtle)]">
              Your list
            </p>
            <h2
              id="journal-list-heading"
              class="font-scripture mt-1 text-xl font-semibold text-[var(--color-ink)]"
            >
              Saved prayers
            </h2>
          </div>
          <button
            type="button"
            class="text-sm text-[var(--color-ink-muted)] transition hover:text-[var(--color-ink)]"
            x-show="items.length > 0"
            x-cloak
            @click="exportList()"
          >
            Export
          </button>
        </div>

        <p class="text-sm text-[var(--color-ink-subtle)]" x-show="items.length === 0" x-cloak>
          Nothing yet. Write when your heart is ready.
        </p>

        <ul class="divide-y divide-[var(--color-line)]" x-show="items.length > 0" x-cloak>
          <template x-for="item in items" :key="item.id">
            <li class="py-5 first:pt-1">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                  <p class="font-medium text-[var(--color-ink)]" x-text="item.forWhom"></p>
                  <p
                    class="mt-2 whitespace-pre-wrap text-sm leading-relaxed text-[var(--color-ink-muted)]"
                    x-show="item.note"
                    x-text="item.note"
                  ></p>
                  <p
                    class="mt-2 text-xs text-[var(--color-ink-subtle)]"
                    x-text="formatDate(item.createdAt)"
                  ></p>
                </div>
                <button
                  type="button"
                  class="min-h-11 shrink-0 rounded-lg px-3 text-sm text-[var(--color-ink-subtle)] transition hover:bg-[var(--color-line)]/50 hover:text-red-600 dark:hover:text-red-400"
                  @click="removeJournal(item.id)"
                >
                  Remove
                </button>
              </div>
            </li>
          </template>
        </ul>
      </section>
    </div>
  </div>
</Layout>
