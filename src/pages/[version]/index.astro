---
import Layout from "../../layouts/Layout.astro";
import SearchBar from "../../components/SearchBar.astro";
import { getBooks, resolveVersionId } from "../../lib/bible";
import { VERSION_IDS, getVersion } from "../../lib/versions";
import { isOldTestament } from "../../lib/books";

export function getStaticPaths() {
  return VERSION_IDS.map((version) => ({
    params: { version },
  }));
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const books = getBooks(version);
const otBooks = books.filter((b) => isOldTestament(b.slug));
const ntBooks = books.filter((b) => !isOldTestament(b.slug));
const todayLabel = new Date().toLocaleDateString("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
});
---

<Layout title={`Bible · ${meta.shortLabel}`} version={version}>
  <SearchBar slot="header" version={version} />

  <div class="space-y-10" x-data={`homeDashboard('${version}')`}>
    <!-- Intro -->
    <section>
      <p class="text-sm text-[var(--color-ink-subtle)]">{todayLabel}</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">Home</h1>
      <p class="mt-2 max-w-xl text-sm text-[var(--color-ink-muted)] sm:text-base">
        Read Scripture in {meta.shortLabel}. Search above, or start with today’s verse.
      </p>
    </section>

    <!-- Verse of the Day -->
    <section
      class="border-y border-[var(--color-line)] py-8"
      x-data={`dailyVerse('${version}')`}
      aria-labelledby="votd-heading"
    >
      <p id="votd-heading" class="text-xs font-semibold uppercase tracking-wider text-[var(--color-accent)]">
        Verse of the day
      </p>

      <p class="mt-4 text-sm text-[var(--color-ink-subtle)]" x-show="loading" x-cloak>Loading…</p>
      <p class="mt-4 text-sm text-red-600 dark:text-red-400" x-show="error" x-text="error" x-cloak></p>

      <div x-show="!loading && !error" x-cloak>
        <blockquote class="mt-4 text-xl leading-relaxed text-[var(--color-ink)] sm:text-2xl sm:leading-snug">
          <span x-text="text"></span>
        </blockquote>
        <p class="mt-4 text-sm font-medium text-[var(--color-ink-muted)]">
          <span x-text="ref ? `${ref.book} ${ref.chapter}:${ref.verse}` : ''"></span>
          <span class="text-[var(--color-ink-subtle)]"> · {meta.shortLabel}</span>
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            class="inline-flex min-h-10 items-center justify-center rounded-md bg-[var(--color-ink)] px-4 text-sm font-medium text-[var(--color-surface)] transition hover:opacity-90"
            :href="url"
          >
            Read chapter
          </a>
          <button
            type="button"
            class="inline-flex min-h-10 items-center justify-center rounded-md border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-4 text-sm text-[var(--color-ink)] transition hover:bg-[var(--color-line)]"
            @click="copy()"
          >
            Copy verse
          </button>
        </div>
      </div>
    </section>

    <!-- Quick actions -->
    <section aria-label="Quick actions">
      <div class="grid gap-3 sm:grid-cols-3">
        <a
          class="block rounded-md border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-4 py-4 transition hover:border-[var(--color-accent)]"
          href="#books"
        >
          <p class="text-sm font-semibold text-[var(--color-ink)]">Browse books</p>
          <p class="mt-1 text-xs text-[var(--color-ink-muted)]">Old &amp; New Testament</p>
        </a>

        <a
          class="block rounded-md border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-4 py-4 transition hover:border-[var(--color-accent)]"
          href="/saved"
        >
          <p class="text-sm font-semibold text-[var(--color-ink)]">Saved</p>
          <p class="mt-1 text-xs text-[var(--color-ink-muted)]">
            <span x-text="savedCount"></span> highlights &amp; notes
          </p>
        </a>

        <template x-if="continueUrl">
          <a
            class="block rounded-md border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-4 py-4 transition hover:border-[var(--color-accent)]"
            :href="continueUrl"
          >
            <p class="text-sm font-semibold text-[var(--color-ink)]">Continue reading</p>
            <p class="mt-1 text-xs capitalize text-[var(--color-ink-muted)]" x-text="continueLabel"></p>
          </a>
        </template>
        <template x-if="!continueUrl">
          <div class="block rounded-md border border-dashed border-[var(--color-line)] px-4 py-4">
            <p class="text-sm font-semibold text-[var(--color-ink-muted)]">Continue reading</p>
            <p class="mt-1 text-xs text-[var(--color-ink-subtle)]">Open any chapter to start</p>
          </div>
        </template>
      </div>
    </section>

    <!-- Books -->
    <section id="books" class="scroll-mt-28" x-data={`{ tab: '${otBooks.length ? "ot" : "nt"}' }`}>
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-lg font-medium sm:text-xl">Books</h2>
          <p class="mt-1 text-sm text-[var(--color-ink-muted)]">{meta.description}</p>
        </div>
        {(otBooks.length > 0 && ntBooks.length > 0) && (
          <div class="flex gap-1 rounded-md border border-[var(--color-line)] p-1" role="tablist">
            <button
              type="button"
              role="tab"
              class="rounded px-3 py-1.5 text-sm transition"
              :class="tab === 'ot' ? 'bg-[var(--color-ink)] text-[var(--color-surface)]' : 'text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]'"
              @click="tab = 'ot'"
              :aria-selected="tab === 'ot'"
            >
              Old Testament
            </button>
            <button
              type="button"
              role="tab"
              class="rounded px-3 py-1.5 text-sm transition"
              :class="tab === 'nt' ? 'bg-[var(--color-ink)] text-[var(--color-surface)]' : 'text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]'"
              @click="tab = 'nt'"
              :aria-selected="tab === 'nt'"
            >
              New Testament
            </button>
          </div>
        )}
      </div>

      <div class="mt-6" x-show="tab === 'ot'">
        {otBooks.length === 0 ? (
          <p class="text-sm text-[var(--color-ink-subtle)]">No Old Testament books in this edition.</p>
        ) : (
          <ul class="columns-2 gap-x-6 sm:columns-3 sm:gap-x-8">
            {otBooks.map((book) => (
              <li class="mb-1.5 break-inside-avoid">
                <a
                  class="inline-block py-0.5 text-sm text-[var(--color-ink)] underline-offset-2 transition hover:underline sm:text-base"
                  href={`/${version}/book/${book.slug}`}
                >
                  {book.name}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      {otBooks.length > 0 ? (
        <div class="mt-6" x-show="tab === 'nt'" x-cloak>
          {ntBooks.length === 0 ? (
            <p class="text-sm text-[var(--color-ink-subtle)]">No New Testament books in this edition.</p>
          ) : (
            <ul class="columns-2 gap-x-6 sm:columns-3 sm:gap-x-8">
              {ntBooks.map((book) => (
                <li class="mb-1.5 break-inside-avoid">
                  <a
                    class="inline-block py-0.5 text-sm text-[var(--color-ink)] underline-offset-2 transition hover:underline sm:text-base"
                    href={`/${version}/book/${book.slug}`}
                  >
                    {book.name}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ) : (
        <div class="mt-6" x-show="tab === 'nt'">
          <ul class="columns-2 gap-x-6 sm:columns-3 sm:gap-x-8">
            {ntBooks.map((book) => (
              <li class="mb-1.5 break-inside-avoid">
                <a
                  class="inline-block py-0.5 text-sm text-[var(--color-ink)] underline-offset-2 transition hover:underline sm:text-base"
                  href={`/${version}/book/${book.slug}`}
                >
                  {book.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>
  </div>
</Layout>
