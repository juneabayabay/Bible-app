---
import Layout from "../../layouts/Layout.astro";
import SearchBar from "../../components/SearchBar.astro";
import HomeHero from "../../components/HomeHero.astro";
import QuickActions from "../../components/QuickActions.astro";
import HomePaths from "../../components/HomePaths.astro";
import BookIndex from "../../components/BookIndex.astro";
import GiveBanner from "../../components/GiveBanner.astro";
import HomePrayerWall from "../../components/HomePrayerWall.astro";
import { getBookCatalog, resolveVersionId } from "../../lib/bible";
import { getVersion } from "../../lib/versions";
import { isOldTestament } from "../../lib/books";
import { resolveDailyVerse } from "../../lib/resolveDailyVerse";
import { getVersionHomePaths } from "../../lib/staticPaths";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const books = getBookCatalog(version);
const daily = resolveDailyVerse(version);

const otCount = books.filter((b) => isOldTestament(b.slug)).length;
const ntCount = books.length - otCount;
const showTabs = otCount > 0 && ntCount > 0;
const defaultTab = otCount > 0 ? "ot" : "nt";

const startHref =
  daily?.url ?? (books[0] ? `/${version}/book/${books[0].slug}` : "#books");
---

<Layout title={`Bible · ${meta.shortLabel}`} version={version} width="wide" flushHero>
  <SearchBar slot="header" version={version} />

  <div x-data={`homeDashboard('${version}')`}>
    <HomeHero
      headline="Open God’s Word today"
      subcopy="One quiet invitation: read a little, listen, and draw near to God."
      ctaHref={startHref}
      ctaLabel={daily ? "Read today’s chapter" : "Start reading"}
      booksHref="#books"
      verseText={daily?.text}
      verseCite={daily ? `${daily.book} ${daily.chapter}:${daily.verse} · ${meta.shortLabel}` : undefined}
      verseUrl={daily?.url}
    />

    <div class="page-stack mt-8 sm:mt-10">
      <QuickActions />
      <HomePrayerWall version={version} />
      <BookIndex
        version={version}
        books={books}
        defaultTab={defaultTab}
        showTabs={showTabs}
      />
      <GiveBanner version={version} />
      <HomePaths version={version} />
    </div>
  </div>
</Layout>
