---
import Layout from "../../layouts/Layout.astro";
import SearchBar from "../../components/SearchBar.astro";
import HomeHero from "../../components/HomeHero.astro";
import QuickActions from "../../components/QuickActions.astro";
import TodayChecklist from "../../components/TodayChecklist.astro";
import JourneyPreview from "../../components/JourneyPreview.astro";
import PlansPreview from "../../components/PlansPreview.astro";
import DevotionalsPreview from "../../components/DevotionalsPreview.astro";
import BookIndex from "../../components/BookIndex.astro";
import FaithEncouragement from "../../components/FaithEncouragement.astro";
import { getBookCatalog, resolveVersionId } from "../../lib/bible";
import { getVersion } from "../../lib/versions";
import { isOldTestament } from "../../lib/books";
import { resolveDailyVerse } from "../../lib/resolveDailyVerse";
import { getVersionHomePaths } from "../../lib/staticPaths";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const books = getBookCatalog(version);
const daily = resolveDailyVerse(version);

const otCount = books.filter((b) => isOldTestament(b.slug)).length;
const ntCount = books.length - otCount;
const showTabs = otCount > 0 && ntCount > 0;
const defaultTab = otCount > 0 ? "ot" : "nt";

const startHref = daily?.url ?? (books[0] ? `/${version}/book/${books[0].slug}` : "#books");
---

<Layout title={`Bible · ${meta.shortLabel}`} version={version} width="wide" flushHero>
  <SearchBar slot="header" version={version} />

  <!--
    Home flow:
    1) Hero
    2) Quick continue
    3) Today checklist + challenge
    4) Journey preview
    5) Plans
    6) Devotionals
    7) Books
    8) Encouragement
  -->
  <div x-data={`homeDashboard('${version}')`}>
    <HomeHero
      headline="Open God’s Word today"
      subcopy="One clear path: continue reading, finish Today’s steps, grow a little each day."
      ctaHref={startHref}
      ctaLabel={daily ? "Read today’s chapter" : "Start reading"}
      booksHref="#today"
      verseText={daily?.text}
      verseCite={daily ? `${daily.book} ${daily.chapter}:${daily.verse} · ${meta.shortLabel}` : undefined}
      verseUrl={daily?.url}
    />

    <div class="space-y-10 sm:space-y-12">
      <QuickActions />

      <TodayChecklist version={version} />

      <JourneyPreview version={version} />

      <PlansPreview version={version} />

      <DevotionalsPreview version={version} />

      <BookIndex
        version={version}
        books={books}
        defaultTab={defaultTab}
        showTabs={showTabs}
      />

      <FaithEncouragement booksHref="#books" />
    </div>
  </div>
</Layout>
