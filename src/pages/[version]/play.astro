---
import Layout from "../../layouts/Layout.astro";
import SearchBar from "../../components/SearchBar.astro";
import { resolveVersionId } from "../../lib/bible";
import { getVersion } from "../../lib/versions";
import { getVersionHomePaths } from "../../lib/staticPaths";
import { resolveDailyVerse } from "../../lib/resolveDailyVerse";
import { DIFFICULTIES } from "../../lib/verseGame";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const daily = resolveDailyVerse(version);
const payload = {
  version,
  verse: daily
    ? {
        text: daily.text,
        cite: `${daily.book} ${daily.chapter}:${daily.verse}`,
        url: daily.url,
      }
    : null,
  difficulties: DIFFICULTIES,
};
---

<Layout title={`Verse play · ${meta.shortLabel}`} version={version}>
  <SearchBar slot="header" version={version} />

  <script type="application/json" id="verse-game-payload" set:html={JSON.stringify(payload)} />

  <div class="page-stack measure" x-data="verseFillGame()" x-init="boot()">
    <header class="border-b border-[var(--color-line)] pb-5">
      <p class="text-sm text-[var(--color-ink-muted)]">
        <a href={`/${version}/`} class="hover:underline" data-astro-prefetch>← Home</a>
      </p>
      <p class="eyebrow mt-5">Play</p>
      <h1 class="font-scripture mt-1.5 text-3xl font-semibold tracking-tight sm:text-4xl">
        Fill the blank
      </h1>
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        Choose a challenge level, then lock in today’s verse.
      </p>
    </header>

    <p class="text-sm text-[var(--color-ink-muted)]" x-show="!verse" x-cloak>
      No verse available for this version today.
    </p>

    <div x-show="verse" x-cloak class="space-y-6">
      <!-- Choose difficulty -->
      <section x-show="phase === 'choose'" class="space-y-4">
        <p class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-subtle)]">
          Choose level
        </p>
        <div class="grid gap-3 sm:grid-cols-3">
          <template x-for="d in difficulties" :key="d.id">
            <button
              type="button"
              class="rounded-xl border p-4 text-left transition"
              :class="difficulty === d.id
                ? 'border-[var(--color-gold)] bg-[var(--color-highlight)]/50'
                : 'border-[var(--color-line)] bg-[var(--color-surface-elevated)] hover:border-[var(--color-gold)]/60'"
              @click="selectDifficulty(d.id)"
            >
              <p class="font-semibold text-[var(--color-ink)]" x-text="d.label"></p>
              <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-muted)]" x-text="d.blurb"></p>
            </button>
          </template>
        </div>
        <button
          type="button"
          class="btn-primary !min-h-10 !px-5 text-sm"
          :disabled="!difficulty"
          @click="begin()"
        >
          Continue
        </button>
      </section>

      <!-- Study -->
      <section x-show="phase === 'study'" class="space-y-4" x-cloak>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-subtle)]">
            Study · <span x-text="difficultyLabel"></span>
          </p>
          <p
            class="text-sm text-[var(--color-gold)]"
            x-show="studySecondsLeft > 0"
            x-cloak
          >
            Hides in <span x-text="studySecondsLeft"></span>s
          </p>
        </div>
        <blockquote class="font-scripture rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-5 sm:p-6">
          <p class="text-lg leading-relaxed text-[var(--color-ink)] sm:text-xl" x-text="verse.text"></p>
          <p class="mt-3 text-sm text-[var(--color-ink-muted)]" x-text="verse.cite"></p>
        </blockquote>
        <p class="text-sm text-[var(--color-ink-muted)]" x-text="studyHint"></p>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="btn-primary !min-h-10 !px-5 text-sm" @click="startPlay()">
            I’m ready
          </button>
          <button type="button" class="btn-secondary !min-h-10 !px-4 text-sm" @click="backToChoose()">
            Change level
          </button>
        </div>
      </section>

      <!-- Play -->
      <section x-show="phase === 'play'" class="space-y-5" x-cloak>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-subtle)]">
            Play · <span x-text="difficultyLabel"></span>
          </p>
          <p class="text-sm text-[var(--color-ink-muted)]">
            <span x-text="roundIndex + 1"></span> / <span x-text="rounds.length"></span>
            · <span x-text="score"></span> correct
          </p>
        </div>

        <p
          class="text-sm text-[var(--color-ink-muted)]"
          x-show="current.answers.length > 1"
          x-cloak
        >
          Fill blank <span x-text="activeBlank + 1"></span> of
          <span x-text="current.answers.length"></span>
        </p>

        <div class="font-scripture text-lg leading-relaxed text-[var(--color-ink)] sm:text-xl">
          <template x-for="(seg, i) in current.segments" :key="i">
            <span>
              <span x-show="seg.type === 'text'" x-text="seg.text"></span>
              <span
                x-show="seg.type === 'blank'"
                class="mx-0.5 inline-block min-w-[4.5rem] border-b-2 px-1 text-center font-semibold"
                :class="blankClass(seg)"
                x-text="blankDisplay(seg)"
              ></span>
            </span>
          </template>
        </div>
        <p class="text-sm text-[var(--color-ink-muted)]" x-text="verse.cite"></p>
        <p
          class="text-xs text-[var(--color-ink-subtle)]"
          x-show="firstLetterHint && !filled[activeBlank]"
          x-cloak
        >
          Hint: starts with “<span x-text="activeAnswer[0]"></span>”
        </p>

        <div class="flex flex-wrap gap-2">
          <template x-for="choice in availableChoices" :key="choice">
            <button
              type="button"
              class="inline-flex min-h-10 items-center rounded-full border px-4 text-sm font-medium transition disabled:cursor-default"
              :class="choiceClass(choice)"
              :disabled="Boolean(filled[activeBlank])"
              @click="pick(choice)"
              x-text="choice"
            ></button>
          </template>
        </div>

        <p
          class="text-sm font-medium"
          x-show="feedback"
          x-cloak
          :class="lastCorrect ? 'text-[var(--color-success)]' : 'text-[var(--color-ink-muted)]'"
          x-text="feedback"
        ></p>

        <button
          type="button"
          class="btn-primary !min-h-10 !px-5 text-sm"
          x-show="roundComplete"
          x-cloak
          @click="next()"
          x-text="roundIndex + 1 < rounds.length ? 'Next' : 'Finish'"
        ></button>
      </section>

      <!-- Done -->
      <section x-show="phase === 'done'" class="space-y-4" x-cloak>
        <p class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-gold)]">
          Verse locked in
        </p>
        <h2 class="font-scripture text-2xl font-semibold text-[var(--color-ink)]">
          Well done
        </h2>
        <p class="text-sm leading-relaxed text-[var(--color-ink-muted)]">
          <span x-text="difficultyLabel"></span>:
          <span x-text="score"></span> / <span x-text="totalBlanks"></span> first-try correct.
          Counts toward Grow for today.
        </p>
        <blockquote class="font-scripture border-l-2 border-[var(--color-gold)] pl-4">
          <p class="text-base leading-relaxed text-[var(--color-ink)]" x-text="verse.text"></p>
          <p class="mt-2 text-sm text-[var(--color-ink-muted)]" x-text="verse.cite"></p>
        </blockquote>
        <div class="flex flex-wrap gap-2">
          <a class="btn-primary !min-h-10 !px-5 text-sm" :href="verse.url" data-astro-prefetch>
            Read in chapter
          </a>
          <button type="button" class="btn-secondary !min-h-10 !px-5 text-sm" @click="replay()">
            Play again
          </button>
          <button type="button" class="btn-secondary !min-h-10 !px-5 text-sm" @click="backToChoose()">
            Change level
          </button>
        </div>
      </section>
    </div>
  </div>
</Layout>
