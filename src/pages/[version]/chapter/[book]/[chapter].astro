---
import Layout from "../../../../layouts/Layout.astro";
import SearchBar from "../../../../components/SearchBar.astro";
import { getBook, getChapter, resolveVersionId } from "../../../../lib/bible";
import { getCompareVersionId } from "../../../../lib/compare";
import { getVersion } from "../../../../lib/versions";
import { getChapterStaticPaths } from "../../../../lib/staticPaths";
import { getQuiz } from "../../../../lib/quizzes";

export function getStaticPaths() {
  return getChapterStaticPaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const bookSlug = Astro.params.book!;
const chapterNumber = Number(Astro.params.chapter);

const book = getBook(version, bookSlug);
if (!book) {
  return Astro.redirect(`/${version}/`);
}

const chapterIndex = book.chapters.findIndex((c) => c.number === chapterNumber);
if (chapterIndex < 0) {
  return Astro.redirect(`/${version}/book/${bookSlug}`);
}

const chapter = book.chapters[chapterIndex];
const verses = chapter.verses;
const bookName = book.name;
const prevChapter = chapterIndex > 0 ? book.chapters[chapterIndex - 1] : null;
const nextChapter =
  chapterIndex < book.chapters.length - 1
    ? book.chapters[chapterIndex + 1]
    : null;

const wordCount = verses.reduce(
  (sum, v) => sum + v.text.trim().split(/\s+/).filter(Boolean).length,
  0,
);
const minutes = Math.max(1, Math.ceil(wordCount / 200));

const compareVersion = getCompareVersionId(version);
const compareMeta = compareVersion ? getVersion(compareVersion) : null;
const compareChapter =
  compareVersion && compareVersion !== version
    ? getChapter(compareVersion, bookSlug, chapterNumber)
    : null;

const compareVerses =
  compareChapter?.verses?.length
    ? Object.fromEntries(compareChapter.verses.map((v) => [String(v.number), v.text]))
    : null;

const readerConfig = JSON.stringify({
  version,
  bookSlug,
  chapter: chapterNumber,
  bookName,
  versionLabel: meta.shortLabel,
  compareVersion: compareVerses ? compareVersion : null,
  compareLabel: compareVerses && compareMeta ? compareMeta.shortLabel : null,
  compareVerses,
});

const navBtn = "btn-secondary !min-h-11 flex-1 sm:flex-none";

const quiz = getQuiz(bookSlug, chapterNumber);
---

<Layout
  title={`${bookName} ${chapterNumber}`}
  version={version}
  width={compareVerses ? "wide" : "reading"}
>
  <SearchBar slot="header" version={version} />

  <div x-data={`chapterReader(${readerConfig})`}>
    <div
      class="fixed inset-x-0 top-0 z-50 h-0.5 bg-[var(--color-line)]"
      aria-hidden="true"
    >
      <div
        class="h-full bg-[var(--color-gold)] transition-[width] duration-150"
        :style="`width: ${progress}%`"
      ></div>
    </div>

    <nav class="mb-5 text-sm" aria-label="Breadcrumb">
      <a
        class="text-[var(--color-ink-muted)] transition hover:text-[var(--color-ink)]"
        href={`/${version}/book/${bookSlug}`}
        data-astro-prefetch
      >
        ← {bookName}
      </a>
    </nav>

    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div class="min-w-0">
        <h1 class="font-scripture text-2xl font-semibold tracking-tight sm:text-3xl">
          {bookName}
          <span class="text-[var(--color-ink-muted)]">{chapterNumber}</span>
        </h1>
        <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
          ~{minutes} min · {chapterIndex + 1}/{book.chapters.length} · {meta.shortLabel}
        </p>
        <p class="mt-2 text-sm text-[var(--color-ink-subtle)]" x-show="showTip" x-cloak>
          Tip: press and hold a verse for Highlight, Notes, Copy, and Copy link. Right‑click works on desktop.
          <button type="button" class="ml-1 font-medium text-[var(--color-primary)] underline" @click="dismissTip()">
            Got it
          </button>
        </p>
        <p class="mt-2 text-sm text-[var(--color-gold)]" x-show="actionStatus" x-text="actionStatus" x-cloak></p>
      </div>

      <div class="flex w-full flex-col gap-2 sm:w-auto">
        <div class="flex flex-wrap items-center gap-2">
          <div class="flex items-center gap-2" aria-label="Text size">
            <button type="button" class="btn-secondary !min-h-10 !px-3" @click="bump(-0.08)" aria-label="Smaller text">A−</button>
            <button type="button" class="btn-secondary !min-h-10 !px-3" @click="bump(0.08)" aria-label="Larger text">A+</button>
          </div>
          {compareVerses && (
            <button
              type="button"
              class="btn-secondary !min-h-10 !px-3"
              @click="toggleCompare()"
              :aria-pressed="showCompare.toString()"
            >
              <span x-text={`showCompare ? 'Hide ${compareMeta?.shortLabel}' : 'Compare ${compareMeta?.shortLabel}'`}></span>
            </button>
          )}
        </div>
        <div class="flex gap-2" aria-label="Chapter">
          {prevChapter ? (
            <a class={navBtn} href={`/${version}/chapter/${bookSlug}/${prevChapter.number}`} data-astro-prefetch>
              ← {prevChapter.number}
            </a>
          ) : null}
          {nextChapter ? (
            <a class={navBtn} href={`/${version}/chapter/${bookSlug}/${nextChapter.number}`} data-astro-prefetch>
              {nextChapter.number} →
            </a>
          ) : null}
        </div>
      </div>
    </div>

    <div
      class="mt-8 space-y-1 sm:mt-10"
      :class="showCompare && hasCompare() ? 'max-w-4xl' : 'max-w-prose'"
      :style="`font-size: ${fontScale}rem`"
    >
      {verses.map((verse) => (
        <div
          id={`v${verse.number}`}
          class="group scroll-mt-28 rounded-xl px-1.5 py-2.5 transition select-none sm:px-2 sm:py-2 [-webkit-touch-callout:none]"
          :class={`(flashVerse === ${verse.number} ? 'verse-flash ' : '') + (activeMenu === ${verse.number} ? 'ring-1 ring-[var(--color-line)] ' : '')`}
          :data-hl={`highlightColor(${verse.number}) || ''`}
          @touchstart.passive={`onPressStart(${verse.number}, $event)`}
          @touchmove.passive="onPressMove($event)"
          @touchend.passive="onPressEnd()"
          @touchcancel.passive="onPressEnd()"
          @mousedown={`if ($event.button === 0) onPressStart(${verse.number}, $event)`}
          @mousemove="onPressMove($event)"
          @mouseup="onPressEnd()"
          @mouseleave="onPressEnd()"
          @contextmenu={`onContextMenu(${verse.number}, $event)`}
        >
          <div class="flex gap-2.5 sm:gap-3">
            <button
              type="button"
              class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-sm font-semibold tabular-nums transition sm:mt-1 sm:h-auto sm:w-8 sm:justify-start"
              :class={`isHighlighted(${verse.number}) ? 'text-[var(--color-ink)]' : 'text-[var(--color-ink-subtle)] hover:bg-[var(--color-line)] hover:text-[var(--color-primary)]'`}
              :data-hl={`highlightColor(${verse.number}) || ''`}
              title="Verse actions"
              aria-label={`Actions for verse ${verse.number}`}
              aria-haspopup="menu"
              :aria-expanded={`(activeMenu === ${verse.number}).toString()`}
              @click.stop={`openMenu(${verse.number})`}
              @mousedown.stop
              @touchstart.stop.passive
            >
              <span class="relative">
                {verse.number}
                <span
                  class="absolute -right-1 -top-0.5 h-1.5 w-1.5 rounded-full bg-[var(--color-gold)]"
                  x-show={`noteText(${verse.number}).trim()`}
                  x-cloak
                  aria-hidden="true"
                ></span>
              </span>
            </button>
            <div class="min-w-0 flex-1">
              <div
                class="grid gap-3"
                :class="showCompare && compareText(${verse.number}) ? 'md:grid-cols-2 md:gap-5' : ''"
              >
                <div>
                  <p class="mb-1 hidden text-[0.65rem] font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-subtle)] md:block"
                    x-show="showCompare && compareText(${verse.number})"
                    x-cloak
                  >
                    {meta.shortLabel}
                  </p>
                  <p
                    class="font-scripture text-[1.125rem] leading-[1.8] text-[var(--color-ink)] sm:text-[1.2rem] sm:leading-[1.85]"
                    title="Press and hold for options"
                  >
                    {verse.text}
                  </p>
                </div>
                <div
                  class="border-t border-[var(--color-line)] pt-3 md:border-t-0 md:border-l md:pt-0 md:pl-5"
                  x-show={`showCompare && compareText(${verse.number})`}
                  x-cloak
                >
                  <p class="mb-1 text-[0.65rem] font-semibold uppercase tracking-[0.1em] text-[var(--color-gold)]">
                    {compareMeta?.shortLabel}
                  </p>
                  <p
                    class="font-scripture text-[1.05rem] leading-[1.75] text-[var(--color-ink)] sm:text-[1.1rem]"
                    x-text={`compareText(${verse.number})`}
                  ></p>
                </div>
              </div>

              <div
                class="mt-2.5 rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-2 shadow-sm"
                x-show={`activeMenu === ${verse.number}`}
                x-cloak
                @click.stop
                @mousedown.stop
                @touchstart.stop.passive
                @click.outside={`if (activeMenu === ${verse.number}) closeMenu()`}
                role="menu"
                aria-label={`Verse ${verse.number} actions`}
              >
                <div class="flex flex-wrap items-center gap-1.5" x-show="menuPanel === 'actions'">
                  <button
                    type="button"
                    class="inline-flex min-h-9 items-center rounded-lg border border-[var(--color-line)] px-2.5 text-xs font-medium text-[var(--color-ink-muted)] transition hover:text-[var(--color-ink)] sm:min-h-8"
                    role="menuitem"
                    @click={`copyVerseLink(${verse.number})`}
                  >
                    Copy link
                  </button>
                  <button
                    type="button"
                    class="inline-flex min-h-9 items-center rounded-lg border border-[var(--color-line)] px-2.5 text-xs font-medium text-[var(--color-ink-muted)] transition hover:text-[var(--color-ink)] sm:min-h-8"
                    role="menuitem"
                    @click={`copyVerse(${verse.number}, ${JSON.stringify(verse.text)})`}
                  >
                    Copy
                  </button>
                  <button
                    type="button"
                    class="inline-flex min-h-9 items-center rounded-lg border border-[var(--color-line)] px-2.5 text-xs font-medium text-[var(--color-ink-muted)] transition hover:text-[var(--color-ink)] sm:min-h-8"
                    role="menuitem"
                    @click={`openNotePanel(${verse.number})`}
                  >
                    Notes
                  </button>
                  <button
                    type="button"
                    class="inline-flex min-h-9 items-center gap-1.5 rounded-lg border border-[var(--color-line)] px-2.5 text-xs font-medium transition sm:min-h-8"
                    :class={`isHighlighted(${verse.number}) ? 'border-[var(--color-gold)] text-[var(--color-ink)]' : 'text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]'`}
                    role="menuitem"
                    @click={`showColors(${verse.number})`}
                  >
                    <span
                      class="hl-swatch !h-3.5 !w-3.5 !border"
                      :data-hl={`highlightColor(${verse.number}) || 'gold'`}
                      x-show={`isHighlighted(${verse.number})`}
                      aria-hidden="true"
                    ></span>
                    Highlight
                  </button>
                </div>

                <div x-show="menuPanel === 'colors'" x-cloak>
                  <div class="mb-2.5 flex items-center justify-between gap-2 px-0.5">
                    <p class="text-xs font-medium text-[var(--color-ink)]">Choose a color</p>
                    <button
                      type="button"
                      class="text-xs text-[var(--color-ink-subtle)] hover:text-[var(--color-ink)]"
                      @click="menuPanel = 'actions'"
                    >
                      Back
                    </button>
                  </div>
                  <div class="flex flex-wrap items-center gap-2.5">
                    <template x-for="color in highlightColors" :key="color.id">
                      <button
                        type="button"
                        class="hl-swatch"
                        :class={`highlightColor(${verse.number}) === color.id ? 'is-active' : ''`}
                        :data-hl="color.id"
                        :title="color.label"
                        :aria-label="`Highlight ${color.label}`"
                        :aria-pressed={`(highlightColor(${verse.number}) === color.id).toString()`}
                        @click.stop={`setHighlight(${verse.number}, color.id)`}
                      ></button>
                    </template>
                    <button
                      type="button"
                      class="inline-flex min-h-9 items-center rounded-lg border border-[var(--color-line)] px-2.5 text-xs font-medium text-[var(--color-ink-muted)] transition hover:text-[var(--color-ink)] sm:min-h-8"
                      @click.stop={`setHighlight(${verse.number}, null)`}
                      x-show={`isHighlighted(${verse.number})`}
                    >
                      Clear
                    </button>
                  </div>
                  <p class="mt-2.5 px-0.5 text-[0.7rem] text-[var(--color-ink-subtle)]">
                    Gold · Sage · Sky · Rose · Lilac
                  </p>
                </div>
              </div>

              <div class="mt-2" x-show={`openNote === ${verse.number}`} x-cloak @mousedown.stop @touchstart.stop.passive>
                <textarea
                  class="w-full rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-3 text-sm text-[var(--color-ink)] outline-none ring-[var(--color-primary)] placeholder:text-[var(--color-ink-subtle)] focus:ring-2"
                  rows="3"
                  placeholder="Write what God is speaking to you…"
                  x-bind:value={`noteText(${verse.number})`}
                  @input={`setNote(${verse.number}, $event.target.value)`}
                />
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    {quiz && (
      <section
        class="mt-10 border-t border-[var(--color-line)] pt-8"
        aria-labelledby="quiz-heading"
        x-data={`chapterQuiz('${bookSlug}', ${chapterNumber})`}
      >
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="eyebrow">Check understanding</p>
            <h2 id="quiz-heading" class="font-scripture mt-1 text-xl font-semibold sm:text-2xl">
              {quiz.title}
            </h2>
            <p class="mt-1 text-sm text-[var(--color-ink-muted)]">
              Soft questions—reveal answers when you’re ready. No score, just growth.
            </p>
          </div>
          <button type="button" class="btn-secondary !min-h-10 !px-4 text-sm" @click="toggle()">
            <span x-text="open ? 'Hide' : (done ? 'Review' : 'Start')"></span>
          </button>
        </div>

        <div class="mt-5 space-y-4" x-show="open" x-cloak>
          {quiz.questions.map((q, i) => (
            <div class="rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-4">
              <p class="font-medium text-[var(--color-ink)]">
                {i + 1}. {q.prompt}
              </p>
              <button
                type="button"
                class="mt-3 text-sm font-medium text-[var(--color-primary)] hover:underline"
                x-show={`!revealed[${i}]`}
                @click={`reveal(${i})`}
              >
                Reveal answer
              </button>
              <p
                class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]"
                x-show={`revealed[${i}]`}
                x-cloak
              >
                {q.answer}
              </p>
            </div>
          ))}
          <button
            type="button"
            class="btn-primary !min-h-10 !px-4 text-sm"
            x-show="!done"
            @click="finish()"
          >
            Mark quiz complete
          </button>
          <p class="text-sm text-[var(--color-success)]" x-show="done" x-cloak>
            Quiz complete — counted toward today’s Grow step.
          </p>
        </div>
      </section>
    )}

    <nav
      class="mt-8 flex items-center justify-between gap-3 border-t border-[var(--color-line)] pt-6 sm:mt-10"
      aria-label="Chapter footer"
    >
      {prevChapter ? (
        <a class={navBtn} href={`/${version}/chapter/${bookSlug}/${prevChapter.number}`} data-astro-prefetch>
          ← Previous
        </a>
      ) : (
        <span></span>
      )}
      <a
        class="hidden text-sm text-[var(--color-ink-muted)] hover:text-[var(--color-ink)] hover:underline sm:inline"
        href={`/${version}/book/${bookSlug}`}
        data-astro-prefetch
      >
        All chapters
      </a>
      {nextChapter ? (
        <a class={navBtn} href={`/${version}/chapter/${bookSlug}/${nextChapter.number}`} data-astro-prefetch>
          Next →
        </a>
      ) : (
        <span></span>
      )}
    </nav>
  </div>
</Layout>
