---
import Layout from "../../../../layouts/Layout.astro";
import SearchBar from "../../../../components/SearchBar.astro";
import { getBook, getChapter, resolveVersionId } from "../../../../lib/bible";
import { getCompareVersionId } from "../../../../lib/compare";
import { getVersion } from "../../../../lib/versions";
import { getChapterStaticPaths } from "../../../../lib/staticPaths";

export function getStaticPaths() {
  return getChapterStaticPaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const bookSlug = Astro.params.book!;
const chapterNumber = Number(Astro.params.chapter);

const book = getBook(version, bookSlug);
if (!book) {
  return Astro.redirect(`/${version}/`);
}

const chapterIndex = book.chapters.findIndex((c) => c.number === chapterNumber);
if (chapterIndex < 0) {
  return Astro.redirect(`/${version}/book/${bookSlug}`);
}

const chapter = book.chapters[chapterIndex];
const verses = chapter.verses;
const bookName = book.name;
const prevChapter = chapterIndex > 0 ? book.chapters[chapterIndex - 1] : null;
const nextChapter =
  chapterIndex < book.chapters.length - 1
    ? book.chapters[chapterIndex + 1]
    : null;

const wordCount = verses.reduce(
  (sum, v) => sum + v.text.trim().split(/\s+/).filter(Boolean).length,
  0,
);
const minutes = Math.max(1, Math.ceil(wordCount / 200));

const compareVersion = getCompareVersionId(version);
const compareMeta = compareVersion ? getVersion(compareVersion) : null;
const compareChapter =
  compareVersion && compareVersion !== version
    ? getChapter(compareVersion, bookSlug, chapterNumber)
    : null;

const compareVerses =
  compareChapter?.verses?.length
    ? Object.fromEntries(compareChapter.verses.map((v) => [String(v.number), v.text]))
    : null;

const readerConfig = JSON.stringify({
  version,
  bookSlug,
  chapter: chapterNumber,
  bookName,
  versionLabel: meta.shortLabel,
  compareVersion: compareVerses ? compareVersion : null,
  compareLabel: compareVerses && compareMeta ? compareMeta.shortLabel : null,
  compareVerses,
});

const navBtn = "btn-secondary !min-h-11 flex-1 sm:flex-none";
---

<Layout title={`${bookName} ${chapterNumber}`} version={version}>
  <SearchBar slot="header" version={version} />

  <div x-data={`chapterReader(${readerConfig})`}>
    <div
      class="fixed inset-x-0 top-0 z-50 h-0.5 bg-[var(--color-line)]"
      aria-hidden="true"
    >
      <div
        class="h-full bg-[var(--color-gold)] transition-[width] duration-150"
        :style="`width: ${progress}%`"
      ></div>
    </div>

    <nav class="mb-5 text-sm" aria-label="Breadcrumb">
      <a
        class="text-[var(--color-ink-muted)] transition hover:text-[var(--color-ink)]"
        href={`/${version}/book/${bookSlug}`}
        data-astro-prefetch
      >
        ← {bookName}
      </a>
    </nav>

    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div class="min-w-0">
        <h1 class="font-scripture text-2xl font-semibold tracking-tight sm:text-3xl">
          {bookName}
          <span class="text-[var(--color-ink-muted)]">{chapterNumber}</span>
        </h1>
        <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
          ~{minutes} min · {chapterIndex + 1}/{book.chapters.length} · {meta.shortLabel}
        </p>
        <p class="mt-2 text-sm text-[var(--color-ink-subtle)]" x-show="showTip" x-cloak>
          Tap a verse number to highlight. Use Share for a verse card.
          <button type="button" class="ml-1 font-medium text-[var(--color-primary)] underline" @click="dismissTip()">
            Got it
          </button>
        </p>
        <p class="mt-2 text-sm text-[var(--color-gold)]" x-show="shareStatus" x-text="shareStatus" x-cloak></p>
      </div>

      <div class="flex w-full flex-col gap-2 sm:w-auto">
        <div class="flex flex-wrap items-center gap-2">
          <div class="flex items-center gap-2" aria-label="Text size">
            <button type="button" class="btn-secondary !min-h-10 !px-3" @click="bump(-0.08)" aria-label="Smaller text">A−</button>
            <button type="button" class="btn-secondary !min-h-10 !px-3" @click="bump(0.08)" aria-label="Larger text">A+</button>
          </div>
          {compareVerses && (
            <button
              type="button"
              class="btn-secondary !min-h-10 !px-3"
              @click="toggleCompare()"
              :aria-pressed="showCompare.toString()"
            >
              <span x-text={`showCompare ? 'Hide ${compareMeta?.shortLabel}' : 'Compare ${compareMeta?.shortLabel}'`}></span>
            </button>
          )}
        </div>
        <div class="flex gap-2" aria-label="Chapter">
          {prevChapter ? (
            <a class={navBtn} href={`/${version}/chapter/${bookSlug}/${prevChapter.number}`} data-astro-prefetch>
              ← {prevChapter.number}
            </a>
          ) : null}
          {nextChapter ? (
            <a class={navBtn} href={`/${version}/chapter/${bookSlug}/${nextChapter.number}`} data-astro-prefetch>
              {nextChapter.number} →
            </a>
          ) : null}
        </div>
      </div>
    </div>

    <div
      class="mt-8 space-y-1 sm:mt-10"
      :class="showCompare && hasCompare() ? 'max-w-4xl' : 'max-w-prose'"
      :style="`font-size: ${fontScale}rem`"
    >
      {verses.map((verse) => (
        <div
          id={`v${verse.number}`}
          class="group scroll-mt-28 rounded-xl px-1.5 py-2.5 transition sm:px-2 sm:py-2"
          :class={`(isHighlighted(${verse.number}) ? 'bg-[var(--color-highlight)] ' : '') + (flashVerse === ${verse.number} ? 'verse-flash' : '')`}
        >
          <div class="flex gap-2.5 sm:gap-3">
            <button
              type="button"
              class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-sm font-semibold tabular-nums text-[var(--color-ink-subtle)] transition hover:bg-[var(--color-line)] hover:text-[var(--color-primary)] sm:mt-1 sm:h-auto sm:w-8 sm:justify-start"
              title="Toggle highlight"
              aria-label={`Highlight verse ${verse.number}`}
              @click={`toggleHighlight(${verse.number})`}
            >
              {verse.number}
            </button>
            <div class="min-w-0 flex-1">
              <div
                class="grid gap-3"
                :class="showCompare && compareText(${verse.number}) ? 'md:grid-cols-2 md:gap-5' : ''"
              >
                <div>
                  <p class="mb-1 hidden text-[0.65rem] font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-subtle)] md:block"
                    x-show="showCompare && compareText(${verse.number})"
                    x-cloak
                  >
                    {meta.shortLabel}
                  </p>
                  <p class="font-scripture text-[1.125rem] leading-[1.8] text-[var(--color-ink)] sm:text-[1.2rem] sm:leading-[1.85]">
                    {verse.text}
                  </p>
                </div>
                <div
                  class="border-t border-[var(--color-line)] pt-3 md:border-t-0 md:border-l md:pt-0 md:pl-5"
                  x-show={`showCompare && compareText(${verse.number})`}
                  x-cloak
                >
                  <p class="mb-1 text-[0.65rem] font-semibold uppercase tracking-[0.1em] text-[var(--color-gold)]">
                    {compareMeta?.shortLabel}
                  </p>
                  <p
                    class="font-scripture text-[1.05rem] leading-[1.75] text-[var(--color-ink-muted)] sm:text-[1.1rem]"
                    x-text={`compareText(${verse.number})`}
                  ></p>
                </div>
              </div>

              <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                <button
                  type="button"
                  class="min-h-9 text-xs font-medium text-[var(--color-ink-subtle)] transition hover:text-[var(--color-ink)] sm:min-h-8 sm:opacity-0 sm:group-hover:opacity-100 sm:focus:opacity-100 sm:group-focus-within:opacity-100"
                  :class={`noteText(${verse.number}).trim() || openNote === ${verse.number} ? 'sm:opacity-100' : ''`}
                  @click={`toggleNote(${verse.number})`}
                >
                  Note
                </button>
                <button
                  type="button"
                  class="min-h-9 text-xs font-medium text-[var(--color-ink-subtle)] transition hover:text-[var(--color-ink)] sm:min-h-8 sm:opacity-0 sm:group-hover:opacity-100 sm:focus:opacity-100 sm:group-focus-within:opacity-100"
                  @click={`copyVerse(${verse.number}, ${JSON.stringify(verse.text)})`}
                >
                  Copy
                </button>
                <button
                  type="button"
                  class="min-h-9 text-xs font-medium text-[var(--color-ink-subtle)] transition hover:text-[var(--color-ink)] sm:min-h-8 sm:opacity-0 sm:group-hover:opacity-100 sm:focus:opacity-100 sm:group-focus-within:opacity-100"
                  @click={`shareVerse(${verse.number}, ${JSON.stringify(verse.text)})`}
                >
                  Share card
                </button>
                <span
                  class="text-xs text-[var(--color-gold)]"
                  x-show={`noteText(${verse.number}).trim()`}
                  x-cloak
                >
                  Has note
                </span>
              </div>
              <div class="mt-2" x-show={`openNote === ${verse.number}`} x-cloak>
                <textarea
                  class="w-full rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-3 text-sm text-[var(--color-ink)] outline-none ring-[var(--color-primary)] placeholder:text-[var(--color-ink-subtle)] focus:ring-2"
                  rows="3"
                  placeholder="Write what God is speaking to you…"
                  x-bind:value={`noteText(${verse.number})`}
                  @input={`setNote(${verse.number}, $event.target.value)`}
                />
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <nav
      class="mt-8 flex items-center justify-between gap-3 border-t border-[var(--color-line)] pt-6 sm:mt-10"
      aria-label="Chapter footer"
    >
      {prevChapter ? (
        <a class={navBtn} href={`/${version}/chapter/${bookSlug}/${prevChapter.number}`} data-astro-prefetch>
          ← Previous
        </a>
      ) : (
        <span></span>
      )}
      <a
        class="hidden text-sm text-[var(--color-ink-muted)] hover:text-[var(--color-ink)] hover:underline sm:inline"
        href={`/${version}/book/${bookSlug}`}
        data-astro-prefetch
      >
        All chapters
      </a>
      {nextChapter ? (
        <a class={navBtn} href={`/${version}/chapter/${bookSlug}/${nextChapter.number}`} data-astro-prefetch>
          Next →
        </a>
      ) : (
        <span></span>
      )}
    </nav>
  </div>
</Layout>
