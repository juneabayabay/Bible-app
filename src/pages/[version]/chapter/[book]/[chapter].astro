---
import Layout from "../../../../layouts/Layout.astro";
import SearchBar from "../../../../components/SearchBar.astro";
import { getBook, resolveVersionId } from "../../../../lib/bible";
import { getChapterStaticPaths } from "../../../../lib/staticPaths";

export function getStaticPaths() {
  return getChapterStaticPaths();
}

const version = resolveVersionId(Astro.params.version);
const bookSlug = Astro.params.book!;
const chapterNumber = Number(Astro.params.chapter);

const book = getBook(version, bookSlug);
if (!book) {
  return Astro.redirect(`/${version}/`);
}

const chapterIndex = book.chapters.findIndex((c) => c.number === chapterNumber);
if (chapterIndex < 0) {
  return Astro.redirect(`/${version}/book/${bookSlug}`);
}

const chapter = book.chapters[chapterIndex];
const verses = chapter.verses;
const bookName = book.name;
const prevChapter = chapterIndex > 0 ? book.chapters[chapterIndex - 1] : null;
const nextChapter =
  chapterIndex < book.chapters.length - 1
    ? book.chapters[chapterIndex + 1]
    : null;

const safeBookName = JSON.stringify(bookName);
const navBtn =
  "inline-flex min-h-11 min-w-[2.75rem] flex-1 items-center justify-center rounded-md border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-3 text-sm text-[var(--color-ink)] transition hover:bg-[var(--color-line)] active:scale-[0.98] sm:flex-none sm:min-w-0";
---

<Layout title={`${bookName} ${chapterNumber}`} version={version}>
  <SearchBar slot="header" version={version} />

  <div x-data={`chapterReader('${version}', '${bookSlug}', ${chapterNumber}, ${safeBookName})`}>
    <nav class="mb-5 text-sm" aria-label="Breadcrumb">
      <a
        class="text-[var(--color-ink-muted)] transition hover:text-[var(--color-ink)]"
        href={`/${version}/book/${bookSlug}`}
        data-astro-prefetch
      >
        ← {bookName}
      </a>
    </nav>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="min-w-0">
        <h1 class="font-scripture text-2xl font-semibold tracking-tight sm:text-3xl">
          {bookName}
          <span class="text-[var(--color-ink-muted)]">{chapterNumber}</span>
        </h1>
        <p class="mt-2 text-sm text-[var(--color-ink-subtle)]" x-show="showTip" x-cloak>
          Tap a verse number to highlight.
          <button
            type="button"
            class="ml-1 underline hover:text-[var(--color-ink)]"
            @click="dismissTip()"
          >
            Got it
          </button>
        </p>
      </div>

      <div class="flex w-full gap-2 sm:w-auto" aria-label="Chapter">
        {prevChapter ? (
          <a class={navBtn} href={`/${version}/chapter/${bookSlug}/${prevChapter.number}`} data-astro-prefetch>
            ← {prevChapter.number}
          </a>
        ) : null}
        {nextChapter ? (
          <a class={navBtn} href={`/${version}/chapter/${bookSlug}/${nextChapter.number}`} data-astro-prefetch>
            {nextChapter.number} →
          </a>
        ) : null}
      </div>
    </div>

    <div class="mt-8 max-w-prose space-y-0.5 sm:mt-10">
      {verses.map((verse) => (
        <div
          id={`v${verse.number}`}
          class="group scroll-mt-28 rounded-md px-1.5 py-2.5 transition sm:px-2 sm:py-2"
          :class={`(isHighlighted(${verse.number}) ? 'bg-[var(--color-highlight)] ' : '') + (flashVerse === ${verse.number} ? 'verse-flash' : '')`}
        >
          <div class="flex gap-2.5 sm:gap-3">
            <button
              type="button"
              class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded text-sm font-semibold tabular-nums text-[var(--color-ink-subtle)] transition hover:bg-[var(--color-line)] hover:text-[var(--color-accent)] sm:mt-1 sm:h-auto sm:w-8 sm:justify-start"
              title="Toggle highlight"
              aria-label={`Highlight verse ${verse.number}`}
              @click={`toggleHighlight(${verse.number})`}
            >
              {verse.number}
            </button>
            <div class="min-w-0 flex-1">
              <p class="font-scripture text-[1.125rem] leading-[1.75] text-[var(--color-ink)] sm:text-[1.2rem] sm:leading-[1.8]">
                {verse.text}
              </p>
              <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                <button
                  type="button"
                  class="min-h-9 text-xs font-medium text-[var(--color-ink-subtle)] transition hover:text-[var(--color-ink)] sm:min-h-8 sm:opacity-0 sm:group-hover:opacity-100 sm:focus:opacity-100 sm:group-focus-within:opacity-100"
                  :class={`noteText(${verse.number}).trim() || openNote === ${verse.number} ? 'sm:opacity-100' : ''`}
                  @click={`toggleNote(${verse.number})`}
                >
                  Note
                </button>
                <button
                  type="button"
                  class="min-h-9 text-xs font-medium text-[var(--color-ink-subtle)] transition hover:text-[var(--color-ink)] sm:min-h-8 sm:opacity-0 sm:group-hover:opacity-100 sm:focus:opacity-100 sm:group-focus-within:opacity-100"
                  @click={`copyVerse(${verse.number}, ${JSON.stringify(verse.text)})`}
                >
                  Copy
                </button>
                <span
                  class="text-xs text-[var(--color-accent)]"
                  x-show={`noteText(${verse.number}).trim()`}
                  x-cloak
                >
                  Has note
                </span>
              </div>
              <div class="mt-2" x-show={`openNote === ${verse.number}`} x-cloak>
                <textarea
                  class="w-full rounded-md border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-3 text-sm text-[var(--color-ink)] outline-none ring-[var(--color-accent)] placeholder:text-[var(--color-ink-subtle)] focus:ring-2"
                  rows="3"
                  placeholder="Write a note for this verse…"
                  x-bind:value={`noteText(${verse.number})`}
                  @input={`setNote(${verse.number}, $event.target.value)`}
                />
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <nav
      class="mt-10 flex items-center justify-between gap-3 border-t border-[var(--color-line)] pt-6 sm:mt-12"
      aria-label="Chapter footer"
    >
      {prevChapter ? (
        <a class={navBtn} href={`/${version}/chapter/${bookSlug}/${prevChapter.number}`} data-astro-prefetch>
          ← Previous
        </a>
      ) : (
        <span></span>
      )}
      <a
        class="hidden text-sm text-[var(--color-ink-muted)] hover:text-[var(--color-ink)] hover:underline sm:inline"
        href={`/${version}/book/${bookSlug}`}
        data-astro-prefetch
      >
        All chapters
      </a>
      {nextChapter ? (
        <a class={navBtn} href={`/${version}/chapter/${bookSlug}/${nextChapter.number}`} data-astro-prefetch>
          Next →
        </a>
      ) : (
        <span></span>
      )}
    </nav>
  </div>
</Layout>
