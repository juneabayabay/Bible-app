---
import Layout from "../../layouts/Layout.astro";
import SearchBar from "../../components/SearchBar.astro";
import { resolveVersionId } from "../../lib/bible";
import { getVersion } from "../../lib/versions";
import { getVersionHomePaths } from "../../lib/staticPaths";
import { getGiveMethods, hasWalletNumbers, SUPPORT_WALLET } from "../../lib/support";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const walletReady = hasWalletNumbers();
const methods = getGiveMethods();
const accountName = SUPPORT_WALLET.accountName;
---

<Layout title={`Give · ${meta.shortLabel}`} version={version}>
  <SearchBar slot="header" version={version} />

  <div class="page-stack measure" x-data="givePage()">
    <header class="border-b border-[var(--color-line)] pb-6">
      <p class="text-sm text-[var(--color-ink-muted)]">
        <a href={`/${version}/`} class="hover:underline" data-astro-prefetch>← Home</a>
      </p>
      <h1 class="font-scripture mt-6 text-[1.75rem] font-semibold tracking-tight text-[var(--color-ink)] sm:text-3xl">
        Give
      </h1>
      <p class="mt-4 max-w-xl text-[0.9375rem] leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        If this app has helped you open Scripture a little more easily, you’re welcome to help with the
        small costs of keeping it online. There is no pressure — and nothing changes if you don’t give.
      </p>
      <p class="mt-3 max-w-xl text-[0.9375rem] leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        Gifts stay optional. They don’t unlock features, medals, or special access. This page simply
        shares where a gift can go, with honesty.
      </p>
    </header>

    <section class="space-y-3 pt-1" aria-labelledby="honest-heading">
      <h2
        id="honest-heading"
        class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-subtle)]"
      >
        In plain words
      </h2>
      <ul class="space-y-2.5 text-[0.9375rem] leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        <li class="flex gap-2.5">
          <span class="mt-[0.55rem] h-1 w-1 shrink-0 rounded-full bg-[var(--color-ink-subtle)]" aria-hidden="true"></span>
          <span>This is a personal project, built to help people read God’s Word.</span>
        </li>
        <li class="flex gap-2.5">
          <span class="mt-[0.55rem] h-1 w-1 shrink-0 rounded-full bg-[var(--color-ink-subtle)]" aria-hidden="true"></span>
          <span>Support helps with hosting, the domain, and shared tools like the prayer wall.</span>
        </li>
        <li class="flex gap-2.5">
          <span class="mt-[0.55rem] h-1 w-1 shrink-0 rounded-full bg-[var(--color-ink-subtle)]" aria-hidden="true"></span>
          <span>We won’t overpromise. A gift is a kindness, not a transaction.</span>
        </li>
      </ul>
    </section>

    {
      walletReady ? (
        <section class="space-y-5 border-t border-[var(--color-line)] pt-7" aria-labelledby="transfer-heading">
          <div>
            <h2
              id="transfer-heading"
              class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-subtle)]"
            >
              If you’d like to give
            </h2>
            <p class="mt-2 text-[0.9375rem] text-[var(--color-ink)] sm:text-base">
              Please send to <span class="font-medium">{accountName}</span>. Confirm the name in your
              wallet app before you send.
            </p>
          </div>

          <ul class="space-y-3">
            {methods.map((method) => (
              <li class="flex flex-col gap-3 rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:p-5">
                <div class="min-w-0">
                  <p class="text-xs font-medium uppercase tracking-[0.1em] text-[var(--color-ink-subtle)]">
                    {method.label}
                  </p>
                  <p
                    class="mt-1.5 font-mono text-xl font-semibold tracking-wide text-[var(--color-ink)] tabular-nums sm:text-[1.375rem]"
                    aria-label={`${method.label} number`}
                  >
                    {method.number}
                  </p>
                </div>
                <button
                  type="button"
                  class="btn-primary !min-h-11 shrink-0 !px-5 text-sm sm:self-center"
                  @click={`copyNumber('${method.number}', '${method.id}')`}
                >
                  <span x-show={`copiedId !== '${method.id}'`}>Copy number</span>
                  <span x-show={`copiedId === '${method.id}'`} x-cloak>
                    Copied
                  </span>
                </button>
              </li>
            ))}
          </ul>

          <p class="text-sm leading-relaxed text-[var(--color-ink-subtle)]">
            Use your own GCash or GoTyme app to finish the transfer. No payment is taken on this website.
          </p>
        </section>
      ) : (
        <p class="border-t border-[var(--color-line)] pt-7 text-[0.9375rem] text-[var(--color-ink-muted)]">
          Transfer details will appear here when they’re ready.
        </p>
      )
    }

    <p class="border-t border-[var(--color-line)] pt-7 text-[0.9375rem] leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
      Whether you give, share a kind word, or simply keep reading — thank you for being here.
      <a
        class="ml-1 text-[var(--color-ink)] underline-offset-2 hover:underline"
        href={`/${version}/feedback`}
        data-astro-prefetch
      >
        Feedback is welcome too
      </a>.
    </p>
  </div>
</Layout>
