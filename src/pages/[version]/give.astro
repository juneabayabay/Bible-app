---
import Layout from "../../layouts/Layout.astro";
import SearchBar from "../../components/SearchBar.astro";
import { resolveVersionId } from "../../lib/bible";
import { getVersion } from "../../lib/versions";
import { getVersionHomePaths } from "../../lib/staticPaths";
import { getGiveMethods, hasWalletNumbers, SUPPORT_WALLET } from "../../lib/support";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const walletReady = hasWalletNumbers();
const methods = getGiveMethods();
const accountName = SUPPORT_WALLET.accountName;
---

<Layout title={`Give · ${meta.shortLabel}`} version={version}>
  <SearchBar slot="header" version={version} />

  <div class="page-stack measure" x-data="givePage()">
    <header class="border-b border-[var(--color-line)] pb-6">
      <p class="text-sm text-[var(--color-ink-muted)]">
        <a href={`/${version}/`} class="hover:underline" data-astro-prefetch>← Home</a>
      </p>
      <h1 class="font-scripture mt-6 text-[1.75rem] font-semibold tracking-tight text-[var(--color-ink)] sm:text-3xl">
        Give
      </h1>
      <p class="mt-3 max-w-lg text-[0.9375rem] leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        This app is free. If it has helped you, you may send a gift to help keep it online.
        Optional — nothing changes if you don’t.
      </p>
    </header>

    {
      walletReady ? (
        <section class="space-y-5" aria-labelledby="transfer-heading">
          <div>
            <h2
              id="transfer-heading"
              class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-subtle)]"
            >
              How to give
            </h2>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-[var(--color-ink)] sm:text-base">
              Send to <span class="font-medium">{accountName}</span> via GCash or GoTyme.
              Please check the name before you send.
            </p>
          </div>

          <ul class="space-y-3">
            {methods.map((method) => (
              <li class="flex flex-col gap-3 rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:p-5">
                <div class="min-w-0">
                  <p class="text-xs font-medium uppercase tracking-[0.1em] text-[var(--color-ink-subtle)]">
                    {method.label}
                  </p>
                  <p
                    class="mt-1.5 font-mono text-xl font-semibold tracking-wide text-[var(--color-ink)] tabular-nums sm:text-[1.375rem]"
                    aria-label={`${method.label} number`}
                  >
                    {method.number}
                  </p>
                </div>
                <button
                  type="button"
                  class="btn-primary !min-h-11 shrink-0 touch-manipulation !px-5 text-sm sm:self-center"
                  @click={`copyNumber('${method.number}', '${method.id}')`}
                >
                  <span x-show={`copiedId !== '${method.id}'`}>Copy number</span>
                  <span x-show={`copiedId === '${method.id}'`} x-cloak>
                    Copied
                  </span>
                </button>
              </li>
            ))}
          </ul>

          <p class="text-sm leading-relaxed text-[var(--color-ink-subtle)]">
            Copy the number, then send from your wallet app. No payment happens on this site.
          </p>
        </section>
      ) : (
        <p class="text-[0.9375rem] text-[var(--color-ink-muted)]">
          Giving details will appear here soon.
        </p>
      )
    }

    <section class="border-t border-[var(--color-line)] pt-7" aria-labelledby="covers-heading">
      <h2
        id="covers-heading"
        class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-subtle)]"
      >
        Where your gift goes
      </h2>
      <p class="mt-2 max-w-lg text-[0.9375rem] leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        We keep this simple and honest. Gifts help with real costs so Scripture can stay free for anyone to open.
      </p>
      <ul class="mt-5 space-y-4">
        <li>
          <p class="text-[0.9375rem] font-medium text-[var(--color-ink)] sm:text-base">
            Maintaining the website
          </p>
          <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-[0.9375rem]">
            So the site stays online, updated, and easy for anyone to open and read the Bible freely.
          </p>
        </li>
        <li>
          <p class="text-[0.9375rem] font-medium text-[var(--color-ink)] sm:text-base">
            Hosting and domain
          </p>
          <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-[0.9375rem]">
            The yearly cost of keeping the app’s address and servers running.
          </p>
        </li>
        <li>
          <p class="text-[0.9375rem] font-medium text-[var(--color-ink)] sm:text-base">
            Shared features
          </p>
          <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-[0.9375rem]">
            Tools like the prayer wall that need a small database to work for everyone.
          </p>
        </li>
        <li>
          <p class="text-[0.9375rem] font-medium text-[var(--color-ink)] sm:text-base">
            Google Play listing
          </p>
          <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-[0.9375rem]">
            Fees and costs if we publish the app on Google Play so more people can find it easily.
          </p>
        </li>
      </ul>
      <p class="mt-5 text-sm leading-relaxed text-[var(--color-ink-subtle)]">
        No gift unlocks special features. Reading stays free for all.
      </p>
    </section>

    <p class="border-t border-[var(--color-line)] pt-7 text-[0.9375rem] leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
      Thank you for reading here.
      <a
        class="ml-1 text-[var(--color-ink)] underline-offset-2 hover:underline"
        href={`/${version}/feedback`}
        data-astro-prefetch
      >
        Send feedback
      </a>
      if you’d like.
    </p>
  </div>
</Layout>
