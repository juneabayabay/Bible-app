---
import Layout from "../../layouts/Layout.astro";
import SectionFocusChrome from "../../components/SectionFocusChrome.astro";
import { resolveVersionId } from "../../lib/bible";
import { getVersion } from "../../lib/versions";
import { getVersionHomePaths } from "../../lib/staticPaths";
import { getGiveMethods, hasWalletNumbers, SUPPORT_WALLET } from "../../lib/support";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const walletReady = hasWalletNumbers();
const methods = getGiveMethods();
const accountName = SUPPORT_WALLET.accountName;
---

<Layout title={`Give · ${meta.shortLabel}`} version={version} focus showFooter={false}>
  <div class="page-stack measure" x-data="givePage()">
    <SectionFocusChrome version={version} title="Give" eyebrow="Support">
      <p class="mt-2 max-w-xl text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        Optional — help keep this Bible free for others. No pressure.
      </p>
    </SectionFocusChrome>

    <section class="space-y-3" aria-labelledby="why-heading">
      <h2
        id="why-heading"
        class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-subtle)]"
      >
        A gentle word
      </h2>
      <p class="max-w-xl text-[0.9375rem] leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        This is a personal labor of love — made so people can open Scripture with peace, wherever they are.
        A gift is not payment for features. It is simply kindness that helps the lights stay on.
      </p>
    </section>

    {
      walletReady ? (
        <section class="space-y-5 border-t border-[var(--color-line)] pt-7" aria-labelledby="transfer-heading">
          <div>
            <h2
              id="transfer-heading"
              class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-subtle)]"
            >
              If you’d like to give
            </h2>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-[var(--color-ink)] sm:text-base">
              Send any amount to <span class="font-medium">{accountName}</span> through GCash or GoTyme.
              Please confirm the name in your app before you send.
            </p>
          </div>

          <ul class="space-y-3">
            {methods.map((method) => (
              <li class="flex flex-col gap-3 rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:p-5">
                <div class="min-w-0">
                  <p class="text-xs font-medium uppercase tracking-[0.1em] text-[var(--color-ink-subtle)]">
                    {method.label}
                  </p>
                  <p
                    class="mt-1.5 font-mono text-xl font-semibold tracking-wide text-[var(--color-ink)] tabular-nums sm:text-[1.375rem]"
                    aria-label={`${method.label} number`}
                  >
                    {method.number}
                  </p>
                </div>
                <button
                  type="button"
                  class="btn-primary !min-h-11 shrink-0 touch-manipulation !px-5 text-sm sm:self-center"
                  @click={`copyNumber('${method.number}', '${method.id}')`}
                >
                  <span x-show={`copiedId !== '${method.id}'`}>Copy number</span>
                  <span x-show={`copiedId === '${method.id}'`} x-cloak>
                    Copied
                  </span>
                </button>
              </li>
            ))}
          </ul>

          <p class="text-sm leading-relaxed text-[var(--color-ink-subtle)]">
            Copy a number, then finish in your wallet app. No money is taken on this website.
          </p>
        </section>
      ) : (
        <p class="border-t border-[var(--color-line)] pt-7 text-[0.9375rem] text-[var(--color-ink-muted)]">
          Giving details will appear here soon.
        </p>
      )
    }

    <section class="border-t border-[var(--color-line)] pt-7" aria-labelledby="covers-heading">
      <h2
        id="covers-heading"
        class="text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-ink-subtle)]"
      >
        Where your gift goes
      </h2>
      <p class="mt-2 max-w-xl text-[0.9375rem] leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        We want to be clear with you. Every gift helps with real needs — so the Bible can stay free to open
        for anyone who needs it.
      </p>
      <ul class="mt-5 space-y-4">
        <li>
          <p class="text-[0.9375rem] font-medium text-[var(--color-ink)] sm:text-base">
            Keeping the site alive
          </p>
          <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-[0.9375rem]">
            Day-to-day care so the website stays online, clear, and ready whenever someone wants to read.
          </p>
        </li>
        <li>
          <p class="text-[0.9375rem] font-medium text-[var(--color-ink)] sm:text-base">
            Hosting and domain
          </p>
          <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-[0.9375rem]">
            The yearly cost of the web address and the space that holds this app.
          </p>
        </li>
        <li>
          <p class="text-[0.9375rem] font-medium text-[var(--color-ink)] sm:text-base">
            Shared tools
          </p>
          <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-[0.9375rem]">
            Things like the prayer wall, which need a small database so people can encourage one another.
          </p>
        </li>
        <li>
          <p class="text-[0.9375rem] font-medium text-[var(--color-ink)] sm:text-base">
            Reaching more readers
          </p>
          <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-[0.9375rem]">
            Costs toward listing on Google Play, so more people can find a quiet place to open Scripture.
          </p>
        </li>
      </ul>
      <p class="mt-5 text-sm leading-relaxed text-[var(--color-ink-subtle)]">
        A gift never unlocks special access. Reading stays free for all — today and always.
      </p>
    </section>

    <p class="border-t border-[var(--color-line)] pt-7 text-[0.9375rem] leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
      Whether you give, leave a kind word, or simply keep reading — thank you for being here.
      Your presence already matters.
      <a
        class="ml-1 text-[var(--color-ink)] underline-offset-2 hover:underline"
        href={`/${version}/feedback`}
        data-astro-prefetch
      >
        Send feedback
      </a>
      anytime.
    </p>
  </div>
</Layout>
