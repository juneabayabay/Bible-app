---
import Layout from "../../../layouts/Layout.astro";
import SectionFocusChrome from "../../../components/SectionFocusChrome.astro";
import { resolveVersionId } from "../../../lib/bible";
import { getVersion, VERSION_IDS } from "../../../lib/versions";
import { getPlan, getPlans } from "../../../lib/plans";

export function getStaticPaths() {
  return VERSION_IDS.flatMap((version) =>
    getPlans().map((plan) => ({
      params: { version, plan: plan.id },
    })),
  );
}

const version = resolveVersionId(Astro.params.version);
const planId = Astro.params.plan!;
const meta = getVersion(version);
const plan = getPlan(planId);

if (!plan) {
  return Astro.redirect(`/${version}/plans`);
}
---

<Layout title={`${plan.title} · Plans`} version={version} focus showFooter={false}>
  <div
    class="space-y-8"
    x-data={`planDetail('${version}', '${plan.id}', ${plan.days.length})`}
    x-init="refresh()"
  >
    <SectionFocusChrome version={version} title={plan.title} eyebrow="Plan">
      <p class="mt-2 max-w-2xl text-sm text-[var(--color-ink-muted)] sm:text-base">{plan.summary}</p>
    </SectionFocusChrome>

    <div class="overflow-hidden rounded-2xl border border-[var(--color-line)]">
      <img
        src={plan.image}
        alt={plan.imageAlt}
        width="1200"
        height="675"
        class="aspect-[21/9] w-full object-cover sm:aspect-[2.4/1]"
        fetchpriority="high"
      />
    </div>

    <div>
      <div class="flex flex-wrap items-center gap-3">
        <button
          type="button"
          class="btn-primary !min-h-10 !px-4 text-sm"
          @click="startPlan()"
          x-show="!isActive"
        >
          Start this plan
        </button>
        <span class="text-sm font-medium text-[var(--color-gold)]" x-show="isActive" x-cloak>
          Active · <span x-text="doneCount"></span> / {plan.days.length} days
        </span>
        <a
          class="btn-secondary !min-h-10 !px-4 text-sm"
          x-show="nextUrl"
          x-cloak
          :href="nextUrl"
          data-astro-prefetch
        >
          Continue: <span x-text="nextLabel"></span>
        </a>
      </div>
      <div class="mt-4 h-2 overflow-hidden rounded-full bg-[var(--color-line)]">
        <div
          class="h-full rounded-full bg-[var(--color-primary)] transition-all"
          :style={`\`width: \${Math.round((doneCount / ${plan.days.length}) * 100)}%\``}
        ></div>
      </div>
    </div>

    <ol class="space-y-2">
      {
        plan.days.map((day) => (
          <li
            class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] px-4 py-3"
            :class={`doneSet.includes(${day.day}) ? 'border-[var(--color-gold)]' : ''`}
          >
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-ink-subtle)]">
                Day {day.day}
              </p>
              <p class="font-medium text-[var(--color-ink)]">{day.label}</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <a
                class="btn-secondary !min-h-9 !px-3 text-sm"
                href={`/${version}/chapter/${day.slug}/${day.chapter}`}
                data-astro-prefetch
                @click={`markDay(${day.day})`}
              >
                Read
              </a>
              <button
                type="button"
                class="btn-secondary !min-h-9 !px-3 text-sm"
                x-show={`!doneSet.includes(${day.day})`}
                @click={`markDay(${day.day})`}
              >
                Mark done
              </button>
              <span
                class="inline-flex min-h-9 items-center text-sm text-[var(--color-success)]"
                x-show={`doneSet.includes(${day.day})`}
                x-cloak
              >
                Done
              </span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Layout>
