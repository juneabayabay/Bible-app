---
import Layout from "../../../layouts/Layout.astro";
import SearchBar from "../../../components/SearchBar.astro";
import { resolveVersionId } from "../../../lib/bible";
import { getVersion } from "../../../lib/versions";
import { getVersionHomePaths } from "../../../lib/staticPaths";
import { getPlans } from "../../../lib/plans";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const plans = getPlans();
---

<Layout title={`Plans · ${meta.shortLabel}`} version={version} width="wide">
  <SearchBar slot="header" version={version} />

  <div class="space-y-10" x-data="plansPanel" x-init="refresh()">
    <header class="max-w-2xl">
      <p class="text-sm text-[var(--color-ink-muted)]">
        <a href={`/${version}/`} class="hover:underline" data-astro-prefetch>← Home</a>
        <span class="mx-2 text-[var(--color-line)]">·</span>
        <a href={`/${version}/devotionals`} class="hover:underline" data-astro-prefetch>Devotionals</a>
      </p>
      <p class="eyebrow mt-6">Plans</p>
      <h1 class="font-scripture mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
        Reading plans
      </h1>
      <p class="mt-3 text-base text-[var(--color-ink-muted)]">
        Pick one track. One chapter a day. Progress is saved on this device.
      </p>
      <p class="mt-3 text-sm text-[var(--color-gold)]" x-show="activeLabel" x-cloak>
        Active plan: <span x-text="activeLabel"></span> — <span x-text="activeProgress"></span>
      </p>
    </header>

    <ul class="grid gap-4 sm:grid-cols-2">
      {plans.map((plan) => (
        <li>
          <a
            class="ui-card block h-full p-6 transition hover:border-[var(--color-gold)]"
            href={`/${version}/plans/${plan.id}`}
            data-astro-prefetch
          >
            <h2 class="font-scripture text-2xl font-semibold">{plan.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)]">{plan.summary}</p>
            <p class="mt-4 text-sm font-medium text-[var(--color-gold)]">
              {plan.days.length} days →
            </p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
