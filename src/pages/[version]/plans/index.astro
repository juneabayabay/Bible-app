---
import Layout from "../../../layouts/Layout.astro";
import SectionFocusChrome from "../../../components/SectionFocusChrome.astro";
import { resolveVersionId } from "../../../lib/bible";
import { getVersion } from "../../../lib/versions";
import { getVersionHomePaths } from "../../../lib/staticPaths";
import { getPlans } from "../../../lib/plans";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const plans = getPlans();
---

<Layout title={`Plans · ${meta.shortLabel}`} version={version} width="wide" focus showFooter={false}>
  <div class="page-stack" x-data="plansPanel" x-init="refresh()">
    <SectionFocusChrome version={version} title="Reading plans" eyebrow="Plans">
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        One track. One chapter a day. Saved on this device.
      </p>
      <p class="mt-2 text-sm text-[var(--color-gold)]" x-show="activeLabel" x-cloak>
        Active: <span x-text="activeLabel"></span> — <span x-text="activeProgress"></span>
      </p>
    </SectionFocusChrome>

    <ul class="grid gap-5 sm:grid-cols-2">
      {plans.map((plan) => (
        <li>
          <a
            class="ui-card group flex h-full flex-col overflow-hidden p-0 transition hover:border-[var(--color-gold)]"
            href={`/${version}/plans/${plan.id}`}
            data-astro-prefetch
          >
            <div class="relative aspect-[16/10] overflow-hidden bg-[var(--color-surface-elevated)]">
              <img
                src={plan.image}
                alt={plan.imageAlt}
                width="640"
                height="400"
                loading="lazy"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-[var(--color-surface)]/80 via-transparent to-transparent"
                aria-hidden="true"
              ></div>
            </div>
            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <h2 class="font-scripture text-2xl font-semibold">{plan.title}</h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                {plan.summary}
              </p>
              <p class="mt-4 text-sm font-medium text-[var(--color-gold)]">
                {plan.days.length} days →
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
