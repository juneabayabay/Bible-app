---
import Layout from "../../layouts/Layout.astro";
import SearchBar from "../../components/SearchBar.astro";
import { resolveVersionId } from "../../lib/bible";
import { getVersion } from "../../lib/versions";
import { getVersionHomePaths } from "../../lib/staticPaths";
import { getFeedbackFormUrl, hasFeedbackForm } from "../../lib/support";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const feedbackUrl = getFeedbackFormUrl();
const showFeedback = hasFeedbackForm();
---

<Layout title={`Support · ${meta.shortLabel}`} version={version}>
  <SearchBar slot="header" version={version} />

  <div class="page-stack measure">
    <header class="page-header border-b border-[var(--color-line)] pb-6">
      <p class="text-sm text-[var(--color-ink-muted)]">
        <a href={`/${version}/`} class="hover:underline" data-astro-prefetch>← Home</a>
      </p>
      <h1 class="font-scripture mt-6 text-[1.75rem] font-semibold tracking-tight sm:text-3xl">
        Support
      </h1>
      <p class="mt-3 max-w-lg text-[0.9375rem] leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        Send feedback anytime. Giving is optional — only if you want to help keep the app free.
      </p>
    </header>

    <section class="space-y-3" aria-labelledby="give-link-heading">
      <h2 id="give-link-heading" class="font-scripture text-lg font-semibold text-[var(--color-ink)] sm:text-xl">
        Give
      </h2>
      <p class="text-[0.9375rem] leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        Simple steps and wallet numbers — explained clearly on the Give page.
      </p>
      <a class="btn-secondary inline-flex !min-h-11 !px-5 text-sm" href={`/${version}/give`} data-astro-prefetch>
        See how to give
      </a>
    </section>

    <section
      id="feedback"
      class="space-y-3 border-t border-[var(--color-line)] pt-7"
      aria-labelledby="feedback-heading"
    >
      <h2 id="feedback-heading" class="font-scripture text-lg font-semibold text-[var(--color-ink)] sm:text-xl">
        Feedback
      </h2>
      <p class="text-[0.9375rem] leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        Tell us what’s working and what could be clearer.
      </p>
      <p class="flex flex-wrap gap-3">
        <a class="btn-primary !min-h-11 !px-5 text-sm" href={`/${version}/feedback`} data-astro-prefetch>
          Send feedback
        </a>
        {
          showFeedback ? (
            <a
              class="btn-secondary !min-h-11 !px-5 text-sm"
              href={feedbackUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              External form
            </a>
          ) : null
        }
      </p>
    </section>
  </div>
</Layout>
