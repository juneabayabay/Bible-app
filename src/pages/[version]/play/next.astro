---
import Layout from "../../../layouts/Layout.astro";
import SearchBar from "../../../components/SearchBar.astro";
import GameRewardPanel from "../../../components/GameRewardPanel.astro";
import { resolveVersionId } from "../../../lib/bible";
import { getVersion } from "../../../lib/versions";
import { getVersionHomePaths } from "../../../lib/staticPaths";
import { resolveGameVerses } from "../../../lib/resolveDailyVerse";
import { maxGameVerseCount } from "../../../lib/verseGame";
import { jsonForScript } from "../../../lib/jsonPayload";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const verses = resolveGameVerses(version, maxGameVerseCount()).map((v) => ({
  text: v.text,
  cite: `${v.book} ${v.chapter}:${v.verse}`,
  url: v.url,
}));
const payload = { version, verses };
---

<Layout title={`Finish the line · ${meta.shortLabel}`} version={version}>
  <SearchBar slot="header" version={version} />
  <script type="application/json" id="next-payload" set:html={jsonForScript(payload)} />

  <div class="page-stack measure" x-data="finishLineGame()" x-init="boot()">
    <header class="border-b border-[var(--color-line)] pb-5">
      <p class="text-sm text-[var(--color-ink-muted)]">
        <a href={`/${version}/play`} class="hover:underline" data-astro-prefetch>← Games</a>
      </p>
      <p class="eyebrow mt-5">Echo</p>
      <h1 class="font-scripture mt-1.5 text-3xl font-semibold tracking-tight sm:text-4xl">
        Finish the line
      </h1>
      <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
        The first half speaks. Which ending keeps the Word intact?
      </p>
    </header>

    <p class="text-sm text-[var(--color-ink-muted)]" x-show="!rounds.length" x-cloak>
      No verses available for this version. Try another game.
    </p>

    <div x-show="phase === 'play' && rounds.length" class="play-arena space-y-5" x-cloak>
      <p class="text-sm text-[var(--color-ink-muted)]">
        Keep the echo · <span x-text="score"></span> true
      </p>

      <p class="font-scripture text-xl leading-relaxed break-words text-[var(--color-ink)] sm:text-2xl" x-text="current.lead"></p>
      <p class="text-xs text-[var(--color-ink-subtle)]" x-text="current.cite"></p>

      <div class="space-y-2">
        <template x-for="(c, i) in current.choices" :key="i">
          <button
            type="button"
            class="w-full min-h-11 rounded-xl border px-4 py-3 text-left text-sm leading-relaxed transition"
            :class="choiceClass(c)"
            :disabled="locked"
            @click="pick(c)"
          >
            <span class="text-[var(--color-ink-subtle)]" x-text="String.fromCharCode(65 + i) + ' · '"></span>
            <span class="break-words" x-text="c"></span>
          </button>
        </template>
      </div>

      <p class="text-sm" x-show="feedback" x-cloak :class="ok ? 'text-[var(--color-success)]' : 'text-[var(--color-ink-muted)]'" x-text="feedback"></p>
      <p class="font-scripture text-sm leading-relaxed break-words text-[var(--color-ink-muted)]" x-show="locked" x-cloak x-text="current.fullText"></p>
      <button type="button" class="btn-primary !min-h-11 !px-5 text-sm" x-show="locked" x-cloak @click="next()" x-text="roundIndex + 1 < rounds.length ? 'Next line' : 'Finish'"></button>
    </div>

    <div x-show="phase === 'done'" x-cloak class="space-y-4">
      <h2 class="font-scripture text-2xl font-semibold">Lines complete</h2>
      <p class="text-sm text-[var(--color-ink-muted)]"><span x-text="score"></span> endings true. Grow counted.</p>
      <GameRewardPanel />
      <div class="flex flex-wrap gap-2">
        <button type="button" class="btn-primary !min-h-11 !px-5 text-sm" @click="restart()">Again</button>
        <a class="btn-secondary !min-h-11 !px-5 text-sm" href={`/${version}/play`}>All games</a>
      </div>
    </div>
  </div>
</Layout>
