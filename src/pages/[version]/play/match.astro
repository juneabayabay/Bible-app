---
import Layout from "../../../layouts/Layout.astro";
import GameFocusChrome from "../../../components/GameFocusChrome.astro";
import GameRewardPanel from "../../../components/GameRewardPanel.astro";
import { resolveVersionId } from "../../../lib/bible";
import { getVersion } from "../../../lib/versions";
import { getVersionHomePaths } from "../../../lib/staticPaths";
import { resolveGameVerses } from "../../../lib/resolveDailyVerse";
import { maxGameVerseCount } from "../../../lib/verseGame";
import { jsonForScript } from "../../../lib/jsonPayload";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const verses = resolveGameVerses(version, maxGameVerseCount()).map((v) => ({
  text: v.text,
  cite: `${v.book} ${v.chapter}:${v.verse}`,
  url: v.url,
}));
const payload = { version, verses };
---

<Layout title={`Cite snap · ${meta.shortLabel}`} version={version} focus showFooter={false}>
  <script type="application/json" id="match-payload" set:html={jsonForScript(payload)} />

  <div class="page-stack measure" x-data="citeSnapGame()" x-init="boot()">
    <GameFocusChrome version={version} title="Cite snap" vibe="Focus">
      <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
        Match the verse to its true reference.
      </p>
    </GameFocusChrome>

    <p class="text-sm text-[var(--color-ink-muted)]" x-show="!rounds.length" x-cloak>
      No verses available for this version. Try another game.
    </p>

    <div x-show="phase === 'play' && rounds.length" class="play-arena space-y-5" x-cloak>
      <div class="flex justify-between gap-3 text-sm text-[var(--color-ink-muted)]">
        <span>Snap the cite</span>
        <span class="text-right">
          <span x-text="score"></span> true
          <span class="text-[var(--color-gold)]" x-show="streak > 1" x-cloak>
            · streak ×<span x-text="streak"></span>
          </span>
        </span>
      </div>

      <blockquote class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-highlight)]/30 p-4 sm:p-5">
        <p class="font-scripture text-lg leading-relaxed break-words text-[var(--color-ink)] sm:text-xl" x-text="current.snippet"></p>
      </blockquote>

      <div class="grid gap-2 sm:grid-cols-2">
        <template x-for="c in current.choices" :key="c">
          <button
            type="button"
            class="min-h-11 rounded-xl border px-4 py-3 text-left text-sm font-medium transition"
            :class="choiceClass(c)"
            :disabled="locked"
            @click="pick(c)"
            x-text="c"
          ></button>
        </template>
      </div>

      <p class="text-sm" x-show="feedback" x-cloak :class="ok ? 'text-[var(--color-success)]' : 'text-[var(--color-ink-muted)]'" x-text="feedback"></p>
      <p class="font-scripture text-sm break-words text-[var(--color-ink-muted)]" x-show="locked" x-cloak x-text="current.fullText"></p>

      <button type="button" class="btn-primary !min-h-11 !px-5 text-sm" x-show="locked" x-cloak @click="next()" x-text="roundIndex + 1 < rounds.length ? 'Next snap' : 'Finish'"></button>
    </div>

    <div x-show="phase === 'done'" x-cloak class="space-y-4">
      <h2 class="font-scripture text-2xl font-semibold">Snaps complete</h2>
      <p class="text-sm text-[var(--color-ink-muted)]"><span x-text="score"></span> true cites. Grow counted.</p>
      <GameRewardPanel />
      <div class="flex flex-wrap gap-2">
        <button type="button" class="btn-primary !min-h-11 !px-5 text-sm" @click="restart()">Again</button>
        <a class="btn-secondary !min-h-11 !px-5 text-sm" href={`/${version}/play`}>All games</a>
      </div>
    </div>
  </div>
</Layout>
