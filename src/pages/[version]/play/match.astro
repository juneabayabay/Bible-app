---
import Layout from "../../../layouts/Layout.astro";
import SearchBar from "../../../components/SearchBar.astro";
import { resolveVersionId } from "../../../lib/bible";
import { getVersion } from "../../../lib/versions";
import { getVersionHomePaths } from "../../../lib/staticPaths";
import { resolveGameVerses } from "../../../lib/resolveDailyVerse";
import { buildMatchRounds } from "../../../lib/gamePacks";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const verses = resolveGameVerses(version, 50).map((v) => ({
  text: v.text,
  cite: `${v.book} ${v.chapter}:${v.verse}`,
  url: v.url,
}));
const rounds = buildMatchRounds(verses, 50);
const payload = { version, rounds };
---

<Layout title={`Cite snap · ${meta.shortLabel}`} version={version}>
  <SearchBar slot="header" version={version} />
  <script type="application/json" id="match-payload" set:html={JSON.stringify(payload)} />

  <div class="page-stack measure" x-data="citeSnapGame()" x-init="boot()">
    <header class="border-b border-[var(--color-line)] pb-5">
      <p class="text-sm text-[var(--color-ink-muted)]">
        <a href={`/${version}/play`} class="hover:underline" data-astro-prefetch>← Games</a>
      </p>
      <p class="eyebrow mt-5">Focus</p>
      <h1 class="font-scripture mt-1.5 text-3xl font-semibold tracking-tight sm:text-4xl">
        Cite snap
      </h1>
      <p class="mt-2 text-sm text-[var(--color-ink-muted)]">
        Only a fragment. Near-misses share the same book — stay sharp.
      </p>
    </header>

    <div x-show="phase === 'play'" class="space-y-5">
      <div class="flex justify-between text-sm text-[var(--color-ink-muted)]">
        <span>Snap the cite</span>
        <span>
          <span x-text="score"></span> true
          <span class="text-[var(--color-gold)]" x-show="streak > 1" x-cloak>
            · streak ×<span x-text="streak"></span>
          </span>
        </span>
      </div>

      <blockquote class="rounded-2xl border border-[var(--color-line)] bg-[var(--color-highlight)]/30 p-5">
        <p class="font-scripture text-xl leading-relaxed text-[var(--color-ink)]" x-text="current.snippet"></p>
      </blockquote>

      <div class="grid gap-2 sm:grid-cols-2">
        <template x-for="c in current.choices" :key="c">
          <button
            type="button"
            class="rounded-xl border px-4 py-3 text-left text-sm font-medium transition"
            :class="choiceClass(c)"
            :disabled="locked"
            @click="pick(c)"
            x-text="c"
          ></button>
        </template>
      </div>

      <p class="text-sm" x-show="feedback" x-cloak :class="ok ? 'text-[var(--color-success)]' : 'text-[var(--color-ink-muted)]'" x-text="feedback"></p>
      <p class="font-scripture text-sm text-[var(--color-ink-muted)]" x-show="locked" x-cloak x-text="current.fullText"></p>

      <button type="button" class="btn-primary !min-h-10 !px-5 text-sm" x-show="locked" x-cloak @click="next()" x-text="roundIndex + 1 < rounds.length ? 'Next snap' : 'Finish'"></button>
    </div>

    <div x-show="phase === 'done'" x-cloak class="space-y-4">
      <h2 class="font-scripture text-2xl font-semibold">Snaps complete</h2>
      <p class="text-sm text-[var(--color-ink-muted)]"><span x-text="score"></span> true cites. Grow counted.</p>
      <div class="flex flex-wrap gap-2">
        <button type="button" class="btn-primary !min-h-10 !px-5 text-sm" @click="restart()">Again</button>
        <a class="btn-secondary !min-h-10 !px-5 text-sm" href={`/${version}/play`}>All games</a>
      </div>
    </div>
  </div>
</Layout>
