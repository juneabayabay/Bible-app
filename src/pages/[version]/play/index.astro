---
import Layout from "../../../layouts/Layout.astro";
import SearchBar from "../../../components/SearchBar.astro";
import { resolveVersionId } from "../../../lib/bible";
import { getVersion } from "../../../lib/versions";
import { getVersionHomePaths } from "../../../lib/staticPaths";
import { GAMES } from "../../../lib/games";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
---

<Layout title={`Play · ${meta.shortLabel}`} version={version}>
  <SearchBar slot="header" version={version} />

  <div class="page-stack measure">
    <header class="border-b border-[var(--color-line)] pb-5">
      <p class="text-sm text-[var(--color-ink-muted)]">
        <a href={`/${version}/`} class="hover:underline" data-astro-prefetch>← Home</a>
      </p>
      <p class="eyebrow mt-5">Play</p>
      <h1 class="font-scripture mt-1.5 text-3xl font-semibold tracking-tight sm:text-4xl">
        Games
      </h1>
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        Short Scripture games — pick one and grow.
      </p>
    </header>

    <ul class="divide-y divide-[var(--color-line)] border-t border-[var(--color-line)]">
      {
        GAMES.map((game) => (
          <li class="py-4 first:pt-1">
            {game.status === "live" && game.slug ? (
              <a
                href={`/${version}/play/${game.slug}`}
                class="group flex items-start justify-between gap-3"
                data-astro-prefetch
              >
                <div class="min-w-0">
                  {game.vibe && (
                    <p class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-gold)]">
                      {game.vibe}
                    </p>
                  )}
                  <p class="mt-1 font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-primary)]">
                    {game.title}
                  </p>
                  <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                    {game.blurb}
                  </p>
                </div>
                <span class="shrink-0 pt-1 text-sm text-[var(--color-primary)]">Open →</span>
              </a>
            ) : (
              <div class="flex items-start justify-between gap-3 opacity-70">
                <div class="min-w-0">
                  {game.vibe && (
                    <p class="text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-subtle)]">
                      {game.vibe}
                    </p>
                  )}
                  <p class="mt-1 font-semibold text-[var(--color-ink)]">{game.title}</p>
                  <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                    {game.blurb}
                  </p>
                </div>
                <span class="shrink-0 pt-1 text-xs font-medium uppercase tracking-wide text-[var(--color-ink-subtle)]">
                  Soon
                </span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
