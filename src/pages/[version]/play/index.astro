---
import Layout from "../../../layouts/Layout.astro";
import SectionFocusChrome from "../../../components/SectionFocusChrome.astro";
import GameRewardPanel from "../../../components/GameRewardPanel.astro";
import { resolveVersionId } from "../../../lib/bible";
import { getVersion } from "../../../lib/versions";
import { getVersionHomePaths } from "../../../lib/staticPaths";
import { GAMES } from "../../../lib/games";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const live = GAMES.filter((g) => g.status === "live" && g.slug);
const soon = GAMES.filter((g) => g.status !== "live");
---

<Layout title={`Play · ${meta.shortLabel}`} version={version} focus showFooter={false}>
  <div class="page-stack measure">
    <SectionFocusChrome version={version} title="Games" eyebrow="Play">
      <p class="mt-2 max-w-lg text-sm leading-relaxed text-[var(--color-ink-muted)]">
        Pick a game. Score points. Unlock medals on Journey.
      </p>
    </SectionFocusChrome>

    <div x-data="playRankPanel()" x-init="boot()">
      <GameRewardPanel mode="hub" />
    </div>

    <section aria-labelledby="games-list-heading">
      <h2 id="game-list-heading" class="sr-only">Choose a game</h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          live.map((game) => (
            <li>
              <a
                href={`/${version}/play/${game.slug}`}
                class="group flex h-full min-h-[7.5rem] flex-col rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-4 transition hover:border-[var(--color-primary)]/50 hover:bg-[color-mix(in_srgb,var(--color-primary)_6%,var(--color-surface-elevated))] active:scale-[0.99] sm:p-5"
                data-astro-prefetch
              >
                {game.vibe && (
                  <p class="text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-[var(--color-gold)]">
                    {game.vibe}
                  </p>
                )}
                <p class="mt-1.5 font-scripture text-xl font-semibold tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-primary)]">
                  {game.title}
                </p>
                <p class="mt-1.5 flex-1 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                  {game.blurb}
                </p>
                <p class="mt-4 text-sm font-semibold text-[var(--color-primary)]">
                  Play
                  <span class="inline-block transition group-hover:translate-x-0.5" aria-hidden="true">
                    →
                  </span>
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      soon.length > 0 && (
        <section aria-labelledby="soon-heading" class="opacity-60">
          <h2 id="soon-heading" class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-subtle)]">
            Coming soon
          </h2>
          <ul class="space-y-2">
            {soon.map((game) => (
              <li class="rounded-xl border border-dashed border-[var(--color-line)] px-4 py-3">
                <p class="font-medium text-[var(--color-ink)]">{game.title}</p>
                <p class="mt-0.5 text-sm text-[var(--color-ink-muted)]">{game.blurb}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Layout>
