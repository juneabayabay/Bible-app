---
import Layout from "../../layouts/Layout.astro";
import SearchBar from "../../components/SearchBar.astro";
import { resolveVersionId } from "../../lib/bible";
import { getVersion } from "../../lib/versions";
import { getVersionHomePaths } from "../../lib/staticPaths";
import { CHALLENGE_TROPHIES, STREAK_TROPHIES } from "../../lib/journey";
import RemindersCard from "../../components/RemindersCard.astro";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const medals = [...CHALLENGE_TROPHIES, ...STREAK_TROPHIES];
---

<Layout title={`Journey · ${meta.shortLabel}`} version={version}>
  <SearchBar slot="header" version={version} />

  <div class="page-stack measure" x-data="journeyPanel" x-init="refresh()">
    <header class="page-header border-b border-[var(--color-line)] pb-5">
      <p class="text-sm text-[var(--color-ink-muted)]">
        <a href={`/${version}/`} class="hover:underline" data-astro-prefetch>← Home</a>
      </p>
      <p class="eyebrow mt-5">Journey</p>
      <h1 class="font-scripture mt-1.5 text-3xl font-semibold tracking-tight sm:text-4xl">
        Your progress
      </h1>
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        Streak, attendance, and medals — earned by showing up and finishing hard tasks.
      </p>
    </header>

    <!-- Snapshot -->
    <section aria-labelledby="snapshot-heading" class="space-y-4">
      <h2 id="snapshot-heading" class="sr-only">Snapshot</h2>

      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-subtle)]">
            Streak
          </p>
          <p class="mt-1 font-scripture text-4xl font-semibold tracking-tight">
            <span x-text="streak"></span>
            <span class="text-lg font-normal text-[var(--color-ink-muted)]">days</span>
          </p>
        </div>
        <div class="text-right">
          <p class="text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-subtle)]">
            Level
          </p>
          <p class="mt-1 font-scripture text-2xl font-semibold" x-text="levelName"></p>
        </div>
      </div>

      <div>
        <div class="flex items-baseline justify-between gap-3 text-sm text-[var(--color-ink-muted)]">
          <p x-text="nextLevelNote"></p>
          <p class="shrink-0 tabular-nums">
            <span x-text="trophyCount"></span>/<span x-text="trophyTotal"></span> medals
          </p>
        </div>
        <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-[var(--color-line)]">
          <div
            class="h-full rounded-full bg-[var(--color-primary)] transition-all duration-500"
            :style="`width: ${Math.round(progress * 100)}%`"
          ></div>
        </div>
      </div>
    </section>

    <!-- Attendance -->
    <section aria-labelledby="presence-heading">
      <h2 id="presence-heading" class="font-scripture text-xl font-semibold">
        Attendance
      </h2>
      <p class="mt-1 text-sm text-[var(--color-ink-muted)]">
        Last 28 days. Darker = more done that day.
      </p>

      <div class="attendance-wrap mt-4">
        <div class="attendance-weekdays" aria-hidden="true">
          <template x-for="day in attendance.slice(0, 7)" :key="'wd-' + day.date">
            <span class="attendance-weekday" x-text="day.weekday"></span>
          </template>
        </div>
        <div class="attendance-grid" role="img" aria-label="28-day attendance">
          <template x-for="day in attendance" :key="day.date">
            <div
              class="attendance-cell"
              :data-level="day.level"
              :title="day.label"
            ></div>
          </template>
        </div>
      </div>

      <div class="attendance-legend mt-3">
        <span>Less</span>
        <span class="attendance-cell" data-level="0"></span>
        <span class="attendance-cell" data-level="1"></span>
        <span class="attendance-cell" data-level="2"></span>
        <span class="attendance-cell" data-level="3"></span>
        <span class="attendance-cell" data-level="4"></span>
        <span>More</span>
      </div>
    </section>

    <!-- Medals -->
    <section aria-labelledby="medals-heading">
      <h2 id="medals-heading" class="font-scripture text-xl font-semibold">
        Medals
      </h2>
      <p class="mt-1 text-sm text-[var(--color-ink-muted)]">
        Play, read, and return. Unlocked medals reveal a verse.
      </p>

      <ul class="mt-5 divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
        {
          medals.map((trophy) => (
            <li
              class="py-4"
              :class={`trophies.includes('${trophy.id}') ? '' : 'opacity-55'`}
            >
              <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                <h3 class="font-scripture text-lg font-semibold text-[var(--color-ink)]">
                  {trophy.title}
                </h3>
                <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-gold)]">
                  <span
                    x-text={`trophies.includes('${trophy.id}') ? 'Unlocked' : 'Locked'`}
                  ></span>
                </p>
              </div>
              <p class="mt-1 text-sm text-[var(--color-ink-muted)]">{trophy.description}</p>
              <blockquote
                class="font-scripture mt-3 border-l-2 border-[var(--color-gold)] pl-3 text-[var(--color-ink)]"
                x-show={`trophies.includes('${trophy.id}')`}
                x-cloak
              >
                <p class="text-sm leading-relaxed sm:text-base">“{trophy.verseText}”</p>
                <p class="mt-1.5 text-xs text-[var(--color-ink-muted)]">{trophy.verseLabel}</p>
              </blockquote>
              <p
                class="mt-2 text-xs text-[var(--color-ink-subtle)]"
                x-show={`!trophies.includes('${trophy.id}')`}
                x-cloak
              >
                {trophy.hint}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <RemindersCard />

    <p class="flex flex-wrap gap-2">
      <a class="btn-primary" href={`/${version}/play`} data-astro-prefetch>Play</a>
      <a class="btn-secondary" href={`/${version}/devotionals`} data-astro-prefetch>Devotionals</a>
    </p>
  </div>
</Layout>
