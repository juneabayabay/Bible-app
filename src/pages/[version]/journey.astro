---
import Layout from "../../layouts/Layout.astro";
import SectionFocusChrome from "../../components/SectionFocusChrome.astro";
import MedalRow from "../../components/MedalRow.astro";
import RemindersCard from "../../components/RemindersCard.astro";
import { resolveVersionId } from "../../lib/bible";
import { getVersion } from "../../lib/versions";
import { getVersionHomePaths } from "../../lib/staticPaths";
import { CHALLENGE_TROPHIES, STREAK_TROPHIES } from "../../lib/journey";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
---

<Layout title={`Journey · ${meta.shortLabel}`} version={version} focus showFooter={false}>
  <div class="page-stack measure" x-data="journeyPanel" x-init="refresh()">
    <SectionFocusChrome version={version} title="Journey" eyebrow="Progress">
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)]">
        Streak and medals — earned by returning each day.
      </p>
    </SectionFocusChrome>

    <section aria-labelledby="snapshot-heading" class="space-y-4">
      <h2 id="snapshot-heading" class="sr-only">Snapshot</h2>

      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-subtle)]">
            Streak
          </p>
          <p class="mt-1 font-scripture text-4xl font-semibold tracking-tight">
            <span x-text="streak"></span>
            <span class="text-lg font-normal text-[var(--color-ink-muted)]">days</span>
          </p>
        </div>
        <div class="text-right">
          <p class="text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-subtle)]">
            Level
          </p>
          <p class="mt-1 font-scripture text-2xl font-semibold" x-text="levelName"></p>
        </div>
      </div>

      <div>
        <div class="flex items-baseline justify-between gap-3 text-sm text-[var(--color-ink-muted)]">
          <p x-text="nextLevelNote"></p>
          <p class="shrink-0 tabular-nums">
            <span x-text="trophyCount"></span>/<span x-text="trophyTotal"></span> medals
          </p>
        </div>
        <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-[var(--color-line)]">
          <div
            class="h-full rounded-full bg-[var(--color-primary)] transition-all duration-500"
            :style="`width: ${Math.round(progress * 100)}%`"
          ></div>
        </div>
      </div>
    </section>

    <section aria-labelledby="medals-heading" class="space-y-8">
      <div>
        <h2 id="medals-heading" class="font-scripture text-xl font-semibold">
          Medals
        </h2>
        <p class="mt-1 text-sm text-[var(--color-ink-muted)]">
          Unlocked medals reveal a verse.
        </p>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-subtle)]">
          Play &amp; challenges
        </h3>
        <ul class="mt-3 divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
          {CHALLENGE_TROPHIES.map((trophy) => (
            <MedalRow trophy={trophy} />
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-ink-subtle)]">
          Daily streak
        </h3>
        <ul class="mt-3 divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
          {STREAK_TROPHIES.map((trophy) => (
            <MedalRow trophy={trophy} />
          ))}
        </ul>
      </div>
    </section>

    <RemindersCard />

    <p class="flex flex-wrap gap-2">
      <a class="btn-primary" href={`/${version}/play`} data-astro-prefetch>Play</a>
      <a class="btn-secondary" href={`/${version}/devotionals`} data-astro-prefetch>Devotionals</a>
    </p>
  </div>
</Layout>
