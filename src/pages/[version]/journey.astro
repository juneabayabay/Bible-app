---
import Layout from "../../layouts/Layout.astro";
import SearchBar from "../../components/SearchBar.astro";
import { resolveVersionId } from "../../lib/bible";
import { getVersion } from "../../lib/versions";
import { getVersionHomePaths } from "../../lib/staticPaths";
import { LEVELS, TROPHIES } from "../../lib/journey";
import { totalDevotionEntries } from "../../lib/devotionals";

export function getStaticPaths() {
  return getVersionHomePaths();
}

const version = resolveVersionId(Astro.params.version);
const meta = getVersion(version);
const devotionTotal = totalDevotionEntries();
---

<Layout title={`Journey · ${meta.shortLabel}`} version={version} width="wide">
  <SearchBar slot="header" version={version} />

  <div class="page-stack" x-data="journeyPanel" x-init="refresh()">
    <header class="page-header">
      <p class="text-sm text-[var(--color-ink-muted)]">
        <a href={`/${version}/`} class="hover:text-[var(--color-ink)] hover:underline" data-astro-prefetch>
          ← Home
        </a>
      </p>
      <p class="eyebrow mt-5">Journey</p>
      <h1 class="font-scripture mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
        Walk with God daily
      </h1>
      <p class="mt-3 text-base leading-relaxed text-[var(--color-ink-muted)]">
        Every time you open this app on your device, your streak grows. Levels and trophies mark faithful return—
        each trophy unlocks a verse to keep close.
      </p>
    </header>

    <!-- Status -->
    <section aria-labelledby="status-heading" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <h2 id="status-heading" class="sr-only">Your status</h2>
      <article class="ui-card p-5 sm:col-span-1">
        <p class="text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-subtle)]">Current streak</p>
        <p class="mt-2 font-scripture text-4xl font-semibold"><span x-text="streak"></span></p>
        <p class="mt-1 text-sm text-[var(--color-ink-muted)]">days in a row</p>
      </article>
      <article class="ui-card p-5">
        <p class="text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-subtle)]">Level</p>
        <p class="mt-2 font-scripture text-4xl font-semibold" x-text="levelName"></p>
        <p class="mt-1 text-sm text-[var(--color-ink-muted)]" x-text="levelBlurb"></p>
      </article>
      <article class="ui-card p-5">
        <p class="text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-subtle)]">Days opened</p>
        <p class="mt-2 font-scripture text-4xl font-semibold" x-text="totalDays"></p>
        <p class="mt-1 text-sm text-[var(--color-ink-muted)]">lifetime</p>
      </article>
      <article class="ui-card p-5">
        <p class="text-xs font-semibold uppercase tracking-[0.1em] text-[var(--color-ink-subtle)]">Devotions</p>
        <p class="mt-2 font-scripture text-4xl font-semibold">
          <span x-text="devotionDone"></span>
          <span class="text-xl text-[var(--color-ink-muted)]">/{devotionTotal}</span>
        </p>
        <p class="mt-1 text-sm text-[var(--color-ink-muted)]">completed</p>
      </article>
    </section>

    <!-- This week -->
    <section aria-labelledby="week-heading">
      <h2 id="week-heading" class="font-scripture text-xl font-semibold sm:text-2xl">This week</h2>
      <p class="mt-1 text-sm text-[var(--color-ink-muted)]">
        Last 7 days on this device — simple progress, not a scoreboard.
      </p>
      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <article class="ui-card p-4">
          <p class="text-xs uppercase tracking-wide text-[var(--color-ink-subtle)]">Opened</p>
          <p class="mt-1 font-scripture text-2xl font-semibold"><span x-text="weekOpened"></span>/7</p>
        </article>
        <article class="ui-card p-4">
          <p class="text-xs uppercase tracking-wide text-[var(--color-ink-subtle)]">Read</p>
          <p class="mt-1 font-scripture text-2xl font-semibold"><span x-text="weekRead"></span>/7</p>
        </article>
        <article class="ui-card p-4">
          <p class="text-xs uppercase tracking-wide text-[var(--color-ink-subtle)]">Grew</p>
          <p class="mt-1 font-scripture text-2xl font-semibold"><span x-text="weekGrow"></span>/7</p>
        </article>
        <article class="ui-card p-4">
          <p class="text-xs uppercase tracking-wide text-[var(--color-ink-subtle)]">Challenges</p>
          <p class="mt-1 font-scripture text-2xl font-semibold"><span x-text="weekChallenges"></span>/7</p>
        </article>
        <article class="ui-card p-4">
          <p class="text-xs uppercase tracking-wide text-[var(--color-ink-subtle)]">Full days</p>
          <p class="mt-1 font-scripture text-2xl font-semibold"><span x-text="weekComplete"></span>/7</p>
        </article>
      </div>
      <p class="mt-3 text-sm text-[var(--color-ink-subtle)]">
        Chapters visited (all time): <span class="font-medium text-[var(--color-ink-muted)]" x-text="chaptersRead"></span>
      </p>
    </section>

    <!-- Progress to next level -->
    <section aria-labelledby="level-path-heading">
      <h2 id="level-path-heading" class="font-scripture text-xl font-semibold sm:text-2xl">Level path</h2>
      <p class="mt-1 text-sm text-[var(--color-ink-muted)]" x-text="nextLevelNote"></p>
      <div class="mt-4 h-2 overflow-hidden rounded-full bg-[var(--color-line)]">
        <div
          class="h-full rounded-full bg-[var(--color-primary)] transition-all duration-500"
          :style="`width: ${Math.round(progress * 100)}%`"
        ></div>
      </div>
      <ol class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {LEVELS.map((level) => (
          <li
            class="rounded-xl border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-4"
            :class={`streak >= ${level.minStreak} ? 'border-[var(--color-gold)]' : 'opacity-70'`}
          >
            <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-ink-subtle)]">
              Level {level.id}
            </p>
            <p class="mt-1 font-scripture text-lg font-semibold">{level.name}</p>
            <p class="mt-1 text-xs text-[var(--color-ink-muted)]">
              {level.minStreak === 0 ? "Start here" : `${level.minStreak}+ day streak`}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <!-- Trophies -->
    <section aria-labelledby="trophies-heading">
      <h2 id="trophies-heading" class="font-scripture text-xl font-semibold sm:text-2xl">Trophies & verses</h2>
      <p class="mt-1 max-w-2xl text-sm text-[var(--color-ink-muted)]">
        Keep opening the app each day. When you reach a milestone, a trophy unlocks with a verse to remember.
      </p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {TROPHIES.map((trophy) => (
          <li
            class="ui-card p-5"
            :class={`trophies.includes('${trophy.id}') ? '' : 'opacity-55'`}
          >
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-gold)]">
                  <span x-text={`trophies.includes('${trophy.id}') ? 'Unlocked' : 'Locked · ${trophy.streakAt}-day streak'`}></span>
                </p>
                <h3 class="mt-1 font-scripture text-xl font-semibold">{trophy.title}</h3>
                <p class="mt-1 text-sm text-[var(--color-ink-muted)]">{trophy.description}</p>
              </div>
            </div>
            <blockquote
              class="font-scripture mt-4 border-l-2 border-[var(--color-gold)] pl-3 text-[var(--color-ink)]"
              x-show={`trophies.includes('${trophy.id}')`}
              x-cloak
            >
              <p class="text-base leading-relaxed">“{trophy.verseText}”</p>
              <p class="mt-2 text-sm text-[var(--color-ink-muted)]">{trophy.verseLabel}</p>
            </blockquote>
            <p
              class="mt-4 text-sm text-[var(--color-ink-subtle)]"
              x-show={`!trophies.includes('${trophy.id}')`}
              x-cloak
            >
              Keep your streak to reveal this verse.
            </p>
          </li>
        ))}
      </ul>
    </section>

    <p class="flex flex-wrap justify-center gap-3 text-center">
      <a class="btn-primary" href={`/${version}/#books`} data-astro-prefetch>
        Browse books
      </a>
      <a class="btn-secondary" href={`/${version}/plans`} data-astro-prefetch>
        Reading plans
      </a>
      <a class="btn-secondary" href={`/${version}/devotionals`} data-astro-prefetch>
        Devotionals
      </a>
    </p>
  </div>
</Layout>
