---
import { getBooks } from "../../lib/bible";
import type { Book } from "../../lib/bible";

export function getStaticPaths() {
  return getBooks().map((b) => ({
    params: { book: b.slug },
    props: { book: b },
  }));
}

const { book } = Astro.props as { book: Book };
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{book.name}</title>
  </head>
  <body>
    <p><a href="/">← All books</a></p>

    <h1>{book.name}</h1>

    <h2>Chapters</h2>
    <ul>
      {book.chapters.map((chapter) => (
        <li>
          <a href={`/chapter/${book.slug}/${chapter.number}`}>
            Chapter {chapter.number}
          </a>
        </li>
      ))}
    </ul>
  </body>
</html>