---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
import { DEFAULT_VERSION, VERSION_IDS } from "../lib/versions";
---

<Layout title="Saved" version={DEFAULT_VERSION}>
  <SearchBar slot="header" version={DEFAULT_VERSION} />

  <div class="page-stack">
    <header class="page-header border-b border-[var(--color-line)] pb-5">
      <p class="eyebrow">Library</p>
      <h1 class="font-scripture mt-1.5 text-2xl font-semibold tracking-tight sm:text-3xl">
        Saved
      </h1>
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        Highlights and notes stored in this browser. Export a backup before you switch phones.
      </p>
    </header>

    <div x-data="savedList">
      <section class="mb-6 space-y-3 border-b border-[var(--color-line)] pb-6">
        <div class="flex flex-wrap gap-2">
          <button type="button" class="btn-secondary" @click="exportBackup()">
            Export backup
          </button>
          <label class="btn-primary cursor-pointer">
            <span x-text="importing ? 'Importing…' : 'Import backup'"></span>
            <input
              type="file"
              accept="application/json,.json"
              class="sr-only"
              :disabled="importing"
              @change="onImportFile($event)"
            />
          </label>
        </div>
        <fieldset class="flex flex-wrap gap-4 text-sm text-[var(--color-ink-muted)]">
          <legend class="sr-only">Import mode</legend>
          <label class="inline-flex items-center gap-2">
            <input type="radio" name="import-mode" value="merge" x-model="importMode" />
            Merge with this device
          </label>
          <label class="inline-flex items-center gap-2">
            <input type="radio" name="import-mode" value="replace" x-model="importMode" />
            Replace everything
          </label>
        </fieldset>
        <p
          class="text-sm text-[var(--color-ink-muted)]"
          x-show="status"
          x-text="status"
          x-cloak
        ></p>
      </section>

      <p class="text-sm text-[var(--color-ink-subtle)]" x-show="items.length === 0" x-cloak>
        Nothing saved yet. Open a chapter, press and hold a verse, then highlight or add a note.
      </p>

      <ul class="space-y-3" x-cloak>
        <template x-for="item in items" :key="item.key">
          <li class="ui-card p-4 sm:p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div class="min-w-0 flex-1">
                <a
                  class="font-medium text-[var(--color-ink)] hover:underline"
                  :href="item.url"
                  x-text="item.label"
                ></a>
                <p
                  class="mt-1.5 flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-[var(--color-ink-muted)]"
                  x-show="item.highlighted"
                >
                  <span
                    class="hl-swatch !h-3 !w-3 !border"
                    :data-hl="item.highlightColor"
                    aria-hidden="true"
                  ></span>
                  <span x-text="item.highlightColor ? `${item.highlightColor} highlight` : 'Highlighted'"></span>
                </p>
                <p
                  class="mt-2 whitespace-pre-wrap text-sm leading-relaxed text-[var(--color-ink-muted)]"
                  x-show="item.note"
                  x-text="item.note"
                ></p>
              </div>
              <button
                type="button"
                class="min-h-10 shrink-0 rounded-lg px-2 text-xs text-[var(--color-ink-subtle)] transition hover:bg-[var(--color-line)]/50 hover:text-red-600 dark:hover:text-red-400"
                @click="remove(item.key)"
              >
                Remove
              </button>
            </div>
          </li>
        </template>
      </ul>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ DEFAULT_VERSION, VERSION_IDS }}>
  (() => {
    let version = DEFAULT_VERSION;
    try {
      const saved = localStorage.getItem("bible-version");
      if (saved && VERSION_IDS.includes(saved)) version = saved;
    } catch {
      /* ignore */
    }
    const home = "/" + version + "/";
    document.querySelectorAll("[data-home-link]").forEach((el) => {
      el.setAttribute("href", home);
    });
    document.querySelectorAll("[data-nav-version]").forEach((el) => {
      const path = el.getAttribute("data-nav-version");
      if (path != null) el.setAttribute("href", "/" + version + path);
    });
  })();
</script>
