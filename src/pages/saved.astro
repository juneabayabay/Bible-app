---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
import { DEFAULT_VERSION, VERSION_IDS } from "../lib/versions";
---

<Layout title="Saved" version={DEFAULT_VERSION}>
  <SearchBar slot="header" version={DEFAULT_VERSION} />

  <div class="page-stack">
    <header class="page-header">
      <p class="eyebrow">Library</p>
      <h1 class="font-scripture mt-1.5 text-2xl font-semibold tracking-tight sm:text-3xl">
        Saved
      </h1>
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-muted)] sm:text-base">
        Your highlights and notes on this device.
      </p>
    </header>

    <div x-data="savedList" class="measure-wide">
      <p
        class="text-sm text-[var(--color-ink-subtle)]"
        x-show="items.length === 0"
        x-cloak
      >
        Nothing here yet. Open a chapter, press and hold a verse, then highlight it or add a note.
      </p>

      <div x-show="items.length > 0" x-cloak>
        <p class="mb-4 text-sm text-[var(--color-ink-muted)]">
          <span x-text="items.length"></span>
          <span x-text="items.length === 1 ? ' verse' : ' verses'"></span>
        </p>

        <ul class="divide-y divide-[var(--color-line)] border-y border-[var(--color-line)]">
          <template x-for="item in items" :key="item.key">
            <li class="py-4 sm:py-5">
              <div class="flex items-start gap-3">
                <span
                  class="hl-swatch mt-1.5 !h-3 !w-3 shrink-0 !border"
                  x-show="item.highlighted"
                  :data-hl="item.highlightColor"
                  aria-hidden="true"
                ></span>
                <span
                  class="mt-1.5 h-3 w-3 shrink-0 rounded-full border border-[var(--color-line)]"
                  x-show="!item.highlighted"
                  aria-hidden="true"
                ></span>

                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                    <span
                      class="text-xs font-semibold uppercase tracking-wide text-[var(--color-ink-subtle)]"
                      x-text="item.version"
                    ></span>
                    <a
                      class="font-scripture text-lg font-semibold tracking-tight text-[var(--color-ink)] hover:text-[var(--color-primary)]"
                      :href="item.url"
                      x-text="item.reference"
                    ></a>
                  </div>

                  <p
                    class="mt-2 whitespace-pre-wrap text-sm leading-relaxed text-[var(--color-ink-muted)]"
                    x-show="item.note"
                    x-text="item.note"
                  ></p>

                  <p
                    class="mt-2 text-xs text-[var(--color-ink-subtle)]"
                    x-show="item.highlighted && !item.note"
                  >
                    Highlighted
                  </p>
                </div>

                <button
                  type="button"
                  class="min-h-9 shrink-0 rounded-lg px-2 text-xs text-[var(--color-ink-subtle)] transition hover:bg-[var(--color-line)]/50 hover:text-red-600 dark:hover:text-red-400"
                  @click="remove(item.key)"
                >
                  Remove
                </button>
              </div>
            </li>
          </template>
        </ul>
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ DEFAULT_VERSION, VERSION_IDS }}>
  (() => {
    let version = DEFAULT_VERSION;
    try {
      const saved = localStorage.getItem("bible-version");
      if (saved && VERSION_IDS.includes(saved)) version = saved;
    } catch {
      /* ignore */
    }
    const home = "/" + version + "/";
    document.querySelectorAll("[data-home-link]").forEach((el) => {
      el.setAttribute("href", home);
    });
    document.querySelectorAll("[data-nav-version]").forEach((el) => {
      const path = el.getAttribute("data-nav-version");
      if (path != null) el.setAttribute("href", "/" + version + path);
    });
  })();
</script>
