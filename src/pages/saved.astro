---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
import { DEFAULT_VERSION } from "../lib/versions";
---

<Layout title="Saved" version={DEFAULT_VERSION}>
  <SearchBar slot="header" version={DEFAULT_VERSION} />

  <h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Saved</h1>
  <p class="mt-2 text-sm text-[var(--color-ink-muted)] sm:text-base">
    Highlights and notes stored in this browser (all versions).
  </p>

  <div class="mt-8" x-data="savedList" x-cloak>
    <p class="text-sm text-[var(--color-ink-subtle)]" x-show="items.length === 0">
      Nothing saved yet. Open a chapter and highlight a verse or add a note.
    </p>

    <ul class="space-y-3 sm:space-y-4">
      <template x-for="item in items" :key="item.key">
        <li class="rounded-md border border-[var(--color-line)] bg-[var(--color-surface-elevated)] p-4">
          <a
            class="font-medium capitalize text-[var(--color-ink)] hover:underline"
            :href="item.url"
            x-text="item.label"
          ></a>
          <p
            class="mt-1 text-sm text-[var(--color-accent)]"
            x-show="item.highlighted"
          >
            Highlighted
          </p>
          <p
            class="mt-2 whitespace-pre-wrap text-sm text-[var(--color-ink-muted)]"
            x-show="item.note"
            x-text="item.note"
          ></p>
          <button
            type="button"
            class="mt-3 min-h-8 text-xs text-red-600 hover:underline dark:text-red-400"
            @click="remove(item.key)"
          >
            Remove
          </button>
        </li>
      </template>
    </ul>
  </div>
</Layout>
