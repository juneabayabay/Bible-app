---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
---

<Layout title="Saved">
  <SearchBar slot="header" />

  <h1 class="text-3xl font-semibold tracking-tight">Saved</h1>
  <p class="mt-2 text-stone-600">
    Highlights and notes stored in this browser.
  </p>

  <div class="mt-8" x-data="savedList" x-cloak>
    <p class="text-sm text-stone-500" x-show="items.length === 0">
      Nothing saved yet. Open a chapter and highlight a verse or add a note.
    </p>

    <ul class="space-y-4">
      <template x-for="item in items" :key="item.key">
        <li class="rounded-md border border-stone-200 bg-white p-4">
          <a class="font-medium text-stone-900 hover:underline" :href="item.url" x-text="item.label"></a>
          <p class="mt-1 text-sm text-stone-700" x-show="item.highlighted">Highlighted</p>
          <p class="mt-2 whitespace-pre-wrap text-sm text-stone-600" x-show="item.note" x-text="item.note"></p>
          <button
            type="button"
            class="mt-3 text-xs text-red-600 hover:underline"
            @click="remove(item.key)"
          >
            Remove
          </button>
        </li>
      </template>
    </ul>
  </div>
</Layout>
