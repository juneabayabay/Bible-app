---
import Layout from "../../../layouts/Layout.astro";
import SearchBar from "../../../components/SearchBar.astro";
import { getBooks, getChapter } from "../../../lib/bible";

export function getStaticPaths() {
  return getBooks().flatMap((book) =>
    book.chapters.map((chapter) => ({
      params: {
        book: book.slug,
        chapter: String(chapter.number),
      },
      props: {
        bookName: book.name,
        bookSlug: book.slug,
        chapterNumber: chapter.number,
      },
    }))
  );
}

const { bookName, bookSlug, chapterNumber } = Astro.props;
const chapter = getChapter(bookSlug, chapterNumber);

if (!chapter) {
  return Astro.redirect("/");
}
---

<Layout title={`${bookName} ${chapterNumber}`}>
  <SearchBar slot="header" />

  <p class="mb-4 text-sm">
    <a class="text-stone-600 hover:underline" href={`/book/${bookSlug}`}>
      ← {bookName}
    </a>
  </p>

  <h1 class="text-3xl font-semibold tracking-tight">
    {bookName} {chapterNumber}
  </h1>
  <p class="mt-2 text-sm text-stone-500">
    Click a verse number to highlight. Use Note to save a personal note.
  </p>

  <div
    class="mt-6 space-y-3 leading-relaxed"
    x-data={`chapterReader('${bookSlug}', ${chapterNumber})`}
  >
    {chapter.verses.map((verse) => (
      <div
        class="rounded-md px-2 py-2 transition"
        :class={`isHighlighted(${verse.number}) ? 'bg-amber-100' : ''`}
      >
        <div class="flex gap-3">
          <button
            type="button"
            class="mt-0.5 shrink-0 text-sm font-semibold text-stone-500 hover:text-amber-700"
            title="Toggle highlight"
            @click={`toggleHighlight(${verse.number})`}
          >
            {verse.number}
          </button>
          <div class="min-w-0 flex-1">
            <p>{verse.text}</p>
            <div class="mt-2 flex items-center gap-3">
              <button
                type="button"
                class="text-xs text-stone-500 hover:text-stone-800"
                @click={`toggleNote(${verse.number})`}
              >
                Note
              </button>
              <span
                class="text-xs text-amber-700"
                x-show={`noteText(${verse.number}).trim()`}
              >
                Has note
              </span>
            </div>
            <div class="mt-2" x-show={`openNote === ${verse.number}`} x-cloak>
              <textarea
                class="w-full rounded-md border border-stone-300 bg-white p-2 text-sm outline-none ring-stone-400 focus:ring-2"
                rows="3"
                placeholder="Write a note for this verse…"
                x-bind:value={`noteText(${verse.number})`}
                @input={`setNote(${verse.number}, $event.target.value)`}
              />
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</Layout>
