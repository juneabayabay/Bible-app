---
import Layout from "../../../layouts/Layout.astro";
import SearchBar from "../../../components/SearchBar.astro";
import { getBooks, getChapter } from "../../../lib/bible";

export function getStaticPaths() {
  return getBooks().flatMap((book) =>
    book.chapters.map((chapter) => ({
      params: {
        book: book.slug,
        chapter: String(chapter.number),
      },
      props: {
        bookName: book.name,
        bookSlug: book.slug,
        chapterNumber: chapter.number,
      },
    }))
  );
}

const { bookName, bookSlug, chapterNumber } = Astro.props;
const chapter = getChapter(bookSlug, chapterNumber);

if (!chapter) {
  return Astro.redirect("/");
}
---

<Layout title={`${bookName} ${chapterNumber}`}>
  <SearchBar slot="header" />

  <p class="mb-4 text-sm">
    <a class="text-stone-600 hover:underline" href={`/book/${bookSlug}`}>
      ← {bookName}
    </a>
  </p>

  <h1 class="text-3xl font-semibold tracking-tight">
    {bookName} {chapterNumber}
  </h1>

  <div class="mt-6 space-y-4 leading-relaxed">
    {chapter.verses.map((verse) => (
      <p>
        <strong class="mr-2 text-stone-500">{verse.number}</strong>
        {verse.text}
      </p>
    ))}
  </div>
</Layout>
