---
import { DEFAULT_VERSION, VERSION_IDS } from "../lib/versions";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bible</title>
    <script is:inline define:vars={{ DEFAULT_VERSION, VERSION_IDS }}>
      (() => {
        let version = DEFAULT_VERSION;
        try {
          const saved = localStorage.getItem("bible-version");
          if (saved && VERSION_IDS.includes(saved)) version = saved;
        } catch {
          /* ignore */
        }
        window.location.replace("/" + version + "/");
      })();
    </script>
    <meta http-equiv="refresh" content={`0;url=/${DEFAULT_VERSION}/`} />
  </head>
  <body></body>
</html>
