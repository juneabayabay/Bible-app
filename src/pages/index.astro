---
import { getBooks } from "../lib/bible";

const books = getBooks();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Bible App</title>
  </head>
  <body>
    <h1>Bible</h1>
    <p>Read the World English Bible (public domain).</p>

    <h2>Books</h2>
    <ul>
      {books.map((book) => (
        <li>
          <a href={`/book/${book.slug}`}>{book.name}</a>
        </li>
      ))}
    </ul>
  </body>
</html>